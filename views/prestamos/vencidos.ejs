<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>

    <body>
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <%- include('../partials/sidebar') %>

                    <div class="col py-3">
                        <div class="container-fluid px-4 py-4">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h2 class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Cartera Vencida
                                    (Morosos)</h2>
                                <a href="/prestamos" class="btn btn-outline-secondary">Volver a Préstamos</a>
                            </div>

                            <% if (vencidos.length> 0) { %>
                                <div class="alert alert-warning border-warning shadow-sm">
                                    <i class="bi bi-info-circle-fill"></i> Atención: Hay <strong>
                                        <%= vencidos.length %>
                                    </strong> préstamos que han superado su fecha límite de pago.
                                </div>

                                <div class="card card-box p-0 overflow-hidden border-danger">
                                    <div class="table-responsive d-none d-md-block">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-danger">
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Cliente</th>
                                                    <th>Contacto</th>
                                                    <th>Deuda Total</th>
                                                    <th>Fecha Límite</th>
                                                    <th>Días de Retraso</th>
                                                    <th>Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% vencidos.forEach(p=> {
                                                    // Calcular días de retraso
                                                    const fechaFin = new Date(p.fecha_fin);
                                                    const hoy = new Date();
                                                    const diffTime = Math.abs(hoy - fechaFin);
                                                    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                                                    %>
                                                    <tr>
                                                        <td><span class="badge bg-danger">#<%= p.id %></span></td>
                                                        <td>
                                                            <div class="fw-bold">
                                                                <%= p.nombre %>
                                                                    <%= p.apellido %>
                                                            </div>
                                                            <small class="text-muted">CC: <%= p.dni %></small>
                                                        </td>
                                                        <td>
                                                            <% if(p.telefono) { %>
                                                                <a href="https://wa.me/<%= p.telefono %>"
                                                                    target="_blank"
                                                                    class="btn btn-sm btn-success text-white"
                                                                    title="Enviar WhatsApp">
                                                                    <i class="bi bi-whatsapp"></i>
                                                                    <%= p.telefono %>
                                                                </a>
                                                                <% } else { %>
                                                                    <span class="text-muted">-</span>
                                                                    <% } %>
                                                        </td>
                                                        <td class="fw-bold text-danger fs-5">
                                                            <%= empresa.moneda %>
                                                                <%= formatCurrency(p.monto_total, 2) %>
                                                        </td>
                                                        <td class="text-danger">
                                                            <%= fechaFin.toLocaleDateString() %>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-warning text-dark">+<%= diffDays %>
                                                                    días</span>
                                                        </td>
                                                        <td>
                                                            <a href="/pagos/registrar/<%= p.id %>"
                                                                class="btn btn-sm btn-primary shadow-sm">
                                                                <i class="bi bi-cash-coin"></i> Cobrar Ahora
                                                            </a>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="d-block d-md-none p-3">
                                        <% vencidos.forEach(p=> {
                                            // Calcular días de retraso
                                            const fechaFin = new Date(p.fecha_fin);
                                            const hoy = new Date();
                                            const diffTime = Math.abs(hoy - fechaFin);
                                            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                                            %>
                                            <div class="card border-0 shadow-sm rounded-4 mb-3 p-3 bg-white border-start border-danger border-3">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="badge bg-danger">#<%= p.id %></span>
                                                    <span class="badge bg-warning text-dark">+<%= diffDays %> días moroso</span>
                                                </div>
                                                <div class="mb-2">
                                                    <div class="fw-bold text-dark fs-6"><%= p.nombre %> <%= p.apellido %></div>
                                                    <small class="text-muted d-block">CC: <%= p.dni %></small>
                                                    <small class="text-danger d-block mt-1">Límite: <%= fechaFin.toLocaleDateString() %></small>
                                                </div>
                                                <div class="mb-2">
                                                    <% if(p.telefono) { %>
                                                        <a href="https://wa.me/<%= p.telefono %>"
                                                            target="_blank"
                                                            class="btn btn-sm btn-success text-white py-1 px-2 rounded-pill"
                                                            title="Enviar WhatsApp">
                                                            <i class="bi bi-whatsapp me-1"></i><%= p.telefono %>
                                                        </a>
                                                    <% } %>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                                    <div>
                                                        <span class="text-muted small d-block">Deuda Total</span>
                                                        <span class="fw-bold text-danger font-monospace">
                                                            <%= empresa.moneda %> <%= formatCurrency(p.monto_total, 2) %>
                                                        </span>
                                                    </div>
                                                    <a href="/pagos/registrar/<%= p.id %>"
                                                        class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">
                                                        <i class="bi bi-cash-coin me-1"></i> Cobrar
                                                    </a>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                                <% } else { %>
                                    <div class="text-center py-5">
                                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                                        <h3 class="mt-3 text-success">¡Excelente!</h3>
                                        <p class="text-muted">No tienes préstamos vencidos en este momento.</p>
                                    </div>
                                    <% } %>

                        </div>
                    </div>
            </div>
        </div>
        <%- include('../partials/footer') %>
