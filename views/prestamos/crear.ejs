<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>

    <body>
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <%- include('../partials/sidebar') %>

                    <div class="col py-0 py-md-3 main-content-wrapper">
                        <%- include('../partials/mobile-header') %>
                            <div class="container-fluid px-4 py-4">

                                <h3 class="text-center text-secondary mb-4">Otorgar Nuevo Préstamo</h3>

                                <% if(mensajeError && mensajeError.length> 0) { %>
                                    <div class="alert alert-danger">
                                        <%= mensajeError %>
                                    </div>
                                    <% } %>

                                        <form action="/prestamos/guardar" method="POST" id="formPrestamo">
                                            <div class="row">

                                                <div class="col-md-8">
                                                    <div class="card card-box p-4 border-0 shadow-sm">
                                                        <h5 class="text-primary mb-3">Detalles Financieros</h5>

                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold">Seleccionar Cliente</label>
                                                            <select name="cliente_id" id="selectCliente" class="form-select" required>
                                                                <option value="">-- Buscador de Clientes --</option>
                                                                <% clientes.forEach(c=> { %>
                                                                    <option value="<%= c.id %>">
                                                                        <%= c.dni %> - <%= c.nombre %> <%= c.apellido %>
                                                                    </option>
                                                                <% }) %>
                                                            </select>
                                                        </div>

                                                         <!-- Badge de Score Crediticio del Cliente -->
                                                         <div id="scoreBadgeContainer" class="mb-3" style="display:none;">
                                                             <div id="scoreBadge" class="alert d-flex align-items-center gap-2 py-2 mb-2" role="alert" style="border-radius:10px;">
                                                                 <span id="scoreBadgeIcon" style="font-size:1.4rem;"></span>
                                                                 <div>
                                                                     <span class="fw-bold" id="scoreBadgeTitle"></span>
                                                                     <small class="d-block" id="scoreBadgeDesc"></small>
                                                                 </div>
                                                                 <span id="scoreBadgePuntos" class="ms-auto badge fs-6"></span>
                                                             </div>
                                                             <div id="limiteBadge" class="alert alert-secondary d-flex align-items-center gap-2 py-2 mb-0" role="alert" style="border-radius:10px;">
                                                                 <span style="font-size:1.4rem;">🔒</span>
                                                                 <div>
                                                                     <span class="fw-bold text-dark" id="limiteBadgeTitle">Límite de Crédito Permitido: $0</span>
                                                                     <small class="d-block text-muted" id="limiteBadgeDesc"></small>
                                                                 </div>
                                                             </div>
                                                         </div>

                                                         <div class="row">
                                                             <div class="col-md-4 mb-3">
                                                                 <label class="form-label">Monto a Prestar (<%= empresa.moneda %>)</label>
                                                                 <input type="text" name="monto" id="inputMonto"
                                                                     class="form-control currency-input" required
                                                                     placeholder="0">
                                                                 <div id="montoExcedidoFeedback" class="invalid-feedback" style="display:none;">
                                                                     El monto ingresado supera el límite de crédito permitido.
                                                                 </div>
                                                             </div>
                                                            <div class="col-md-4 mb-3">
                                                                <label class="form-label d-flex align-items-center gap-2">
                                                                    Interés Mensual (%)
                                                                    <span id="badgeTasaPersonalizada" class="badge bg-secondary rounded-pill" style="font-size:0.7rem;display:none;">✏️ Personalizado</span>
                                                                </label>
                                                                <input type="number" step="0.01" name="interes"
                                                                    id="inputInteres" class="form-control" required
                                                                    placeholder="2">
                                                            </div>
                                                            <div class="col-md-4 mb-3">
                                                                <label class="form-label">Interés Mora (%)</label>
                                                                <input type="number" step="0.01" name="interes_mora"
                                                                    id="inputInteresMora" class="form-control" required
                                                                    placeholder="5" value="5">
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-md-6 mb-3">
                                                                <label class="form-label">Cantidad de Cuotas</label>
                                                                <input type="number" name="cuotas" id="inputCuotas"
                                                                    class="form-control" required value="1">
                                                            </div>
                                                            <div class="col-md-6 mb-3">
                                                                <label class="form-label">Frecuencia de Pago</label>
                                                                <select name="frecuencia" class="form-select">
                                                                    <option value="diario">Diario</option>
                                                                    <option value="semanal">Semanal</option>
                                                                    <option value="quincenal">Quincenal</option>
                                                                    <option value="mensual" selected>Mensual</option>
                                                                    <option value="bimensual">Bimensual</option>
                                                                    <option value="trimensual">Trimensual</option>
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label">Fecha de Inicio</label>
                                                            <input type="date" name="fecha_inicio" id="inputFechaInicio" class="form-control"
                                                                required
                                                                value="<%= new Date().toISOString().split('T')[0] %>">
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label">Observaciones</label>
                                                            <textarea name="observaciones" class="form-control" rows="3" placeholder="Notas adicionales sobre el préstamo..."></textarea>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="card bg-dark text-white p-4 h-100 shadow-sm">
                                                        <h5 class="mb-4 border-bottom pb-2 text-white">Simulación</h5>

                                                        <div class="mb-4">
                                                            <small class="text-white-50">Monto Solicitado</small>
                                                            <h3 class="fw-bold text-primary" id="simMonto">
                                                                <%= empresa.moneda %> 0.00
                                                            </h3>
                                                        </div>

                                                        <div class="mb-4">
                                                            <small class="text-white-50">Interés Ganado</small>
                                                            <h3 class="fw-bold text-warning" id="simInteres">
                                                                <%= empresa.moneda %> 0.00
                                                            </h3>
                                                        </div>

                                                        <div class="mb-4">
                                                            <small class="text-white-50">Total a Devolver</small>
                                                            <h2 class="fw-bold text-success" id="simTotal">
                                                                <%= empresa.moneda %> 0.00
                                                            </h2>
                                                        </div>

                                                        <div class="mb-4">
                                                            <small class="text-white-50">Valor por Cuota</small>
                                                            <h3 class="fw-bold text-info" id="simCuota">
                                                                <%= empresa.moneda %> 0.00
                                                            </h3>
                                                        </div>
                                                        
                                                        <div class="mb-4">
                                                            <small class="text-white-50">Mora Diaria Estimada</small>
                                                            <h3 class="fw-bold text-danger" id="simMora">
                                                                <%= empresa.moneda %> 0.00
                                                            </h3>
                                                        </div>

                                                        <div class="mb-4">
                                                            <small class="text-white-50">Finalización Estimada</small>
                                                            <h3 class="fw-bold text-white" id="simFechaFin">
                                                                --/--/----
                                                            </h3>
                                                        </div>

                                                        <div class="d-grid mt-auto">
                                                            <button type="submit"
                                                                class="btn btn-success btn-lg fw-bold">
                                                                Confirmar Préstamo
                                                            </button>
                                                            <a href="/prestamos"
                                                                class="btn btn-outline-light mt-2 btn-sm">Cancelar</a>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </form>

                            </div>
                    </div>
            </div        <%- include('../partials/footer') %>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const inputMonto = document.getElementById('inputMonto');
                    const inputInteres = document.getElementById('inputInteres');
                    const formPrestamo = document.getElementById('formPrestamo');

                    const simMonto = document.getElementById('simMonto');
                    const simInteres = document.getElementById('simInteres');
                    const simTotal = document.getElementById('simTotal');
                    const simCuota = document.getElementById('simCuota');
                    const simMora = document.getElementById('simMora');
                    const inputCuotas = document.getElementById('inputCuotas');
                    const inputInteresMora = document.getElementById('inputInteresMora');
                    const inputFechaInicio = document.getElementById('inputFechaInicio');
                    const simFechaFin = document.getElementById('simFechaFin');

                    // Límite de crédito cargado dinámicamente
                    let limiteMaximoCliente = null;

                    // Obtenemos el símbolo de moneda desde el servidor
                    const moneda = "<%= empresa.moneda %>";

                    // Aplicamos la máscara de miles al input de monto
                    if (window.applyCurrencyMask) {
                        window.applyCurrencyMask('.currency-input');
                    }

                    // --- CAPTURA DE DATOS DESDE EL SIMULADOR ---
                    const urlParams = new URLSearchParams(window.location.search);
                    const pMonto = urlParams.get('monto');
                    const pInteres = urlParams.get('interes');
                    const pMora = urlParams.get('interes_mora');
                    const pCuotas = urlParams.get('cuotas');
                    const pFrecuencia = urlParams.get('frecuencia');
                    const pFechaInicio = urlParams.get('fecha_inicio');

                    if (pMonto) inputMonto.value = pMonto;
                    if (pInteres) inputInteres.value = pInteres;
                    if (pMora) document.getElementById('inputInteresMora').value = pMora;
                    if (pCuotas) inputCuotas.value = pCuotas;
                    if (pFrecuencia) document.querySelector('select[name="frecuencia"]').value = pFrecuencia;
                    if (pFechaInicio) inputFechaInicio.value = pFechaInicio;

                    // Si el monto fue seteado, disparamos el formateo
                    if (pMonto && window.applyCurrencyMask) {
                        const event = new Event('input', { bubbles: true });
                        inputMonto.dispatchEvent(event);
                    }
                    // ------------------------------------------

                    function calcular() {
                        // Obtenemos el valor limpio (solo números)
                        const rawValue = inputMonto.value.replace(/\D/g, '');
                        const m = parseFloat(rawValue) || 0;
                        const i = parseFloat(inputInteres.value) || 0;
                        const c = parseInt(inputCuotas.value) || 1;
                        const f = document.querySelector('select[name="frecuencia"]').value;

                        // Validar contra el límite máximo en tiempo real
                        if (limiteMaximoCliente !== null && m > limiteMaximoCliente) {
                            inputMonto.classList.add('is-invalid');
                            document.getElementById('montoExcedidoFeedback').style.display = 'block';
                            const fmtLimite = window.formatCurrency ? window.formatCurrency(limiteMaximoCliente, 0) : limiteMaximoCliente;
                            document.getElementById('montoExcedidoFeedback').textContent = `El monto ingresado supera el límite de crédito permitido de ${moneda} ${fmtLimite}.`;
                        } else {
                            inputMonto.classList.remove('is-invalid');
                            document.getElementById('montoExcedidoFeedback').style.display = 'none';
                        }

                        // Lógica de interés mensual (debe coincidir con utils/finance.js)
                        let factor = 1;
                        if (f === 'diario') factor = 1/30;
                        else if (f === 'semanal') factor = 7/30;
                        else if (f === 'quincenal') factor = 0.5;
                        else if (f === 'mensual') factor = 1;
                        else if (f === 'bimensual') factor = 2;
                        else if (f === 'trimensual') factor = 3;

                        const tasaTotal = i * (c * factor);
                        const interesGanado = m * (tasaTotal / 100);
                        const total = m + interesGanado;
                        const cuota = total / (c > 0 ? c : 1);
                        
                        // Cálculo de mora diaria (basado en el monto total prestado)
                        const im = parseFloat(inputInteresMora.value) || 0;
                        const moraDiaria = (m * (im / 100)) / 30;

                        if (window.formatCurrency) {
                            simMonto.innerText = `${moneda} ${window.formatCurrency(m, 2)}`;
                            simInteres.innerText = `${moneda} ${window.formatCurrency(interesGanado, 2)}`;
                            simTotal.innerText = `${moneda} ${window.formatCurrency(total, 2)}`;
                            simCuota.innerText = `${moneda} ${window.formatCurrency(cuota, 2)}`;
                            simMora.innerText = `${moneda} ${window.formatCurrency(moraDiaria, 2)}`;
                        } else {
                            simMonto.innerText = `${moneda} ${m.toFixed(2)}`;
                            simInteres.innerText = `${moneda} ${interesGanado.toFixed(2)}`;
                            simTotal.innerText = `${moneda} ${total.toFixed(2)}`;
                            simCuota.innerText = `${moneda} ${cuota.toFixed(2)}`;
                            simMora.innerText = `${moneda} ${moraDiaria.toFixed(2)}`;
                        }

                        // Calcular Fecha de Finalización
                        if (inputFechaInicio.value) {
                            const fechaI = new Date(inputFechaInicio.value + 'T00:00:00');
                            let fechaF = new Date(fechaI);
                            if (f === 'diario') fechaF.setDate(fechaF.getDate() + c);
                            else if (f === 'semanal') fechaF.setDate(fechaF.getDate() + (c * 7));
                            else if (f === 'quincenal') fechaF.setDate(fechaF.getDate() + (c * 15));
                            else if (f === 'mensual') fechaF.setMonth(fechaF.getMonth() + c);
                            else if (f === 'bimensual') fechaF.setMonth(fechaF.getMonth() + (c * 2));
                            else if (f === 'trimensual') fechaF.setMonth(fechaF.getMonth() + (c * 3));

                            const opciones = { day: '2-digit', month: '2-digit', year: 'numeric' };
                            simFechaFin.innerText = fechaF.toLocaleDateString('es-CO', opciones);
                        }
                    }

                    // Escuchamos tanto el evento personalizado como el estándar
                    inputMonto.addEventListener('moneyInput', calcular);
                    inputMonto.addEventListener('input', calcular);

                    inputInteres.addEventListener('input', calcular);
                    inputInteresMora.addEventListener('input', calcular);
                    inputCuotas.addEventListener('input', calcular);
                    inputFechaInicio.addEventListener('change', calcular);
                    document.querySelector('select[name="frecuencia"]').addEventListener('change', calcular);

                    // LIMPIAR PUNTOS ANTES DE ENVIAR AL SERVIDOR Y VALIDAR LÍMITES
                    if (formPrestamo) {
                        formPrestamo.addEventListener('submit', function (e) {
                            if (limiteMaximoCliente !== null) {
                                const rawValue = inputMonto.value.replace(/\D/g, '');
                                const m = parseFloat(rawValue) || 0;
                                if (m > limiteMaximoCliente) {
                                    e.preventDefault();
                                    const fmtLimite = window.formatCurrency ? window.formatCurrency(limiteMaximoCliente, 0) : limiteMaximoCliente;
                                    const fmtMonto = window.formatCurrency ? window.formatCurrency(m, 0) : m;
                                    Swal.fire({
                                        title: 'Límite de Crédito Excedido',
                                        text: `El monto solicitado (${moneda} ${fmtMonto}) supera el límite de crédito permitido para este cliente (${moneda} ${fmtLimite}).`,
                                        icon: 'warning',
                                        confirmButtonText: 'Entendido',
                                        confirmButtonColor: '#dc2626'
                                    });
                                    return false;
                                }
                            }
                            inputMonto.value = inputMonto.value.replace(/\D/g, ''); // Deja solo números
                        });
                    }

                    // Ejecutar cálculo inicial
                    calcular();

                    // ── AUTO-LLENADO DE TASAS POR SCORE CREDITICIO Y LÍMITES ─────────
                    const selectCliente      = document.getElementById('selectCliente');
                    const badgeContainer     = document.getElementById('scoreBadgeContainer');
                    const scoreBadge         = document.getElementById('scoreBadge');
                    const scoreBadgeIcon     = document.getElementById('scoreBadgeIcon');
                    const scoreBadgeTitle    = document.getElementById('scoreBadgeTitle');
                    const scoreBadgeDesc     = document.getElementById('scoreBadgeDesc');
                    const scoreBadgePuntos   = document.getElementById('scoreBadgePuntos');
                    const badgeTasaPersonal  = document.getElementById('badgeTasaPersonalizada');

                    // Mapa de estilos por categoría
                    const estilosPorCategoria = {
                        A: { alertClass: 'alert-success', badgeClass: 'bg-success', icono: '🏆', color: '#10b981' },
                        B: { alertClass: 'alert-info',    badgeClass: 'bg-info',    icono: '🟦', color: '#3b82f6' },
                        C: { alertClass: 'alert-warning', badgeClass: 'bg-warning text-dark', icono: '🟡', color: '#f59e0b' },
                        D: { alertClass: 'alert-danger',  badgeClass: 'bg-danger',  icono: '🔴', color: '#f87171' },
                        E: { alertClass: 'alert-danger',  badgeClass: 'bg-dark',    icono: '⚫', color: '#dc2626' }
                    };

                    // Valor de tasa original sugerida para detectar si el admin la modificó
                    let tasaSugeridaOriginal = null;

                    /**
                     * Consulta el score del cliente seleccionado vía AJAX y pre-llena los campos de tasa.
                     */
                    async function cargarScoreCliente() {
                        const clienteId = selectCliente.value;
                        if (!clienteId) {
                            badgeContainer.style.display = 'none';
                            tasaSugeridaOriginal = null;
                            limiteMaximoCliente = null;
                            inputMonto.classList.remove('is-invalid');
                            document.getElementById('montoExcedidoFeedback').style.display = 'none';
                            return;
                        }

                        try {
                            const resp = await fetch(`/clientes/score/${clienteId}`);
                            if (!resp.ok) throw new Error('Sin score disponible');
                            const data = await resp.json();

                            if (!data.success) throw new Error(data.mensaje || 'Sin score');

                            const cat = data.categoria || 'C';
                            const estilos = estilosPorCategoria[cat] || estilosPorCategoria['C'];

                            // Actualizar badge visual
                            scoreBadge.className = `alert d-flex align-items-center gap-2 py-2 mb-2 ${estilos.alertClass}`;
                            scoreBadgeIcon.textContent = estilos.icono;
                            scoreBadgeTitle.textContent = `Score ${cat} — ${data.descripcion}`;
                            scoreBadgeDesc.textContent  = `Tasa sugerida: ${data.tasaSugerida}% mensual / Mora: ${data.tasaMoraSugerida}%`;
                            scoreBadgePuntos.textContent = `${data.score} pts`;
                            scoreBadgePuntos.className  = `ms-auto badge fs-6 ${estilos.badgeClass}`;

                            // Actualizar límite visual
                            limiteMaximoCliente = parseFloat(data.limiteMaximo) || 0;
                            const fmtLimite = window.formatCurrency ? window.formatCurrency(limiteMaximoCliente, 0) : limiteMaximoCliente;
                            document.getElementById('limiteBadgeTitle').textContent = `Límite de Crédito Permitido: ${moneda} ${fmtLimite}`;
                            document.getElementById('limiteBadgeDesc').textContent = data.limiteMotivo;

                            badgeContainer.style.display = 'block';

                            // Pre-llenar los campos de tasa
                            tasaSugeridaOriginal = data.tasaSugerida;
                            inputInteres.value      = data.tasaSugerida;
                            inputInteresMora.value  = data.tasaMoraSugerida;
                            badgeTasaPersonal.style.display = 'none';

                            // Recalcular simulación con los nuevos valores
                            calcular();
                        } catch (e) {
                            // Si el cliente aún no tiene score, ocultamos el badge pero no bloqueamos
                            badgeContainer.style.display = 'none';
                            tasaSugeridaOriginal = null;
                            limiteMaximoCliente = null;
                            inputMonto.classList.remove('is-invalid');
                            document.getElementById('montoExcedidoFeedback').style.display = 'none';
                        }
                    }

                    // Detectar si el admin modifica manualmente la tasa sugerida
                    inputInteres.addEventListener('input', function () {
                        if (tasaSugeridaOriginal !== null && parseFloat(this.value) !== tasaSugeridaOriginal) {
                            badgeTasaPersonal.style.display = 'inline-block';
                        } else {
                            badgeTasaPersonal.style.display = 'none';
                        }
                    });

                    selectCliente.addEventListener('change', cargarScoreCliente);
                    // ────────────────────────────────────────────────────────────────
                });
            </script>�───────────────────────
                });
            </script>──────────────────────────────────────────────────────────
                });
            </script>