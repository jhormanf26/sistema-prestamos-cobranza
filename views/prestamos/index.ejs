<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<style>
    /* Solo para los encabezados ordenables */
    th.sortable-header { 
        padding: 0 !important; 
        transition: background-color 0.2s;
    }
    th.sortable-header a { 
        display: flex; 
        align-items: center; 
        justify-content: space-between;
        padding: 0.75rem; 
        text-decoration: none; 
        color: #444; 
        width: 100%;
        height: 100%;
    }
    th.sortable-header a:hover { background-color: #f8f9fa; color: #0d6efd; }
    th.sortable-header i { font-size: 0.7rem; margin-left: 5px; color: #ccc; }
    th.sortable-header.active i { color: #0d6efd; opacity: 1; }
    th.sortable-header.active { border-bottom: 2px solid #0d6efd; background-color: #f0f7ff; }

    /* Estilos para botones de acción compactos */
    .btn-xs {
        padding: 0.15rem 0.35rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 4px;
    }
    .main-content-wrapper .table td {
        vertical-align: middle;
        padding-top: 12px;
        padding-bottom: 12px;
    }
</style>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <%- include('../partials/sidebar') %>
            
            <div class="col py-0 py-md-3 main-content-wrapper">
                <%- include('../partials/mobile-header') %>
                
                <div class="container-fluid px-4 py-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                        <h2>💰 Gestión de Préstamos</h2>
                        
                        <div class="d-flex gap-2">
                            <a href="/reportes/excel/prestamos" class="btn btn-success">
                                <i class="bi bi-file-earmark-spreadsheet"></i> Exportar Excel
                            </a>
                            <a href="/prestamos/crear" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Nuevo Préstamo
                            </a>
                        </div>
                    </div>

                    <% if(mensajeExito && mensajeExito.length > 0) { %>
                        <div class="d-none" id="flashMessageSuccess"><%= mensajeExito %></div>
                    <% } %>
                    <% if(mensajeError && mensajeError.length > 0) { %>
                        <div class="d-none" id="flashMessageError"><%= mensajeError %></div>
                    <% } %>

                    <div class="card card-box p-3 mb-4 bg-light">
                        <form action="/prestamos" method="GET" class="row g-2 align-items-center">
                            <div class="col-auto">
                                <label class="col-form-label fw-bold"><i class="bi bi-search"></i> Buscar:</label>
                            </div>
                            <div class="col-auto flex-grow-1">
                                <input type="text" name="q" class="form-control" placeholder="Nombre de Cliente o ID Préstamo..." value="<%= busqueda %>">
                                <input type="hidden" name="sort" value="<%= sort %>">
                                <input type="hidden" name="order" value="<%= order %>">
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-dark">Filtrar</button>
                                <% if(busqueda) { %>
                                    <a href="/prestamos" class="btn btn-outline-secondary">Limpiar</a>
                                <% } %>
                            </div>
                        </form>
                    </div>

                    <div class="card card-box p-3">
                        <div class="table-responsive d-none d-md-block">
                                    <table class="table table-hover align-middle">
                                        <thead class="table-light text-uppercase small fw-bold">
                                            <tr>
                                                <th class="sortable-header <%= sort === 'id' ? 'active' : '' %>">
                                                    <a href="/prestamos?q=<%= busqueda %>&sort=id&order=<%= sort === 'id' && order === 'asc' ? 'desc' : 'asc' %>">
                                                        ID <i class="bi <%= sort === 'id' ? (order === 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill') : 'bi-caret-down' %>"></i>
                                                    </a>
                                                </th>
                                                <th class="sortable-header <%= sort === 'nombre' ? 'active' : '' %>">
                                                    <a href="/prestamos?q=<%= busqueda %>&sort=nombre&order=<%= sort === 'nombre' && order === 'asc' ? 'desc' : 'asc' %>">
                                                        Cliente <i class="bi <%= sort === 'nombre' ? (order === 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill') : 'bi-caret-down' %>"></i>
                                                    </a>
                                                </th>
                                                <th class="sortable-header <%= sort === 'monto_total' ? 'active' : '' %>">
                                                    <a href="/prestamos?q=<%= busqueda %>&sort=monto_total&order=<%= sort === 'monto_total' && order === 'asc' ? 'desc' : 'asc' %>">
                                                        Total <i class="bi <%= sort === 'monto_total' ? (order === 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill') : 'bi-caret-down' %>"></i>
                                                    </a>
                                                </th>
                                                <th>Pagado</th>
                                                <th>Saldo</th>
                                                <th class="sortable-header <%= sort === 'estado' ? 'active' : '' %>">
                                                    <a href="/prestamos?q=<%= busqueda %>&sort=estado&order=<%= sort === 'estado' && order === 'asc' ? 'desc' : 'asc' %>">
                                                        Estado <i class="bi <%= sort === 'estado' ? (order === 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill') : 'bi-caret-down' %>"></i>
                                                    </a>
                                                </th>
                                                <th class="text-end pe-3">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (prestamos.length > 0) { %>
                                                <% prestamos.forEach(p => { 
                                                    const pagado = p.total_pagado || 0;
                                                    const saldo = p.monto_total - pagado;
                                                %>
                                                    <tr>
                                                        <td><span class="badge bg-dark">#<%= p.id %></span></td>
                                                        <td>
                                                            <div class="fw-bold"><%= p.nombre %> <%= p.apellido %></div>
                                                            <div class="text-muted small"><i class="bi bi-person-vcard me-1"></i><%= p.dni %></div>
                                                        </td>
                                                        <td class="small fw-bold text-muted">
                                                            <%= empresa.moneda %> <%= formatCurrency(p.monto_total, 2) %>
                                                        </td>
                                                        <td class="text-primary fw-bold">
                                                            <%= empresa.moneda %> <%= formatCurrency(pagado, 2) %>
                                                        </td>
                                                        <td class="text-danger fw-bold">
                                                            <%= empresa.moneda %> <%= formatCurrency(saldo, 2) %>
                                                        </td>
                                                        <td>
                                                            <% if(p.estado == 'pendiente') { %>
                                                                <span class="badge bg-warning text-dark px-3 rounded-pill" style="font-size: 0.65rem;">PENDIENTE</span>
                                                            <% } else if(p.estado == 'pagado') { %>
                                                                <span class="badge bg-success px-3 rounded-pill" style="font-size: 0.65rem;">PAGADO</span>
                                                            <% } else { %>
                                                                <span class="badge bg-danger px-3 rounded-pill" style="font-size: 0.65rem;">VENCIDO</span>
                                                            <% } %>
                                                        </td>
                                                        <td class="text-end pe-3">
                                                            <div class="d-flex flex-column align-items-end gap-1" style="min-width: 160px;">
                                                                <!-- Acciones Principales -->
                                                                <div class="btn-group btn-group-sm w-100 shadow-sm rounded border overflow-hidden">
                                                                    <% if(p.estado != 'pagado') { %>
                                                                        <a href="/pagos/registrar/<%= p.id %>" class="btn btn-success py-2 border-end" title="Registrar Pago">
                                                                            <i class="bi bi-cash-coin me-1"></i> PAGO
                                                                        </a>
                                                                    <% } %>
                                                                    <a href="/clientes/ver/<%= p.cliente_id %>" class="btn btn-white py-2" title="Ir al Perfil">
                                                                        <i class="bi bi-person-fill text-primary"></i>
                                                                    </a>
                                                                </div>

                                                                <!-- Documentos y Otros -->
                                                                <div class="btn-group btn-group-sm w-100 shadow-sm rounded border overflow-hidden bg-white">
                                                                    <a href="/prestamos/cronograma/<%= p.id %>" class="btn btn-light py-2 flex-fill border-end" title="Cronograma Interactivo">
                                                                        <i class="bi bi-calendar3 text-primary"></i>
                                                                    </a>
                                                                    <a href="/reportes/cronograma-pdf/<%= p.id %>" target="_blank" class="btn btn-light py-2 flex-fill border-end" title="PDF Cronograma">
                                                                        <i class="bi bi-file-earmark-pdf text-danger"></i>
                                                                    </a>
                                                                    <a href="/reportes/contrato/<%= p.id %>" target="_blank" class="btn btn-light py-2 flex-fill border-end" title="PDF Contrato">
                                                                        <i class="bi bi-file-text text-secondary"></i>
                                                                    </a>
                                                                    <a href="/reportes/ticket-desembolso/<%= p.id %>" target="_blank" class="btn btn-light py-2 flex-fill <%= p.estado == 'pagado' ? 'border-end' : '' %>" title="PDF Desembolso">
                                                                        <i class="bi bi-receipt text-success"></i>
                                                                    </a>
                                                                    <% if (p.estado == 'pagado') { %>
                                                                        <a href="/reportes/paz-y-salvo/<%= p.id %>" target="_blank" class="btn btn-light py-2 flex-fill text-success fw-bold" title="PDF Paz y Salvo">
                                                                            <i class="bi bi-patch-check-fill"></i>
                                                                        </a>
                                                                    <% } %>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                    <% } else { %>
                                        <tr><td colspan="6" class="text-center py-5 text-muted">No se encontraron préstamos registrados.</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Vista Móvil: Tarjeticas Premium de Préstamos -->
                        <div class="d-block d-md-none mt-3">
                            <% if (prestamos.length > 0) { %>
                                <div class="d-flex flex-column gap-3">
                                    <% prestamos.forEach(p => { 
                                        const pagado = p.total_pagado || 0;
                                        const saldo = p.monto_total - pagado;
                                    %>
                                        <div class="card border border-light-subtle shadow-sm rounded-4 p-3 bg-white">
                                            <!-- Fila superior: ID Préstamo, Estado y Dropdown -->
                                            <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-dark px-2.5 py-1.5 rounded-3 fw-bold" style="font-size: 0.8rem;">#<%= p.id %></span>
                                                    <div>
                                                        <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;"><%= p.nombre %> <%= p.apellido %></h6>
                                                        <small class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-person-vcard me-1"></i><%= p.dni %></small>
                                                    </div>
                                                </div>
                                                
                                                <div class="d-flex align-items-center gap-2">
                                                    <% if(p.estado == 'pendiente') { %>
                                                        <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.65rem;">PENDIENTE</span>
                                                    <% } else if(p.estado == 'pagado') { %>
                                                        <span class="badge bg-success rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.65rem;">PAGADO</span>
                                                    <% } else { %>
                                                        <span class="badge bg-danger rounded-pill px-2.5 py-1 fw-bold animate-pulse" style="font-size: 0.65rem;">VENCIDO</span>
                                                    <% } %>

                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-sm btn-light border rounded-pill px-2.5 py-1 d-flex align-items-center justify-content-center" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.8rem;">
                                                            <i class="bi bi-three-dots-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3" style="z-index: 1040;">
                                                            <li><a class="dropdown-item py-2" href="/prestamos/cronograma/<%= p.id %>"><i class="bi bi-calendar3 text-primary me-2"></i> Cronograma</a></li>
                                                            <li><a class="dropdown-item py-2" href="/clientes/ver/<%= p.cliente_id %>"><i class="bi bi-person-fill text-info me-2"></i> Ver Cliente</a></li>
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li><a class="dropdown-item py-2 text-danger" href="/reportes/cronograma-pdf/<%= p.id %>" target="_blank"><i class="bi bi-file-earmark-pdf me-2"></i> PDF Cronograma</a></li>
                                                            <li><a class="dropdown-item py-2" href="/reportes/contrato/<%= p.id %>" target="_blank"><i class="bi bi-file-text text-secondary me-2"></i> PDF Contrato</a></li>
                                                            <li><a class="dropdown-item py-2 text-success" href="/reportes/ticket-desembolso/<%= p.id %>" target="_blank"><i class="bi bi-receipt me-2"></i> PDF Desembolso</a></li>
                                                            <% if (p.estado == 'pagado') { %>
                                                                <li><a class="dropdown-item py-2 text-success fw-bold animate-pulse" href="/reportes/paz-y-salvo/<%= p.id %>" target="_blank"><i class="bi bi-patch-check-fill me-2"></i> PDF Paz y Salvo</a></li>
                                                            <% } %>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Fila central: Totales -->
                                            <div class="d-flex align-items-center justify-content-between bg-light bg-opacity-50 rounded-3 p-2.5 mb-3">
                                                <div class="text-center flex-fill border-end">
                                                    <span class="d-block text-muted small mb-1" style="font-size: 0.65rem; text-uppercase; font-weight:600;">Monto Total</span>
                                                    <span class="fw-bold text-dark small" style="font-size: 0.85rem;"><%= empresa.moneda %> <%= formatCurrency(p.monto_total, 0) %></span>
                                                </div>
                                                
                                                <div class="text-center flex-fill border-end">
                                                    <span class="d-block text-muted small mb-1" style="font-size: 0.65rem; text-uppercase; font-weight:600;">Pagado</span>
                                                    <span class="fw-bold text-success small" style="font-size: 0.85rem;"><%= empresa.moneda %> <%= formatCurrency(pagado, 0) %></span>
                                                </div>

                                                <div class="text-center flex-fill">
                                                    <span class="d-block text-muted small mb-1" style="font-size: 0.65rem; text-uppercase; font-weight:600;">Saldo</span>
                                                    <span class="fw-bold text-danger small" style="font-size: 0.85rem;"><%= empresa.moneda %> <%= formatCurrency(saldo, 0) %></span>
                                                </div>
                                            </div>

                                            <!-- Botones directos de acción principal -->
                                            <div class="d-flex gap-2">
                                                <% if(p.estado != 'pagado') { %>
                                                    <a href="/pagos/registrar/<%= p.id %>" class="btn btn-success btn-sm flex-fill fw-bold py-2 rounded-pill shadow-xs">
                                                        <i class="bi bi-cash-coin me-1"></i> REGISTRAR PAGO
                                                    </a>
                                                <% } %>
                                                <a href="/prestamos/cronograma/<%= p.id %>" class="btn btn-outline-primary btn-sm flex-fill fw-bold py-2 rounded-pill shadow-xs">
                                                    <i class="bi bi-calendar3 me-1"></i> VER CRONOGRAMA
                                                </a>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-4 bg-white rounded-4 border text-muted">No se encontraron préstamos registrados.</div>
                            <% } %>
                        </div>
                        
                        <% if (totalPages > 1) { %>
                            <nav class="mt-4 d-flex justify-content-between align-items-center">
                                <small class="text-muted">Página <%= currentPage %> de <%= totalPages %></small>
                                <ul class="pagination mb-0">
                                    <li class="page-item <%= currentPage == 1 ? 'disabled' : '' %>">
                                        <a class="page-link" href="/prestamos?page=<%= currentPage - 1 %>&q=<%= busqueda %>&sort=<%= sort %>&order=<%= order %>">Anterior</a>
                                    </li>
                                    <li class="page-item <%= currentPage == totalPages ? 'disabled' : '' %>">
                                        <a class="page-link" href="/prestamos?page=<%= currentPage + 1 %>&q=<%= busqueda %>&sort=<%= sort %>&order=<%= order %>">Siguiente</a>
                                    </li>
                                </ul>
                            </nav>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include('../partials/footer') %>