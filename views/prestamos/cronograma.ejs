<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>

    <body>
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <%- include('../partials/sidebar') %>

                    <div class="col py-3">
                        <div class="container" style="max-width: 800px;">

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h2>📅 Cronograma de Pagos</h2>
                                <a href="/prestamos" class="btn btn-outline-secondary">Volver</a>
                            </div>

                            <div class="card card-box p-4 border-0 shadow">

                                <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                                    <div>
                                        <h5 class="fw-bold text-primary">
                                            <%= prestamo.nombre %>
                                                <%= prestamo.apellido %>
                                        </h5>
                                        <p class="text-muted mb-0">Préstamo #<%= prestamo.id %> | <%=
                                                    prestamo.frecuencia.toUpperCase() %>
                                        </p>
                                    </div>
                                    <div class="text-end">
                                        <h3 class="fw-bold">
                                            <%= empresa.moneda %>
                                                <%= formatCurrency(prestamo.monto_total, 2) %>
                                        </h3>
                                        <small class="text-muted">Total a Pagar</small>
                                    </div>
                                </div>

                                <div class="table-responsive d-none d-md-block">
                                    <table class="table table-striped text-center align-middle">
                                        <thead class="table-dark">
                                            <tr>
                                                <th># Cuota</th>
                                                <th>Fecha de Vencimiento</th>
                                                <th>Monto a Pagar</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% cronograma.forEach(cuota => {
                                                const hoy = new Date();
                                                const fechaCuota = new Date(cuota.fecha);
 
                                                // Detectar si está vencida: Fecha pasada Y no está pagada (estado Pendiente/Programado o vacío)
                                                // Si cuota.estado viene vacío, asumimos que es 'Pendiente'
                                                const estaPagada = (cuota.estado === 'Pagado');
                                                const vencida = (fechaCuota < hoy) && !estaPagada; %>
                                                    <tr>
                                                        <td class="fw-bold">
                                                            <%= cuota.numero %>
                                                        </td>
 
                                                        <td class="<%= vencida ? 'text-danger fw-bold' : '' %>">
                                                            <%= cuota.fecha.toLocaleDateString() %>
                                                                <% if(vencida) { %>
                                                                    <i class="bi bi-exclamation-circle-fill ms-1 small"
                                                                        title="Cuota Vencida"></i>
                                                                    <% } %>
                                                        </td>
 
                                                        <td>
                                                            <%= empresa.moneda %>
                                                                <%= formatCurrency(cuota.monto, 2) %>
                                                        </td>
 
                                                        <td>
                                                            <% if(cuota.estado==='Pagado' ) { %>
                                                                <span
                                                                    class="badge bg-success bg-opacity-75 text-white shadow-sm">
                                                                    <i class="bi bi-check-circle-fill me-1"></i> Pagado
                                                                </span>
                                                                <% } else if (cuota.clase==='warning' ) { %>
                                                                    <span class="badge bg-warning text-dark border">
                                                                        <%= cuota.estado %>
                                                                    </span>
                                                                    <% } else { %>
                                                                        <span class="badge bg-light text-dark border">
                                                                            <%= cuota.estado || 'Programado' %>
                                                                        </span>
                                                                        <% } %>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Vista Móvil: Tarjeticas Premium del Cronograma -->
                                <div class="d-block d-md-none mt-3">
                                    <div class="d-flex flex-column gap-3">
                                        <% cronograma.forEach(cuota => {
                                            const hoy = new Date();
                                            const fechaCuota = new Date(cuota.fecha);
                                            const estaPagada = (cuota.estado === 'Pagado');
                                            const vencida = (fechaCuota < hoy) && !estaPagada;
                                        %>
                                            <div class="card border border-light-subtle shadow-sm rounded-4 p-3 bg-white">
                                                <!-- Fila superior: Número de Cuota y Estado -->
                                                <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-2">
                                                    <span class="badge bg-dark px-2.5 py-1.5 rounded-3 fw-bold" style="font-size: 0.8rem;">Cuota #<%= cuota.numero %></span>
                                                    <div>
                                                        <% if(cuota.estado === 'Pagado') { %>
                                                            <span class="badge bg-success bg-opacity-75 text-white shadow-sm px-2.5 py-1 fw-bold" style="font-size: 0.75rem;">
                                                                <i class="bi bi-check-circle-fill me-1"></i> Pagado
                                                            </span>
                                                        <% } else if (cuota.clase === 'warning') { %>
                                                            <span class="badge bg-warning text-dark border px-2.5 py-1 fw-bold" style="font-size: 0.75rem;">
                                                                <%= cuota.estado %>
                                                            </span>
                                                        <% } else { %>
                                                            <span class="badge bg-light text-dark border px-2.5 py-1 fw-bold" style="font-size: 0.75rem;">
                                                                <%= cuota.estado || 'Programado' %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                </div>

                                                <!-- Detalles de la cuota: Fecha y Monto -->
                                                <div class="row align-items-center">
                                                    <div class="col-6">
                                                        <small class="text-muted d-block" style="font-size: 0.7rem; text-transform: uppercase; font-weight: 600;">Vencimiento</small>
                                                        <span class="fw-bold <%= vencida ? 'text-danger' : 'text-dark' %>" style="font-size: 0.9rem;">
                                                            <%= cuota.fecha.toLocaleDateString() %>
                                                            <% if(vencida) { %>
                                                                <i class="bi bi-exclamation-circle-fill ms-1 text-danger" title="Cuota Vencida"></i>
                                                            <% } %>
                                                        </span>
                                                    </div>
                                                    <div class="col-6 text-end">
                                                        <small class="text-muted d-block" style="font-size: 0.7rem; text-transform: uppercase; font-weight: 600;">Monto</small>
                                                        <span class="fw-bold text-dark" style="font-size: 0.95rem;">
                                                            <%= empresa.moneda %> <%= formatCurrency(cuota.monto, 2) %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>

                                <% if(prestamo.observaciones) { %>
                                    <div class="mt-4 p-3 bg-light border-start border-primary border-4 rounded shadow-sm">
                                        <h6 class="fw-bold text-primary mb-2"><i class="bi bi-info-circle me-1"></i> Observaciones</h6>
                                        <p class="mb-0 text-secondary" style="font-size: 0.95rem;"><%= prestamo.observaciones %></p>
                                    </div>
                                <% } %>

                                <!-- Evidencia de Desembolso / Entrega del Dinero -->
                                <div class="card card-box mt-4 p-4 border rounded-3 bg-light bg-opacity-75">
                                    <h5 class="fw-bold text-primary mb-3">
                                        <i class="bi bi-shield-check me-1"></i> Evidencia de Desembolso / Entrega de Dinero
                                    </h5>
                                    
                                    <% if (prestamo.comprobante_desembolso || prestamo.notas_desembolso) { %>
                                        <div class="p-3 bg-white border rounded shadow-sm mb-3">
                                            <div class="row align-items-center">
                                                <div class="col-md-8">
                                                    <% if (prestamo.notas_desembolso) { %>
                                                        <p class="mb-2 text-dark"><strong>Notas/Detalle:</strong> <%= prestamo.notes_desembolso || prestamo.notas_desembolso %></p>
                                                    <% } %>
                                                    <p class="text-muted small mb-0">
                                                        <i class="bi bi-calendar-check me-1"></i> Evidencia registrada
                                                    </p>
                                                </div>
                                                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                                    <% if (prestamo.comprobante_desembolso) { %>
                                                        <a href="/uploads/desembolsos/<%= prestamo.comprobante_desembolso %>" target="_blank" class="btn btn-outline-primary btn-sm me-2">
                                                            <i class="bi bi-image me-1"></i> Ver Comprobante
                                                        </a>
                                                    <% } %>
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#formDesembolso" aria-expanded="false" aria-controls="formDesembolso">
                                                        <i class="bi bi-pencil-square me-1"></i> Editar
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>

                                    <div class="collapse <%= !(prestamo.comprobante_desembolso || prestamo.notas_desembolso) ? 'show' : '' %>" id="formDesembolso">
                                        <form action="/prestamos/comprobante-desembolso/<%= prestamo.id %>" method="POST" enctype="multipart/form-data" class="mt-2">
                                            <div class="row">
                                                <div class="col-md-6 mb-3">
                                                    <label for="comprobante" class="form-label fw-bold text-secondary">Foto del Comprobante (Transferencia, Recibo, etc.)</label>
                                                    <input type="file" class="form-control" id="comprobante" name="comprobante" accept="image/*">
                                                    <div class="form-text">Formatos permitidos: JPG, PNG, WEBP, GIF (Máx. 10MB)</div>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <label for="notas" class="form-label fw-bold text-secondary">Notas / Detalles del Desembolso</label>
                                                    <textarea class="form-control" id="notas" name="notas" rows="2" placeholder="Ej: Entregado en efectivo, transferencia por Nequi, etc."><%= prestamo.notas_desembolso || '' %></textarea>
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Guardar Evidencia
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                                <div class="mt-4 text-end">
                                    <a href="/reportes/cronograma-pdf/<%= prestamo.id %>" target="_blank"
                                        class="btn btn-danger btn-lg">
                                        <i class="bi bi-file-pdf-fill"></i> Descargar PDF Oficial
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
            </div>
        </div>
        <%- include('../partials/footer') %>