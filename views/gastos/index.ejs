<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>

    <body>
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <%- include('../partials/sidebar') %>

                    <div class="col py-0 py-md-3 main-content-wrapper">
                        <%- include('../partials/mobile-header') %>
                            <div class="container-fluid px-4 py-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h2>📉 Gastos Operativos</h2>
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                        data-bs-target="#modalGasto">
                                        <i class="bi bi-dash-circle"></i> Registrar Salida
                                    </button>
                                </div>

                                <% if(mensajeExito && mensajeExito.length> 0) { %>
                                    <div class="d-none" id="flashMessageSuccess">
                                        <%= mensajeExito %>
                                    </div>
                                    <% } %>
                                        <% if(mensajeError && mensajeError.length> 0) { %>
                                            <div class="d-none" id="flashMessageError">
                                                <%= mensajeError %>
                                            </div>
                                            <% } %>

                                                <div class="card card-box p-3 mb-4 bg-light">
                                                    <form action="/gastos" method="GET"
                                                        class="row g-2 align-items-center">
                                                        <div class="col-auto">
                                                            <label class="col-form-label fw-bold"><i
                                                                    class="bi bi-search"></i> Buscar:</label>
                                                        </div>
                                                        <div class="col-auto flex-grow-1">
                                                            <input type="text" name="q" class="form-control"
                                                                placeholder="Descripción o Categoría..."
                                                                value="<%= busqueda %>">
                                                        </div>
                                                        <div class="col-auto">
                                                            <button type="submit" class="btn btn-dark">Filtrar</button>
                                                            <% if(busqueda) { %>
                                                                <a href="/gastos"
                                                                    class="btn btn-outline-secondary">Limpiar</a>
                                                                <% } %>
                                                        </div>
                                                    </form>
                                                </div>

                                                <div class="card card-box p-3">
                                                    <div class="table-responsive d-none d-md-block">
                                                        <table class="table table-hover align-middle">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>FECHA</th>
                                                                    <th>DESCRIPCIÓN</th>
                                                                    <th>CATEGORÍA</th>
                                                                    <th>OBSERVACIÓN</th>
                                                                    <th>REGISTRADO POR</th>
                                                                    <th class="text-end">MONTO</th>
                                                                    <th class="text-center">ACCIONES</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% if (gastos.length> 0) { %>
                                                                    <% gastos.forEach(g=> { %>
                                                                        <tr>
                                                                            <td>
                                                                                <%= new
                                                                                    Date(g.fecha_gasto).toLocaleDateString()
                                                                                    %>
                                                                            </td>
                                                                            <td class="fw-bold">
                                                                                <%= g.descripcion %>
                                                                            </td>
                                                                            <td><span class="badge bg-secondary">
                                                                                    <%= g.categoria %>
                                                                                </span></td>
                                                                            <td class="text-muted small">
                                                                                <%= g.observacion || 'N/A' %>
                                                                            </td>
                                                                            <td class="text-muted small">
                                                                                <%= g.registrado_por %>
                                                                            </td>

                                                                            <td class="text-end text-danger fw-bold">
                                                                                - <%= empresa.moneda %>
                                                                                    <%= formatCurrency(g.monto, 2) %>
                                                                            </td>

                                                                            <td class="text-center">
                                                                                <% 
                                                                                    const dG = new Date(g.fecha_gasto);
                                                                                    const yG = dG.getFullYear();
                                                                                    const mG = String(dG.getMonth() + 1).padStart(2, '0');
                                                                                    const dD = String(dG.getDate()).padStart(2, '0');
                                                                                    const fechaYMD = `${yG}-${mG}-${dD}`;
                                                                                %>
                                                                                <button type="button" 
                                                                                    class="btn btn-sm btn-outline-primary"
                                                                                    data-bs-toggle="modal" 
                                                                                    data-bs-target="#modalEditarGasto"
                                                                                    data-id="<%= g.id %>"
                                                                                    data-descripcion="<%= g.descripcion %>"
                                                                                    data-fecha="<%= fechaYMD %>"
                                                                                    data-monto="<%= Math.round(g.monto) %>"
                                                                                    data-categoria="<%= g.categoria %>"
                                                                                    data-observacion="<%= g.observacion || '' %>"
                                                                                    title="Editar Gasto">
                                                                                    <i class="bi bi-pencil"></i>
                                                                                </button>
                                                                                <a href="/gastos/eliminar/<%= g.id %>"
                                                                                    class="btn btn-sm btn-outline-danger ms-1"
                                                                                    onclick="return confirm('¿Eliminar este gasto?');"
                                                                                    title="Eliminar Gasto">
                                                                                    <i class="bi bi-trash"></i>
                                                                                </a>
                                                                            </td>
                                                                        </tr>
                                                                        <% }) %>
                                                                            <% } else { %>
                                                                                <tr>
                                                                                    <td colspan="7"
                                                                                        class="text-center py-5 text-muted">
                                                                                        No hay gastos registrados.</td>
                                                                                </tr>
                                                                                <% } %>
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <div class="d-block d-md-none p-2">
                                                        <% if (gastos.length> 0) { %>
                                                            <% gastos.forEach(g=> { %>
                                                                <div class="card border-0 shadow-sm rounded-4 mb-3 p-3 bg-white border-start border-danger border-3">
                                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                                        <span class="small text-muted fw-bold">
                                                                            <%= new Date(g.fecha_gasto).toLocaleDateString() %>
                                                                        </span>
                                                                        <span class="badge bg-secondary"><%= g.categoria %></span>
                                                                    </div>
                                                                    <div class="mb-2">
                                                                        <div class="fw-bold text-dark fs-6"><%= g.descripcion %></div>
                                                                        <% if (g.observacion) { %>
                                                                            <small class="text-muted d-block mt-1 bg-light p-1.5 rounded"><%= g.observacion %></small>
                                                                        <% } %>
                                                                        <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Reg: <%= g.registrado_por %></small>
                                                                    </div>
                                                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                                                        <h6 class="fw-bold text-danger mb-0 font-monospace">
                                                                            - <%= empresa.moneda %> <%= formatCurrency(g.monto, 2) %>
                                                                        </h6>
                                                                        <div>
                                                                            <% 
                                                                                const dG = new Date(g.fecha_gasto);
                                                                                const yG = dG.getFullYear();
                                                                                const mG = String(dG.getMonth() + 1).padStart(2, '0');
                                                                                const dD = String(dG.getDate()).padStart(2, '0');
                                                                                const fechaYMD = `${yG}-${mG}-${dD}`;
                                                                            %>
                                                                            <button type="button" 
                                                                                class="btn btn-sm btn-outline-primary"
                                                                                data-bs-toggle="modal" 
                                                                                data-bs-target="#modalEditarGasto"
                                                                                data-id="<%= g.id %>"
                                                                                data-descripcion="<%= g.descripcion %>"
                                                                                data-fecha="<%= fechaYMD %>"
                                                                                data-monto="<%= Math.round(g.monto) %>"
                                                                                data-categoria="<%= g.categoria %>"
                                                                                data-observacion="<%= g.observacion || '' %>"
                                                                                title="Editar Gasto">
                                                                                <i class="bi bi-pencil"></i>
                                                                            </button>
                                                                            <a href="/gastos/eliminar/<%= g.id %>"
                                                                                class="btn btn-sm btn-outline-danger ms-1"
                                                                                onclick="return confirm('¿Eliminar este gasto?');"
                                                                                title="Eliminar Gasto">
                                                                                <i class="bi bi-trash"></i>
                                                                            </a>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            <% }) %>
                                                        <% } else { %>
                                                            <div class="text-center py-4 text-muted">No hay gastos registrados.</div>
                                                        <% } %>
                                                    </div>

                                                    <% if (totalPages> 1) { %>
                                                        <nav
                                                            class="mt-4 d-flex justify-content-between align-items-center">
                                                            <small class="text-muted">Página <%= currentPage %> de <%=
                                                                        totalPages %></small>
                                                            <ul class="pagination mb-0">
                                                                <li
                                                                    class="page-item <%= currentPage == 1 ? 'disabled' : '' %>">
                                                                    <a class="page-link"
                                                                        href="/gastos?page=<%= currentPage - 1 %>&q=<%= busqueda %>">Anterior</a>
                                                                </li>
                                                                <li
                                                                    class="page-item <%= currentPage == totalPages ? 'disabled' : '' %>">
                                                                    <a class="page-link"
                                                                        href="/gastos?page=<%= currentPage + 1 %>&q=<%= busqueda %>">Siguiente</a>
                                                                </li>
                                                            </ul>
                                                        </nav>
                                                        <% } %>
                                                                                               <!-- ÁREA DE GRÁFICOS DINÁMICOS -->
                                                <div class="row g-3 mt-4 mb-4" id="contenedorGraficosGastos">
                                                    <!-- Gráfico Principal (Evolución o Histórico por filtro) -->
                                                    <div class="col-12 col-lg-6" id="columnaGraficoPrincipal">
                                                        <div class="card card-box p-4 border-0 shadow-sm bg-white rounded-4 h-100">
                                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                                 <h5 class="fw-bold mb-0 text-dark" id="tituloGraficoPrincipal">📈 Evolución Histórica</h5>
                                                                 <span class="badge bg-danger text-white rounded-pill px-3 py-1.5" id="badgeFiltro" style="font-size: 0.75rem;">General</span>
                                                            </div>
                                                            <div style="position: relative; height: 300px; width: 100%;">
                                                                <canvas id="chartGastoDinamicoLine"></canvas>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <!-- Gráfico Secundario (Distribución por Categorías) -->
                                                    <div class="col-12 col-lg-6" id="columnaGraficoSecundario">
                                                        <div class="card card-box p-4 border-0 shadow-sm bg-white rounded-4 h-100">
                                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                                <h5 class="fw-bold mb-0 text-dark" id="tituloGraficoSecundario">📊 Gastos por Categoría</h5>
                                                            </div>
                                                            <div style="position: relative; height: 300px; width: 100%;">
                                                                <canvas id="chartGastoDinamicoCat"></canvas>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Gráfico de Gastos por Mes -->
                                                    <div class="col-12 col-lg-6" id="columnaGraficoMes">
                                                        <div class="card card-box p-4 border-0 shadow-sm bg-white rounded-4 h-100">
                                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                                <h5 class="fw-bold mb-0 text-dark" id="tituloGraficoMes">📅 Gastos por Mes</h5>
                                                            </div>
                                                            <div style="position: relative; height: 300px; width: 100%;">
                                                                <canvas id="chartGastoDinamicoMes"></canvas>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Gráfico de Gastos por Responsable -->
                                                    <div class="col-12 col-lg-6" id="columnaGraficoResponsable">
                                                        <div class="card card-box p-4 border-0 shadow-sm bg-white rounded-4 h-100">
                                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                                <h5 class="fw-bold mb-0 text-dark" id="tituloGraficoResponsable">👤 Gastos por Responsable</h5>
                                                            </div>
                                                            <div style="position: relative; height: 300px; width: 100%;">
                                                                <canvas id="chartGastoDinamicoResponsable"></canvas>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>                       </div>
                            </div>
                    </div>
            </div>
        </div>

        <div class="modal fade" id="modalGasto" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Registrar Nuevo Gasto</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                    </div>
                    <form action="/gastos/guardar" method="POST">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Descripción</label>
                                <input type="text" name="descripcion" class="form-control" required
                                    placeholder="Ej: Pago de luz, Artículos de oficina...">
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-12 mb-3">
                                    <label class="form-label">Fecha</label>
                                    <input type="date" name="fecha_gasto" id="fechaGasto" class="form-control" required>
                                </div>
                                <div class="col-md-4 col-6 mb-3">
                                    <label class="form-label">Monto (<%= empresa.moneda %>)</label>
                                    <input type="text" name="monto" id="montoGasto" class="form-control currency-input"
                                        required placeholder="0">
                                </div>
                                <div class="col-md-4 col-6 mb-3">
                                    <label class="form-label">Categoría</label>
                                        <select name="categoria" class="form-select">
                                            <option value="Servicios">Servicios</option>
                                            <option value="Alquiler">Alquiler</option>
                                            <option value="Sueldos">Sueldos</option>
                                            <option value="Mantenimiento">Mantenimiento</option>
                                            <option value="Carro">Carro</option>
                                            <option value="Tarjeta de Crédito">Tarjeta de Crédito</option>
                                            <option value="Otros">Otros</option>
                                        </select>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Observación (Opcional)</label>
                                <textarea name="observacion" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger">Registrar Salida</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL EDITAR GASTO -->
        <div class="modal fade" id="modalEditarGasto" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">Editar Gasto</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                    </div>
                    <form action="/gastos/editar" method="POST">
                        <input type="hidden" name="id" id="editarGastoId">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Descripción</label>
                                <input type="text" name="descripcion" id="editarDescripcion" class="form-control" required
                                    placeholder="Ej: Pago de luz, Artículos de oficina...">
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-12 mb-3">
                                    <label class="form-label">Fecha</label>
                                    <input type="date" name="fecha_gasto" id="editarFecha" class="form-control" required>
                                </div>
                                <div class="col-md-4 col-6 mb-3">
                                    <label class="form-label">Monto (<%= empresa.moneda %>)</label>
                                    <input type="text" name="monto" id="editarMonto" class="form-control currency-input"
                                        required placeholder="0">
                                </div>
                                <div class="col-md-4 col-6 mb-3">
                                    <label class="form-label">Categoría</label>
                                        <select name="categoria" id="editarCategoria" class="form-select">
                                            <option value="Servicios">Servicios</option>
                                            <option value="Alquiler">Alquiler</option>
                                            <option value="Sueldos">Sueldos</option>
                                            <option value="Mantenimiento">Mantenimiento</option>
                                            <option value="Carro">Carro</option>
                                            <option value="Tarjeta de Crédito">Tarjeta de Crédito</option>
                                            <option value="Otros">Otros</option>
                                        </select>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Observación (Opcional)</label>
                                <textarea name="observacion" id="editarObservacion" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Incluir Chart.js desde CDN -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <%- include('../partials/footer') %>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    // Inicializar máscaras de miles globales
                    window.applyCurrencyMask('.currency-input');

                    // Lógica de fecha por defecto para creación
                    const fechaInput = document.getElementById('fechaGasto');
                    if (fechaInput && !fechaInput.value) {
                        const hoy = new Date();
                        const yyyy = hoy.getFullYear();
                        const mm = String(hoy.getMonth() + 1).padStart(2, '0');
                        const dd = String(hoy.getDate()).padStart(2, '0');
                        fechaInput.value = `${yyyy}-${mm}-${dd}`;
                    }

                    // Limpiar máscara antes de enviar formulario de creación
                    const formCrear = document.querySelector('form[action="/gastos/guardar"]');
                    if (formCrear) {
                        formCrear.addEventListener('submit', function () {
                            const input = document.getElementById('montoGasto');
                            input.value = input.value.replace(/\D/g, '');
                        });
                    }

                    // Lógica para rellenar el modal de edición
                    const modalEditar = document.getElementById('modalEditarGasto');
                    if (modalEditar) {
                        modalEditar.addEventListener('show.bs.modal', function (event) {
                            const button = event.relatedTarget;
                            const id = button.getAttribute('data-id');
                            const descripcion = button.getAttribute('data-descripcion');
                            const fecha = button.getAttribute('data-fecha');
                            const monto = button.getAttribute('data-monto');
                            const categoria = button.getAttribute('data-categoria');
                            const observacion = button.getAttribute('data-observacion');

                            modalEditar.querySelector('#editarGastoId').value = id;
                            modalEditar.querySelector('#editarDescripcion').value = descripcion;
                            modalEditar.querySelector('#editarFecha').value = fecha;
                            
                            const inputMonto = modalEditar.querySelector('#editarMonto');
                            inputMonto.value = monto;
                            // Forzar actualización de la máscara en tiempo real
                            inputMonto.dispatchEvent(new Event('input'));

                            modalEditar.querySelector('#editarCategoria').value = categoria;
                            modalEditar.querySelector('#editarObservacion').value = observacion;
                        });
                    }

                    // Limpiar máscara antes de enviar formulario de edición
                    const formEditar = document.querySelector('form[action="/gastos/editar"]');
                    if (formEditar) {
                        formEditar.addEventListener('submit', function () {
                            const input = document.getElementById('editarMonto');
                            input.value = input.value.replace(/\D/g, '');
                        });
                    }

                    // ==========================================
                    // LÓGICA DE GRÁFICOS DINÁMICOS Y RESPONSIVOS
                    // ==========================================
                    const todosLosGastos = <%- typeof todosLosGastosFiltrados !== 'undefined' ? JSON.stringify(todosLosGastosFiltrados) : '[]' %>;
                    const busquedaActual = "<%= busqueda %>".trim();
                    const moneda = "<%= empresa.moneda %>";

                    if (!todosLosGastos || todosLosGastos.length === 0) {
                        // Si no hay gastos, ocultamos o mostramos empty state
                        const cont = document.getElementById('contenedorGraficosGastos');
                        if (cont) {
                            cont.innerHTML = `
                                <div class="col-12">
                                    <div class="card card-box p-5 border-0 shadow-sm bg-white rounded-4 text-center">
                                        <i class="bi bi-bar-chart text-muted opacity-50" style="font-size: 3rem;"></i>
                                        <h5 class="mt-3 text-muted">No hay datos suficientes para graficar</h5>
                                        <p class="text-muted small">Registra salidas de gastos para ver reportes visuales.</p>
                                    </div>
                                </div>
                            `;
                        }
                        return;
                    }

                    // Categorías válidas en minúscula para comparación robusta
                    const categoriasValidas = ["servicios", "alquiler", "sueldos", "mantenimiento", "carro", "tarjeta de crédito", "otros"];
                    const esFiltroCategoria = categoriasValidas.includes(busquedaActual.toLowerCase());

                    // Configurar elementos del DOM para responsividad en filtros
                    const tituloPrincipalEl = document.getElementById('tituloGraficoPrincipal');
                    const badgeFiltroEl = document.getElementById('badgeFiltro');
                    const colPrincipalEl = document.getElementById('columnaGraficoPrincipal');
                    const colSecundarioEl = document.getElementById('columnaGraficoSecundario');
                    const tituloSecundarioEl = document.getElementById('tituloGraficoSecundario');

                    if (busquedaActual) {
                        badgeFiltroEl.innerText = "Filtrado";
                        badgeFiltroEl.className = "badge bg-warning text-dark rounded-pill px-3 py-1.5";
                        if (esFiltroCategoria) {
                            tituloPrincipalEl.innerText = `📈 Evolución de ${busquedaActual}`;
                            tituloSecundarioEl.innerText = `📊 Desglose de: ${busquedaActual}`;
                        } else {
                            tituloPrincipalEl.innerText = `📈 Histórico: "${busquedaActual}"`;
                            // Ocultamos el secundario y expandimos el principal si es un filtro de texto libre (ej: "Luz")
                            if (colSecundarioEl) colSecundarioEl.style.display = 'none';
                            if (colPrincipalEl) {
                                colPrincipalEl.className = 'col-12';
                            }
                        }
                    } else {
                        badgeFiltroEl.innerText = "General";
                        badgeFiltroEl.className = "badge bg-danger text-white rounded-pill px-3 py-1.5";
                        tituloPrincipalEl.innerText = "📈 Evolución Histórica de Gastos";
                        tituloSecundarioEl.innerText = "📊 Gastos por Categoría";
                    }

                    // ==========================================
                    // 1. GRÁFICO PRINCIPAL: EVOLUCIÓN HISTÓRICA (LÍNEA)
                    // ==========================================
                    const gastosPorFecha = {};
                    todosLosGastos.forEach(g => {
                        const fecha = new Date(g.fecha_gasto).toLocaleDateString('es-CO', { timeZone: 'UTC' });
                        gastosPorFecha[fecha] = (gastosPorFecha[fecha] || 0) + parseFloat(g.monto);
                    });

                    const labelsLine = Object.keys(gastosPorFecha);
                    const dataLine = Object.values(gastosPorFecha);

                    const ctxLine = document.getElementById('chartGastoDinamicoLine').getContext('2d');
                    new Chart(ctxLine, {
                        type: 'line',
                        data: {
                            labels: labelsLine,
                            datasets: [{
                                label: `Total Gastos (${moneda})`,
                                data: dataLine,
                                borderColor: '#ef4444',
                                backgroundColor: 'rgba(239, 68, 68, 0.1)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 3,
                                pointBackgroundColor: '#ef4444',
                                pointHoverRadius: 7
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return ` Gastado: ${moneda} ${window.formatCurrency(context.raw, 2)}`;
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(value) {
                                            return moneda + ' ' + window.formatCurrency(value, 0);
                                        }
                                    }
                                }
                            }
                        }
                    });

                    // ==========================================
                    // 2. GRÁFICO SECUNDARIO: DISTRIBUCIÓN POR CATEGORÍAS (DONA)
                    // ==========================================
                    if (!busquedaActual || esFiltroCategoria) {
                        const ctxCat = document.getElementById('chartGastoDinamicoCat').getContext('2d');
                        
                        let labelsCat = [];
                        let dataCat = [];
                        let bgColors = ['#ef4444', '#f97316', '#eab308', '#10b981', '#06b6d4', '#6366f1', '#a855f7'];

                        if (esFiltroCategoria) {
                            // Si es categoría, agrupamos por DESCRIPCIÓN dentro de esa categoría
                            const gastosPorDesc = {};
                            todosLosGastos.forEach(g => {
                                const desc = g.descripcion || 'Otros';
                                gastosPorDesc[desc] = (gastosPorDesc[desc] || 0) + parseFloat(g.monto);
                            });
                            labelsCat = Object.keys(gastosPorDesc);
                            dataCat = Object.values(gastosPorDesc);
                        } else {
                            // Agrupamos por CATEGORÍA general
                            const gastosPorCat = {};
                            todosLosGastos.forEach(g => {
                                const cat = g.categoria || 'Otros';
                                gastosPorCat[cat] = (gastosPorCat[cat] || 0) + parseFloat(g.monto);
                            });
                            labelsCat = Object.keys(gastosPorCat);
                            dataCat = Object.values(gastosPorCat);
                        }

                        new Chart(ctxCat, {
                            type: 'doughnut',
                            data: {
                                labels: labelsCat,
                                datasets: [{
                                    data: dataCat,
                                    backgroundColor: bgColors.slice(0, labelsCat.length),
                                    borderWidth: 2,
                                    borderColor: '#ffffff'
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: {
                                        position: 'bottom',
                                        labels: { boxWidth: 12, padding: 15 }
                                    },
                                    tooltip: {
                                        callbacks: {
                                            label: function(context) {
                                                return ` Total: ${moneda} ${window.formatCurrency(context.raw, 2)}`;
                                            }
                                        }
                                    }
                                }
                            }
                        });
                    } else {
                        // Si se ocultó el gráfico de categorías por filtro libre, ocultamos también su columna contenedor
                        if (colSecundarioEl) colSecundarioEl.style.display = 'none';
                    }

                    // ==========================================
                    // 3. NUEVO GRÁFICO: GASTOS POR MES (BARRAS VERTICALES)
                    // ==========================================
                    const gastosPorMes = {};
                    todosLosGastos.forEach(g => {
                        const fecha = new Date(g.fecha_gasto);
                        const yyyy = fecha.getUTCFullYear();
                        const mm = String(fecha.getUTCMonth() + 1).padStart(2, '0');
                        const key = `${yyyy}-${mm}`;
                        
                        // Obtener nombre del mes legible y año (Ej: Jun 2026)
                        const nombreMes = fecha.toLocaleDateString('es-CO', { month: 'short', year: 'numeric', timeZone: 'UTC' });
                        const label = nombreMes.charAt(0).toUpperCase() + nombreMes.slice(1);
                        
                        if (!gastosPorMes[key]) {
                            gastosPorMes[key] = { label, total: 0 };
                        }
                        gastosPorMes[key].total += parseFloat(g.monto);
                    });

                    // Ordenar cronológicamente por la clave YYYY-MM
                    const keysOrdenadas = Object.keys(gastosPorMes).sort();
                    const labelsMes = keysOrdenadas.map(k => gastosPorMes[k].label);
                    const dataMes = keysOrdenadas.map(k => gastosPorMes[k].total);

                    const ctxMes = document.getElementById('chartGastoDinamicoMes').getContext('2d');
                    new Chart(ctxMes, {
                        type: 'bar',
                        data: {
                            labels: labelsMes,
                            datasets: [{
                                label: `Gastado por Mes (${moneda})`,
                                data: dataMes,
                                backgroundColor: 'rgba(99, 102, 241, 0.75)', // Índigo elegante
                                borderColor: '#6366f1',
                                borderWidth: 1.5,
                                borderRadius: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return ` Total Mes: ${moneda} ${window.formatCurrency(context.raw, 2)}`;
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(value) {
                                            return moneda + ' ' + window.formatCurrency(value, 0);
                                        }
                                    }
                                }
                            }
                        }
                    });

                    // ==========================================
                    // 4. NUEVO GRÁFICO: GASTOS POR RESPONSABLE (BARRAS HORIZONTALES)
                    // ==========================================
                    const gastosPorResponsable = {};
                    todosLosGastos.forEach(g => {
                        const resp = g.registrado_por || 'Administrador';
                        gastosPorResponsable[resp] = (gastosPorResponsable[resp] || 0) + parseFloat(g.monto);
                    });

                    // Ordenar de mayor a menor gasto para visualizar jerarquía
                    const sortedResponsables = Object.entries(gastosPorResponsable)
                        .sort((a, b) => b[1] - a[1]);

                    const labelsResp = sortedResponsables.map(entry => entry[0]);
                    const dataResp = sortedResponsables.map(entry => entry[1]);

                    // Paleta de colores para múltiples barras o color sólido esmeralda
                    const ctxResp = document.getElementById('chartGastoDinamicoResponsable').getContext('2d');
                    new Chart(ctxResp, {
                        type: 'bar',
                        data: {
                            labels: labelsResp,
                            datasets: [{
                                label: `Total Registrado (${moneda})`,
                                data: dataResp,
                                backgroundColor: 'rgba(16, 185, 129, 0.75)', // Esmeralda premium
                                borderColor: '#10b981',
                                borderWidth: 1.5,
                                borderRadius: 6
                            }]
                        },
                        options: {
                            indexAxis: 'y', // Convertir a barras horizontales
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return ` Registrado: ${moneda} ${window.formatCurrency(context.raw, 2)}`;
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(value) {
                                            return moneda + ' ' + window.formatCurrency(value, 0);
                                        }
                                    }
                                }
                            }
                        }
                    });
                });
            </script>

