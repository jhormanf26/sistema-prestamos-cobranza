<%- include('../partials/head') %>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-6 text-center">
                <div class="card shadow-lg border-0 rounded-4 p-5">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="fw-bold text-dark mb-3">Acceso Restringido</h1>
                    <p class="text-muted mb-4 fs-5">
                        Has realizado demasiadas peticiones en poco tiempo. Por seguridad, hemos limitado temporalmente el acceso desde tu IP.
                    </p>
                    
                    <div class="alert alert-warning border-0 rounded-3 mb-4">
                        <i class="bi bi-clock-history me-2"></i>
                        Podrás intentar de nuevo en aproximadamente 15 minutos.
                    </div>

                    <div class="d-grid">
                        <a href="/" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm">
                            <i class="bi bi-arrow-clockwise me-2"></i> Reintentar ahora
                        </a>
                    </div>
                </div>
                <p class="mt-4 text-muted small">&copy; <%= new Date().getFullYear() %> Sistema de Préstamos y Cobranza</p>
            </div>
        </div>
    </div>
</body>
<%- include('../partials/footer') %>
