<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>

    <body>
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <%- include('../partials/sidebar') %>

                    <div class="col py-0 py-md-3 main-content-wrapper">
                        <%- include('../partials/mobile-header') %>
                            <div class="container-fluid px-4 py-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h2>🐖 Cuentas de Ahorro</h2>
                                    <a href="/ahorros/aperturar" class="btn btn-primary">
                                        <i class="bi bi-plus-circle"></i> Aperturar Cuenta
                                    </a>
                                </div>

                                <% if(mensajeExito && mensajeExito.length> 0) { %>
                                    <div class="d-none" id="flashMessageSuccess">
                                        <%= mensajeExito %>
                                    </div>
                                    <% } %>

                                        <div class="card card-box p-3">
                                            <div class="table-responsive d-none d-md-block">
                                                <table class="table table-hover align-middle">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>ID Cuenta</th>
                                                            <th>Titular</th>
                                                            <th>CC</th>
                                                            <th class="text-end">Saldo Disponible</th>
                                                            <th class="text-center" style="width: 250px;">Meta de Ahorro</th>
                                                            <th>Acciones</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if (cuentas.length> 0) { %>
                                                            <% cuentas.forEach(c=> { %>
                                                                <tr>
                                                                    <td><span class="badge bg-secondary">#<%= c.id %>
                                                                                </span></td>
                                                                    <td class="fw-bold">
                                                                        <%= c.nombre %>
                                                                            <%= c.apellido %>
                                                                    </td>
                                                                    <td>
                                                                        <%= c.dni %>
                                                                    </td>
                                                                    <td class="text-end fw-bold text-success fs-5">
                                                                        <%= empresa.moneda %>
                                                                            <%= formatCurrency(c.saldo_actual, 2) %>
                                                                    </td>
                                                                    <td class="text-center">
                                                                        <% if (c.meta_monto > 0) { 
                                                                            let porc = Math.min((c.saldo_actual / c.meta_monto) * 100, 100).toFixed(0);
                                                                            let colorClass = porc == 100 ? 'bg-success' : 'bg-primary';
                                                                        %>
                                                                            <div class="small mb-1 d-flex justify-content-between">
                                                                                <span class="text-truncate" style="max-width: 150px;"><%= c.meta_nombre || 'Meta' %></span>
                                                                                <span class="fw-bold"><%= porc %>%</span>
                                                                            </div>
                                                                            <div class="progress" style="height: 8px;">
                                                                                <div class="progress-bar <%= colorClass %>" role="progressbar" style="width: <%= porc %>%"></div>
                                                                            </div>
                                                                            <small class="text-muted" style="font-size: 0.7rem;">
                                                                                Meta: <%= empresa.moneda %> <%= formatCurrency(c.meta_monto, 0) %>
                                                                            </small>
                                                                        <% } else { %>
                                                                            <span class="text-muted small">Sin meta definida</span>
                                                                        <% } %>
                                                                    </td>
                                                                    <td>
                                                                        <div class="d-flex gap-1 justify-content-start">
                                                                            <a href="/ahorros/ver/<%= c.id %>"
                                                                                class="btn btn-sm btn-outline-primary">
                                                                                <i class="bi bi-arrow-left-right"></i>
                                                                                Operaciones
                                                                            </a>
                                                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-editar-meta" 
                                                                                    data-id="<%= c.id %>" 
                                                                                    data-nombre="<%= c.meta_nombre || '' %>" 
                                                                                    data-monto="<%= c.meta_monto ? formatCurrency(c.meta_monto, 0) : '' %>"
                                                                                    data-titular="<%= c.nombre %> <%= c.apellido %>"
                                                                                    data-bs-toggle="modal" 
                                                                                    data-bs-target="#modalEditarMeta"
                                                                                    title="Configurar Meta de Ahorro">
                                                                                <i class="bi bi-pencil-square text-secondary"></i>
                                                                                Meta
                                                                            </button>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                                <% }) %>
                                                                    <% } else { %>
                                                                        <tr>
                                                                            <td colspan="5" class="text-center py-5">No
                                                                                hay cuentas de ahorro activas.</td>
                                                                        </tr>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="d-block d-md-none p-2">
                                                <% if (cuentas.length> 0) { %>
                                                    <% cuentas.forEach(c=> { %>
                                                        <div class="card border-0 shadow-sm rounded-4 mb-3 p-3 bg-white border-start border-success border-3">
                                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                                <span class="badge bg-secondary">#<%= c.id %></span>
                                                                <span class="text-muted small"><%= c.dni %></span>
                                                            </div>
                                                            <div class="mb-2">
                                                                <div class="fw-bold text-dark fs-6"><%= c.nombre %> <%= c.apellido %></div>
                                                            </div>
                                                            
                                                            <div class="my-3 p-2 bg-light rounded-3">
                                                                <% if (c.meta_monto > 0) { 
                                                                    let porc = Math.min((c.saldo_actual / c.meta_monto) * 100, 100).toFixed(0);
                                                                    let colorClass = porc == 100 ? 'bg-success' : 'bg-primary';
                                                                %>
                                                                    <div class="small mb-1 d-flex justify-content-between">
                                                                        <span class="text-truncate fw-bold" style="max-width: 150px;"><%= c.meta_nombre || 'Meta' %></span>
                                                                        <span class="fw-bold text-primary"><%= porc %>%</span>
                                                                    </div>
                                                                    <div class="progress mb-1" style="height: 6px;">
                                                                        <div class="progress-bar <%= colorClass %>" role="progressbar" style="width: <%= porc %>%"></div>
                                                                    </div>
                                                                    <small class="text-muted" style="font-size: 0.75rem;">
                                                                        Meta: <%= empresa.moneda %> <%= formatCurrency(c.meta_monto, 0) %>
                                                                    </small>
                                                                <% } else { %>
                                                                    <span class="text-muted small"><i class="bi bi-info-circle"></i> Sin meta de ahorro definida</span>
                                                                <% } %>
                                                            </div>

                                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                                                <div>
                                                                    <span class="text-muted small d-block">Saldo Disponible</span>
                                                                    <span class="fw-bold text-success font-monospace">
                                                                        <%= empresa.moneda %> <%= formatCurrency(c.saldo_actual, 2) %>
                                                                    </span>
                                                                </div>
                                                                <div class="d-flex gap-1">
                                                                    <a href="/ahorros/ver/<%= c.id %>"
                                                                        class="btn btn-sm btn-outline-primary">
                                                                        <i class="bi bi-arrow-left-right"></i>
                                                                    </a>
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-editar-meta" 
                                                                            data-id="<%= c.id %>" 
                                                                            data-nombre="<%= c.meta_nombre || '' %>" 
                                                                            data-monto="<%= c.meta_monto ? formatCurrency(c.meta_monto, 0) : '' %>"
                                                                            data-titular="<%= c.nombre %> <%= c.apellido %>"
                                                                            data-bs-toggle="modal" 
                                                                            data-bs-target="#modalEditarMeta"
                                                                            title="Configurar Meta de Ahorro">
                                                                        <i class="bi bi-pencil-square text-secondary"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    <% }) %>
                                                <% } else { %>
                                                    <div class="text-center py-4 text-muted">No hay cuentas de ahorro activas.</div>
                                                <% } %>
                                            </div>
                                        </div>
                            </div>
                    </div>
            </div>
        </div>

        <!-- Modal para Editar Meta de Ahorro -->
        <div class="modal fade" id="modalEditarMeta" tabindex="-1" aria-labelledby="modalEditarMetaLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4">
                    <div class="modal-header bg-primary text-white rounded-top-4 py-3">
                        <h5 class="modal-title fw-bold" id="modalEditarMetaLabel">🎯 Configurar Meta de Ahorro</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="formEditarMeta" action="" method="POST">
                        <div class="modal-body p-4">
                            <p class="text-muted small">Define o modifica los objetivos de ahorro para el titular <strong id="metaTitular" class="text-dark"></strong>.</p>
                            
                            <div class="mb-3">
                                <label for="meta_nombre" class="form-label fw-semibold">Nombre de la Meta</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-tag text-primary"></i></span>
                                    <input type="text" class="form-control" id="meta_nombre" name="meta_nombre" placeholder="Ej. Comprar Moto, Viaje, Estudios..." max="50">
                                </div>
                                <small class="text-muted">¿Para qué está ahorrando el cliente?</small>
                            </div>

                            <div class="mb-3">
                                <label for="meta_monto" class="form-label fw-semibold">Monto Objetivo</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light fw-bold"><%= empresa.moneda %></span>
                                    <input type="text" class="form-control input-miles" id="meta_monto" name="meta_monto" placeholder="0">
                                </div>
                                <small class="text-muted">Monto total que desea alcanzar. Dejar vacío o en 0 para eliminar la meta.</small>
                            </div>
                        </div>
                        <div class="modal-footer bg-light border-0 p-3 rounded-bottom-4">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function() {
                const botonesEditar = document.querySelectorAll(".btn-editar-meta");
                const form = document.getElementById("formEditarMeta");
                const inputNombre = document.getElementById("meta_nombre");
                const inputMonto = document.getElementById("meta_monto");
                const txtTitular = document.getElementById("metaTitular");

                botonesEditar.forEach(btn => {
                    btn.addEventListener("click", function() {
                        const id = this.getAttribute("data-id");
                        const nombre = this.getAttribute("data-nombre");
                        const monto = this.getAttribute("data-monto");
                        const titular = this.getAttribute("data-titular");

                        form.action = `/ahorros/meta/${id}`;
                        inputNombre.value = nombre;
                        inputMonto.value = monto;
                        txtTitular.textContent = titular;
                    });
                });

                // Aplicar máscara de miles en tiempo real al input de meta_monto (separador de miles con punto)
                if (inputMonto) {
                    inputMonto.addEventListener("input", function(e) {
                        let valor = this.value.replace(/\D/g, "");
                        if (valor !== "") {
                            this.value = parseInt(valor, 10).toLocaleString("es-CO");
                        } else {
                            this.value = "";
                        }
                    });
                }
            });
        </script>

        <%- include('../partials/footer') %>
