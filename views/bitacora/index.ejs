<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>

    <body>
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <%- include('../partials/sidebar') %>

                    <div class="col py-0 py-md-3 main-content-wrapper">
                        <%- include('../partials/mobile-header') %>
                            <div class="container-fluid px-4 py-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h2>🛡️ Bitácora de Auditoría</h2>
                                    <span class="badge bg-secondary">Últimos 100 movimientos</span>
                                </div>

                                <div class="alert alert-primary d-flex align-items-center mb-4" role="alert">
                                    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                    <div>
                                        <strong>¿Qué monitorea este sistema?</strong>
                                        <ul class="mb-0 small" style="list-style-type: none; padding-left: 0;">
                                            <li><i class="bi bi-check2"></i> <strong>Préstamos:</strong> Creación de
                                                nuevos créditos.</li>
                                            <li><i class="bi bi-check2"></i> <strong>Cobranza:</strong> Registro de
                                                pagos y liquidaciones.</li>
                                            <li><i class="bi bi-check2"></i> <strong>Caja:</strong> Registro de gastos
                                                operativos y salidas de dinero.</li>
                                            <li><i class="bi bi-check2"></i> <strong>Seguridad:</strong> Eliminación de
                                                registros sensibles.</li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="card card-box p-0 border-0 shadow-sm">
                                    <div class="table-responsive d-none d-md-block">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Fecha / Hora</th>
                                                    <th>Usuario</th>
                                                    <th>Acción</th>
                                                    <th>Detalle</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (registros && registros.length> 0) { %>
                                                    <% registros.forEach(reg=> { %>
                                                        <tr>
                                                            <td class="small text-muted" style="white-space: nowrap;">
                                                                <i class="bi bi-clock me-1"></i>
                                                                <% let fechaMostrar=reg.fecha || reg.created_at; let
                                                                    fechaTexto=fechaMostrar ? new
                                                                    Date(fechaMostrar).toLocaleString() : '---' ; %>
                                                                    <%= fechaTexto %>
                                                            </td>
                                                            <td>
                                                                <div class="fw-bold">
                                                                    <i class="bi bi-person-circle me-1"></i>
                                                                    <%= reg.usuario || 'Sistema' %>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <% let badgeClass='bg-secondary' ; let accion=reg.accion
                                                                    || 'INFO' ; if(accion.includes('REGISTRAR') ||
                                                                    accion.includes('CREAR') ||
                                                                    accion.includes('NUEVO')) badgeClass='bg-success' ;
                                                                    if(accion.includes('ELIMINAR'))
                                                                    badgeClass='bg-danger' ;
                                                                    if(accion.includes('EDITAR'))
                                                                    badgeClass='bg-warning text-dark' ; %>
                                                                    <span class="badge <%= badgeClass %>">
                                                                        <%= accion %>
                                                                    </span>
                                                            </td>
                                                            <td class="text-secondary small">
                                                                <%= reg.detalle || '-' %>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <tr>
                                                                    <td colspan="4" class="text-center py-5">
                                                                        <i
                                                                            class="bi bi-shield-check fs-1 text-muted opacity-50"></i>
                                                                        <p class="mt-2 text-muted">No hay registros de
                                                                            actividad recientes.</p>
                                                                    </td>
                                                                </tr>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="d-block d-md-none p-3">
                                        <% if (registros && registros.length> 0) { %>
                                            <% registros.forEach(reg=> { %>
                                                <% 
                                                    let borderClass = 'border-secondary';
                                                    let badgeClass='bg-secondary';
                                                    let accion=reg.accion || 'INFO';
                                                    if(accion.includes('REGISTRAR') || accion.includes('CREAR') || accion.includes('NUEVO')) {
                                                        borderClass='border-success';
                                                        badgeClass='bg-success';
                                                    }
                                                    if(accion.includes('ELIMINAR')) {
                                                        borderClass='border-danger';
                                                        badgeClass='bg-danger';
                                                    }
                                                    if(accion.includes('EDITAR')) {
                                                        borderClass='border-warning';
                                                        badgeClass='bg-warning text-dark';
                                                    }
                                                    let fechaMostrar=reg.fecha || reg.created_at;
                                                    let fechaTexto=fechaMostrar ? new Date(fechaMostrar).toLocaleString() : '---';
                                                %>
                                                <div class="card border-0 shadow-sm rounded-4 mb-3 p-3 bg-white border-start border-3 <%= borderClass %>">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="small text-muted font-monospace"><i class="bi bi-clock me-1"></i><%= fechaTexto %></span>
                                                        <span class="badge <%= badgeClass %>"><%= accion %></span>
                                                    </div>
                                                    <div class="mb-1">
                                                        <div class="fw-bold text-dark"><i class="bi bi-person-circle me-1 text-muted"></i><%= reg.usuario || 'Sistema' %></div>
                                                    </div>
                                                    <div class="mt-2 pt-2 border-top">
                                                        <p class="text-secondary small mb-0"><%= reg.detalle || '-' %></p>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <div class="text-center py-4 text-muted">No hay registros de actividad recientes.</div>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="mt-3 text-end text-muted small">
                                    <i class="bi bi-lock"></i> Registro inmutable de seguridad.
                                </div>

                            </div>
                    </div>
            </div>
        </div>
        <%- include('../partials/footer') %>