<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <%- include('../partials/sidebar') %>
            
            <div class="col py-0 py-md-3 main-content-wrapper">
                <%- include('../partials/mobile-header') %>
    <div class="container-fluid p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">👥 Visitantes Únicos</h2>
                <div class="btn-group mt-2" role="group">
                    <a href="/promocion/detalle?vista=eventos" class="btn btn-sm btn-outline-primary">Historial de Eventos</a>
                    <a href="/promocion/detalle?vista=visitantes" class="btn btn-sm btn-primary active">Agrupar por Visitantes</a>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/promocion/exportar" class="btn btn-success rounded-pill px-3">
                    <i class="bi bi-file-earmark-excel me-1"></i> Exportar Reporte
                </a>
                <a href="/" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Identidad / Dispositivo</th>
                                <th>Última Actividad</th>
                                <th>Ubicación Detectada</th>
                                <th>Estado / Interés</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% visitantes.forEach(v => { 
                                const geo = v.geo ? (typeof v.geo === 'string' ? JSON.parse(v.geo) : v.geo) : {};
                            %>
                                <tr class="<%= v.isHot ? 'table-warning' : '' %>">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm <%= v.isHot ? 'bg-warning text-dark' : 'bg-light text-primary' %> rounded-circle p-2 me-3 text-center" style="width: 40px; height: 40px;">
                                                <i class="bi <%= v.nombre_cliente ? 'bi-person-check-fill' : (v.isHot ? 'bi-fire' : 'bi-person-fill') %>"></i>
                                            </div>
                                            <div>
                                                <% if(v.nombre_cliente) { %>
                                                    <span class="fw-bold d-block text-primary"><%= v.nombre_cliente %></span>
                                                    <a href="https://wa.me/<%= v.telefono_cliente %>" target="_blank" class="text-decoration-none small text-success">
                                                        <i class="bi bi-whatsapp me-1"></i><%= v.telefono_cliente %>
                                                    </a>
                                                <% } else { %>
                                                    <span class="fw-bold d-block"><%= v.visitorId ? v.visitorId.substring(0, 15) + '...' : 'ID Desconocido' %></span>
                                                    <small class="text-muted"><%= v.ip %></small>
                                                    <% if(v.procedencia && v.procedencia !== 'null') { %>
                                                        <div class="mt-1">
                                                            <span class="badge bg-light text-dark border p-1 px-2" style="font-size: 0.65rem;">
                                                                <i class="bi bi-link-45deg"></i> <%= v.procedencia %>
                                                            </span>
                                                        </div>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="d-block"><%= new Date(v.ultima_actividad).toLocaleDateString() %></span>
                                        <small class="text-muted"><%= new Date(v.ultima_actividad).toLocaleTimeString() %></small>
                                    </td>
                                    <td>
                                        <% if(geo.ciudad) { %>
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                            <%= geo.ciudad %>, <%= geo.pais %>
                                        <% } else { %>
                                            <span class="text-muted small">No disponible</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if(v.nombre_cliente) { %>
                                            <span class="badge bg-success shadow-sm">
                                                <i class="bi bi-patch-check-fill me-1"></i> Lead Capturado
                                            </span>
                                        <% } else if(v.isHot) { %>
                                            <span class="badge bg-warning text-dark shadow-sm">
                                                <i class="bi bi-star-fill me-1"></i> Prospecto Caliente
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-light text-dark border">
                                                <%= v.total_eventos %> eventos
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="/promocion/visitante/<%= v.visitorId %>" class="btn btn-sm btn-primary rounded-pill">
                                            <i class="bi bi-clock-history me-1"></i> Ver Detalles
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

                </div> <!-- Fin container-fluid -->
            </div> <!-- Fin col -->
        </div> <!-- Fin row -->
    </div> <!-- Fin container-fluid general -->
</body>

<style>
    .avatar-sm { display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
    .table-warning { background-color: rgba(255, 193, 7, 0.05) !important; }
</style>

<%- include('../partials/footer') %>
