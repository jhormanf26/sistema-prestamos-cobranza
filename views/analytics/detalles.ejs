<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <%- include('../partials/sidebar') %>
            
            <div class="col py-0 py-md-3 main-content-wrapper">
                <%- include('../partials/mobile-header') %>
    <div class="container-fluid p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">🔍 Detalle de Analítica Web</h2>
                <div class="btn-group mt-2" role="group">
                    <a href="/promocion/detalle?vista=eventos" class="btn btn-sm btn-primary active">Historial de Eventos</a>
                    <a href="/promocion/detalle?vista=visitantes" class="btn btn-sm btn-outline-primary">Agrupar por Visitantes</a>
                </div>
            </div>
            <a href="/" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Fecha / Hora</th>
                                <th>Evento</th>
                                <th>Procedencia</th>
                                <th>Ubicación (Ciudad/País)</th>
                                <th>Dispositivo / Conexión</th>
                                <th>IP</th>
                                <th class="text-end pe-4">Detalles Técnicos</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% eventos.forEach(e => { 
                                let d = {};
                                try {
                                    if (typeof e.data === 'string' && e.data !== '[object Object]') {
                                        d = JSON.parse(e.data);
                                    } else if (typeof e.data === 'object' && e.data !== null) {
                                        d = e.data;
                                    }
                                } catch (err) {
                                    console.error('Error al procesar datos del evento:', err);
                                    d = {};
                                }
                                const geo = d.geo || {};
                            %>
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-bold d-block"><%= new Date(e.created_at).toLocaleDateString() %></span>
                                        <small class="text-muted"><%= new Date(e.created_at).toLocaleTimeString() %></small>
                                    </td>
                                    <td>
                                        <% if(e.evento === 'visita') { %>
                                            <span class="badge bg-primary bg-opacity-10 text-primary">NUEVA VISITA</span>
                                        <% } else if(e.evento === 'click_solicitar') { %>
                                            <span class="badge bg-success">SOLICITUD</span>
                                        <% } else if(e.evento.startsWith('scroll')) { %>
                                            <span class="badge bg-info bg-opacity-10 text-info">Lectura <%= e.evento.split('_')[1] %>%</span>
                                        <% } else if(e.evento === 'tiempo_permanencia') { %>
                                            <span class="badge bg-warning bg-opacity-10 text-warning text-dark">Duro <%= d.segundos %>s</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary"><%= e.evento %></span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if(e.procedencia && e.procedencia !== 'null') { %>
                                            <% if(e.procedencia.toLowerCase().includes('whatsapp')) { %>
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                    <i class="bi bi-whatsapp me-1"></i> WhatsApp
                                                </span>
                                            <% } else if(e.procedencia.toLowerCase().includes('facebook')) { %>
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                                    <i class="bi bi-facebook me-1"></i> Facebook
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                                    <i class="bi bi-link-45deg me-1"></i> <%= e.procedencia %>
                                                </span>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-muted small">Directo</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if(geo.ciudad) { %>
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                            <%= geo.ciudad %>, <%= geo.pais %>
                                            <br><small class="text-muted"><%= geo.region %></small>
                                        <% } else { %>
                                            <span class="text-muted italic">No disponible</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% 
                                            let deviceType = "Computador";
                                            let deviceIcon = "bi-laptop";
                                            let os = "Desconocido";
                                            let osIcon = "bi-question-circle";

                                            // 1. Detección por Pantalla
                                            if (d.screen) {
                                                const width = parseInt(d.screen.split('x')[0]);
                                                if (width < 600) { deviceType = "Smartphone"; deviceIcon = "bi-phone"; }
                                                else if (width < 1024) { deviceType = "Tablet"; deviceIcon = "bi-tablet"; }
                                            }

                                            // 2. Detección simplificada de SO
                                            const ua = (e.user_agent || "").toLowerCase();
                                            if (ua.includes('android')) { os = "Android"; osIcon = "bi-android2"; }
                                            else if (ua.includes('iphone') || ua.includes('ipad')) { os = "iOS"; osIcon = "bi-apple"; }
                                            else if (ua.includes('windows')) { os = "Windows"; osIcon = "bi-windows"; }
                                            else if (ua.includes('macintosh')) { os = "macOS"; osIcon = "bi-apple"; }
                                            else if (ua.includes('linux')) { os = "Linux"; osIcon = "bi-ubuntu"; }
                                        %>
                                        <div class="d-flex flex-column gap-1">
                                            <span class="badge bg-dark bg-opacity-10 text-dark text-start border-0 p-0 d-flex align-items-center">
                                                <i class="bi <%= deviceIcon %> me-2 text-primary"></i> <%= deviceType %> 
                                                <small class="ms-1 text-muted">(<%= d.screen || 'N/A' %>)</small>
                                            </span>
                                            <span class="badge bg-light text-muted text-start border-0 p-0 d-flex align-items-center">
                                                <i class="bi <%= osIcon %> me-2"></i> <%= os %>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <code><%= e.ip %></code>
                                        <% if(geo.proveedor) { %>
                                            <br><small class="text-muted" style="font-size: 0.7rem;"><%= geo.proveedor %></small>
                                        <% } %>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-light border" onclick='verJSON(<%- JSON.stringify(d) %>)'>
                                            <i class="bi bi-code-slash"></i> JSON
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function verJSON(obj) {
        Swal.fire({
            title: 'Metadatos Completos',
            html: '<pre class="text-start bg-light p-3 rounded" style="font-size: 0.8rem; overflow-x: auto;">' + JSON.stringify(obj, null, 2) + '</pre>',
            width: '600px',
            confirmButtonText: 'Cerrar'
        });
    }
</script>

<style>
    .bg-purple { background-color: #6f42c1; color: white; }
    .text-purple { color: #6f42c1; }
</style>
                </div> <!-- Fin container-fluid -->
            </div> <!-- Fin col -->
        </div> <!-- Fin row -->
    </div> <!-- Fin container-fluid general -->
</body>
<%- include('../partials/footer') %>
