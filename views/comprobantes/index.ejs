<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <%- include('../partials/sidebar') %>
            
            <div class="col py-0 py-md-3 main-content-wrapper" style="background-color: #f8fafc; min-height: 100vh;">
                <%- include('../partials/mobile-header') %>
                
                <div class="container-fluid px-4 py-4">
                    <!-- Cabecera -->
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-2.5 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-wallet2 fs-3"></i>
                        </div>
                        <div>
                            <h2 class="fw-bold text-dark my-0 fs-3">Auditoría de Comprobantes</h2>
                            <p class="text-muted small mb-0">Verifica, corrige montos y aprueba los abonos de pago enviados por tus clientes.</p>
                        </div>
                    </div>

                    <!-- Listado de Comprobantes Pendientes -->
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom p-3">
                            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                                <i class="bi bi-shield-check text-success me-2"></i> 
                                Comprobantes en Espera de Validación
                                <span class="badge bg-success rounded-pill ms-2 fw-normal" id="pendientesCounter" style="font-size: 0.75rem;"><%= pendientes.length %> Pendientes</span>
                            </h6>
                        </div>
                        <div class="card-body p-0">
                            <% if (pendientes.length === 0) { %>
                                <div class="text-center py-5 px-3" id="emptyState">
                                    <div class="bg-light text-success rounded-circle p-4 mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                        <i class="bi bi-check2-circle fs-1"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark">¡Todo al día!</h5>
                                    <p class="text-muted small">No hay comprobantes de pago pendientes de verificación en este momento.</p>
                                </div>
                            <% } else { %>
                                <div class="table-responsive" id="tableContainer">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-4">Comprobante ID</th>
                                                <th>Cliente</th>
                                                <th>Préstamo</th>
                                                <th>Monto Reportado</th>
                                                <th>Fecha Reporte</th>
                                                <th class="text-end pe-4">Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% pendientes.forEach(p => { %>
                                                <tr id="row-<%= p.id %>">
                                                    <td class="ps-4 fw-bold text-success">#<%= p.id %></td>
                                                    <td>
                                                        <div class="fw-bold text-dark"><%= p.cliente_nombre %> <%= p.cliente_apellido %></div>
                                                        <small class="text-muted"><%= p.cliente_dni %></small>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5">
                                                            Préstamo #<%= p.prestamo_id %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <h6 class="fw-bold text-dark mb-0 font-monospace">
                                                            $<%= parseFloat(p.monto).toLocaleString('es-CO') %>
                                                        </h6>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted d-block">
                                                            <%= new Date(p.fecha_reporte).toLocaleDateString() %>
                                                        </small>
                                                        <small class="text-muted" style="font-size: 0.75rem;">
                                                            <%= new Date(p.fecha_reporte).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                                        </small>
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        <button class="btn btn-sm btn-success rounded-pill px-3 fw-bold btn-auditar" 
                                                                data-id="<%= p.id %>" 
                                                                data-cliente="<%= p.cliente_nombre %> <%= p.cliente_apellido %>"
                                                                data-dni="<%= p.cliente_dni %>"
                                                                data-prestamo-id="<%= p.prestamo_id %>"
                                                                data-monto="<%= Math.round(p.monto) %>"
                                                                data-comprobante-url="<%= p.comprobante_url %>"
                                                                data-observaciones="<%= p.observaciones || '' %>">
                                                            <i class="bi bi-eye-fill me-1"></i> Verificar
                                                        </button>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 1. MODAL INTERACTIVO DE AUDITORÍA -->
    <div class="modal fade" id="modalAuditar" tabindex="-1" aria-labelledby="modalAuditarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-success text-white py-3">
                    <h5 class="modal-title fw-bold" id="modalAuditarLabel">
                        <i class="bi bi-check2-square me-2"></i> Auditar Comprobante #<span id="auditIdTitle"></span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4" style="background-color: #f8fafc;">
                    <div class="row g-4">
                        <!-- Lado Izquierdo: Comprobante subido -->
                        <div class="col-12 col-lg-7">
                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-dark d-flex align-items-center justify-content-center" style="min-height: 400px; max-height: 520px; position: relative;">
                                <img src="" id="auditImage" class="img-fluid" style="max-height: 500px; object-fit: contain; cursor: zoom-in;" title="Haz clic para ver tamaño completo">
                                <a href="" id="auditFullLink" target="_blank" class="btn btn-sm btn-light rounded-circle shadow position-absolute bottom-0 end-0 m-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;" title="Abrir en pestaña nueva">
                                    <i class="bi bi-fullscreen text-dark"></i>
                                </a>
                            </div>
                        </div>

                        <!-- Lado Derecho: Formulario de verificación y corrección -->
                        <div class="col-12 col-lg-5">
                            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-person-lines-fill text-success"></i> Datos de Transacción</h6>
                                
                                <div class="mb-3">
                                    <span class="text-muted small d-block">Cliente</span>
                                    <h6 class="fw-bold text-dark mb-0" id="auditCliente"></h6>
                                    <small class="text-muted" id="auditDni"></small>
                                </div>

                                <div class="mb-3">
                                    <span class="text-muted small d-block">Préstamo Asociado</span>
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 fw-bold" id="auditPrestamoId"></span>
                                </div>

                                <div class="mb-4 p-3 rounded-4 bg-light border">
                                    <label class="form-label text-dark fw-bold small"><i class="bi bi-pencil-square text-success"></i> Confirmar/Corregir Monto Recibido ($ COP)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-dark rounded-start-pill border-end-0 px-3 fw-bold">$</span>
                                        <input type="text" id="auditMonto" class="form-control rounded-end-pill px-3 border-start-0 currency-input fw-bold text-success fs-4" placeholder="0" required style="background-color: #ffffff;">
                                    </div>
                                    <small class="text-muted d-block mt-2">
                                        > [!TIP]
                                        > **¿El monto reportado es incorrecto?** 
                                        > Si el cliente se equivocó al digitar el valor transferido, corrígelo aquí mismo antes de aprobar. Se aplicará el monto final del input en el saldo.
                                    </small>
                                </div>

                                <div class="mb-3">
                                    <span class="text-muted small d-block">Mensaje del Cliente:</span>
                                    <p class="fst-italic text-dark small bg-light p-2.5 rounded-3 border" id="auditNotasCliente"></p>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-dark fw-bold small">Comentarios Internos / Motivo de Rechazo</label>
                                    <textarea id="auditObservaciones" class="form-control rounded-3" rows="3" placeholder="Ej. Abono verificado. Todo correcto, o especificar motivo del rechazo."></textarea>
                                </div>

                                <div class="d-flex gap-2 mt-4">
                                    <button type="button" class="btn btn-outline-danger flex-fill rounded-pill py-2.5 fw-bold" id="btnRechazar">
                                        <i class="bi bi-x-circle-fill me-1"></i> Rechazar Pago
                                    </button>
                                    <button type="button" class="btn btn-success flex-fill rounded-pill py-2.5 fw-bold" id="btnAprobar">
                                        <i class="bi bi-check-circle-fill me-1"></i> Confirmar y Aprobar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Estilos Premium -->
    <style>
        .px-3\.5 {
            padding-left: 0.85rem !important;
            padding-right: 0.85rem !important;
        }
        .py-2\.5 {
            padding-top: 0.65rem !important;
            padding-bottom: 0.65rem !important;
        }
        .p-2\.5 {
            padding: 0.625rem !important;
        }
    </style>

    <%- include('../partials/footer') %>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let activeReporteId = null;
            const modalElement = document.getElementById("modalAuditar");
            const modal = new bootstrap.Modal(modalElement);
            
            const auditIdTitle = document.getElementById("auditIdTitle");
            const auditImage = document.getElementById("auditImage");
            const auditFullLink = document.getElementById("auditFullLink");
            const auditCliente = document.getElementById("auditCliente");
            const auditDni = document.getElementById("auditDni");
            const auditPrestamoId = document.getElementById("auditPrestamoId");
            const auditMonto = document.getElementById("auditMonto");
            const auditNotasCliente = document.getElementById("auditNotasCliente");
            const auditObservaciones = document.getElementById("auditObservaciones");
            
            const btnAprobar = document.getElementById("btnAprobar");
            const btnRechazar = document.getElementById("btnRechazar");

            // Escuchar clics en "Verificar"
            document.querySelectorAll(".btn-auditar").forEach(btn => {
                btn.addEventListener("click", function() {
                    activeReporteId = this.getAttribute("data-id");
                    
                    // Llenar datos
                    auditIdTitle.textContent = activeReporteId;
                    auditImage.src = this.getAttribute("data-comprobante-url");
                    auditFullLink.href = this.getAttribute("data-comprobante-url");
                    auditCliente.textContent = this.getAttribute("data-cliente");
                    auditDni.textContent = `CC: ${this.getAttribute("data-dni")}`;
                    auditPrestamoId.textContent = `Préstamo #${this.getAttribute("data-prestamo-id")}`;
                    auditNotasCliente.textContent = this.getAttribute("data-observaciones") || "Sin notas adicionales.";
                    
                    // Precargar el monto formateado
                    const rawMonto = parseFloat(this.getAttribute("data-monto"));
                    auditMonto.value = rawMonto.toLocaleString("es-CO");
                    
                    auditObservaciones.value = "";
                    
                    modal.show();
                });
            });

            // Hacer zoom en la imagen al hacer clic
            auditImage.addEventListener("click", function() {
                window.open(this.src, '_blank');
            });

            // Acción: Aprobar Pago
            btnAprobar.addEventListener("click", async function() {
                if (!activeReporteId) return;
                
                // Limpiar puntos del monto antes de enviar
                const cleanMonto = parseFloat(auditMonto.value.replace(/\./g, "").replace(/,/g, "."));
                
                if (isNaN(cleanMonto) || cleanMonto <= 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Monto inválido',
                        text: 'Por favor, ingresa un monto válido mayor a cero.',
                        confirmButtonText: 'Entendido',
                        customClass: {
                            confirmButton: 'btn btn-success rounded-pill px-4 fw-bold'
                        },
                        buttonsStyling: false
                    });
                    return;
                }

                // Confirmación elegante de aprobación
                const formattedMonto = parseFloat(cleanMonto).toLocaleString("es-CO");
                const confirmacion = await Swal.fire({
                    title: '¿Confirmar aprobación?',
                    html: `¿Estás seguro de que deseas aprobar este comprobante de pago por un monto de <strong>$${formattedMonto} COP</strong>?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, aprobar',
                    cancelButtonText: 'Cancelar',
                    customClass: {
                        confirmButton: 'btn btn-success rounded-pill px-4 fw-bold me-2',
                        cancelButton: 'btn btn-outline-secondary rounded-pill px-4 fw-bold'
                    },
                    buttonsStyling: false
                });

                if (!confirmacion.isConfirmed) return;

                btnAprobar.disabled = true;
                btnRechazar.disabled = true;
                
                try {
                    const response = await fetch(`/admin/comprobantes/${activeReporteId}/procesar`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded"
                        },
                        body: new URLSearchParams({
                            estado: "aprobado",
                            monto: cleanMonto,
                            observaciones: auditObservaciones.value.trim()
                        })
                    });

                    const resData = await response.json();
                    
                    if (resData.success) {
                        await Swal.fire({
                            icon: 'success',
                            title: '¡Comprobante Aprobado!',
                            text: 'El pago ha sido registrado e impactado en la caja y el saldo del cliente.',
                            confirmButtonText: 'Excelente',
                            customClass: {
                                confirmButton: 'btn btn-success rounded-pill px-4 fw-bold'
                            },
                            buttonsStyling: false
                        });
                        modal.hide();
                        removerFilaReporte(activeReporteId);
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error de aprobación',
                            text: resData.error || 'No se pudo procesar la solicitud.',
                            confirmButtonText: 'Entendido',
                            customClass: {
                                confirmButton: 'btn btn-success rounded-pill px-4 fw-bold'
                            },
                            buttonsStyling: false
                        });
                    }
                } catch (err) {
                    console.error("Error al procesar aprobación:", err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de red',
                        text: 'Ocurrió un error al intentar comunicar con el servidor.',
                        confirmButtonText: 'Entendido',
                        customClass: {
                            confirmButton: 'btn btn-success rounded-pill px-4 fw-bold'
                        },
                        buttonsStyling: false
                    });
                } finally {
                    btnAprobar.disabled = false;
                    btnRechazar.disabled = false;
                }
            });

            // Acción: Rechazar Pago
            btnRechazar.addEventListener("click", async function() {
                if (!activeReporteId) return;
                
                const obs = auditObservaciones.value.trim();
                if (obs.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Motivo requerido',
                        text: 'Debes ingresar obligatoriamente un motivo de rechazo en los comentarios.',
                        confirmButtonText: 'Entendido',
                        customClass: {
                            confirmButton: 'btn btn-success rounded-pill px-4 fw-bold'
                        },
                        buttonsStyling: false
                    });
                    return;
                }

                const confirmacion = await Swal.fire({
                    title: '¿Rechazar comprobante?',
                    text: '¿Estás seguro de que deseas rechazar este comprobante de pago? El cliente será notificado.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, rechazar',
                    cancelButtonText: 'Cancelar',
                    customClass: {
                        confirmButton: 'btn btn-danger rounded-pill px-4 fw-bold me-2',
                        cancelButton: 'btn btn-outline-secondary rounded-pill px-4 fw-bold'
                    },
                    buttonsStyling: false
                });

                if (!confirmacion.isConfirmed) return;

                btnAprobar.disabled = true;
                btnRechazar.disabled = true;
                
                try {
                    const response = await fetch(`/admin/comprobantes/${activeReporteId}/procesar`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded"
                        },
                        body: new URLSearchParams({
                            estado: "rechazado",
                            observaciones: obs
                        })
                    });

                    const resData = await response.json();
                    
                    if (resData.success) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Comprobante Rechazado',
                            text: 'El comprobante ha sido rechazado y el cliente ha recibido una notificación de correo.',
                            confirmButtonText: 'Entendido',
                            customClass: {
                                confirmButton: 'btn btn-success rounded-pill px-4 fw-bold'
                            },
                            buttonsStyling: false
                        });
                        modal.hide();
                        removerFilaReporte(activeReporteId);
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error al rechazar',
                            text: resData.error || 'No se pudo rechazar la solicitud.',
                            confirmButtonText: 'Entendido',
                            customClass: {
                                confirmButton: 'btn btn-success rounded-pill px-4 fw-bold'
                            },
                            buttonsStyling: false
                        });
                    }
                } catch (err) {
                    console.error("Error al procesar rechazo:", err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de red',
                        text: 'Ocurrió un error al intentar comunicar con el servidor.',
                        confirmButtonText: 'Entendido',
                        customClass: {
                            confirmButton: 'btn btn-success rounded-pill px-4 fw-bold'
                        },
                        buttonsStyling: false
                    });
                } finally {
                    btnAprobar.disabled = false;
                    btnRechazar.disabled = false;
                }
            });

            // Remover fila con animación suave
            function removerFilaReporte(id) {
                const row = document.getElementById(`row-${id}`);
                if (row) {
                    row.style.transition = "all 0.4s ease";
                    row.style.opacity = 0;
                    row.style.transform = "translateX(50px)";
                    setTimeout(() => {
                        row.remove();
                        actualizarContadores();
                    }, 400);
                }
            }

            // Actualizar los contadores visuales de comprobantes pendientes
            function actualizarContadores() {
                const tbody = document.querySelector("table tbody");
                const counter = document.getElementById("pendientesCounter");
                
                if (tbody && tbody.children.length === 0) {
                    // Si ya no quedan filas, recargar página o mostrar Empty State
                    location.reload();
                } else if (tbody && counter) {
                    counter.textContent = `${tbody.children.length} Pendientes`;
                }
            }
        });
    </script>
</body>
</html>
