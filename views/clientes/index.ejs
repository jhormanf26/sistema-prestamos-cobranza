<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <%- include('../partials/sidebar') %>
            
            <div class="col py-0 py-md-3 main-content-wrapper">
                <%- include('../partials/mobile-header') %>
                
                <div class="container-fluid px-4 py-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                        <h2>👥 Listado de Clientes</h2>
                        <a href="/clientes/crear" class="btn btn-primary">
                            <i class="bi bi-person-plus"></i> Nuevo Cliente
                        </a>
                    </div>

                    <% if(mensajeExito && mensajeExito.length > 0) { %>
                        <div class="d-none" id="flashMessageSuccess"><%= mensajeExito %></div>
                    <% } %>
                    <% if(mensajeError && mensajeError.length > 0) { %>
                        <div class="alert alert-danger"><%= mensajeError %></div>
                    <% } %>

                    <div class="card card-box p-3 mb-4 bg-light">
                        <form action="/clientes" method="GET" class="row g-2 align-items-center">
                            <div class="col-auto">
                                <label class="col-form-label fw-bold"><i class="bi bi-search"></i> Buscar:</label>
                            </div>
                            <div class="col-auto flex-grow-1">
                                <input type="text" name="q" class="form-control" placeholder="Nombre, Apellido o CC..." value="<%= busqueda %>">
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-dark">Filtrar</button>
                                <% if(busqueda) { %>
                                    <a href="/clientes" class="btn btn-outline-secondary">Limpiar</a>
                                <% } %>
                            </div>
                        </form>
                    </div>

                    <div class="card card-box p-3">
                        <div class="table-responsive d-none d-md-block" style="min-height: 300px;">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Foto</th>
                                        <th>CC</th>
                                        <th>Cliente</th>
                                        <th>Contacto</th>
                                        <th class="text-center">Score</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center">Último Acceso</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (clientes.length > 0) { %>
                                        <% clientes.forEach(cliente => { %>
                                            <tr>
                                                <td>
                                                    <% if(cliente.foto) { %>
                                                        <img src="/uploads/<%= cliente.foto %>" class="rounded-circle border" style="width: 40px; height: 40px; object-fit: cover;">
                                                    <% } else { %>
                                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                            <%= cliente.nombre.charAt(0) %>
                                                        </div>
                                                    <% } %>
                                                </td>
                                                <td><span class="badge bg-light text-dark border"><%= cliente.dni %></span></td>
                                                <td>
                                                    <div class="fw-bold"><%= cliente.nombre %> <%= cliente.apellido %></div>
                                                    <small class="text-muted"><%= cliente.direccion || 'Sin dirección' %></small>
                                                </td>
                                                <td>
                                                    <div class="small"><i class="bi bi-telephone"></i> <%= cliente.telefono || '-' %></div>
                                                    <div class="small text-muted"><i class="bi bi-envelope"></i> <%= cliente.email || '-' %></div>
                                                </td>
                                                <td class="text-center">
                                                    <% if (cliente.score !== null && typeof cliente.score !== 'undefined') { %>
                                                        <% 
                                                           let badgeClass = 'bg-secondary';
                                                           let categoria = 'C';
                                                           if (cliente.score >= 900) { badgeClass = 'bg-success'; categoria = 'A'; }
                                                           else if (cliente.score >= 700) { badgeClass = 'bg-info'; categoria = 'B'; }
                                                           else if (cliente.score >= 500) { badgeClass = 'bg-warning text-dark'; categoria = 'C'; }
                                                           else if (cliente.score >= 300) { badgeClass = 'bg-danger bg-opacity-75'; categoria = 'D'; }
                                                           else { badgeClass = 'bg-danger'; categoria = 'E'; }
                                                        %>
                                                        <span class="badge <%= badgeClass %> px-2.5 py-1.5 rounded-pill shadow-sm" style="font-size: 0.8rem; cursor: pointer;" onclick="mostrarAyudaScore()" title="Cálculo: <%= cliente.score_fecha ? new Date(cliente.score_fecha).toLocaleDateString() : 'N/A' %>">
                                                            <%= cliente.score %> (<%= categoria %>)
                                                        </span>
                                                    <% } else { %>
                                                        <span class="text-muted small">--</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <% if(cliente.estado == 1 || cliente.estado == null) { %>
                                                        <span class="badge bg-success bg-opacity-75 rounded-pill">Activo</span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary rounded-pill">Inactivo</span>
                                                    <% } %>
                                                    <% if(cliente.app_instalada) { %>
                                                        <span class="badge bg-primary bg-opacity-75 rounded-pill mt-1 d-block"><i class="bi bi-phone"></i> App</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <% if(cliente.ultimo_login) { %>
                                                        <span class="small text-muted d-block"><i class="bi bi-clock-history me-1"></i><%= new Date(cliente.ultimo_login).toLocaleDateString() %></span>
                                                        <span class="small text-muted"><%= new Date(cliente.ultimo_login).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                                                    <% } else { %>
                                                        <span class="small text-muted fst-italic">Nunca</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-sm btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" data-bs-boundary="viewport">
                                                            Opciones
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                                            <li><a class="dropdown-item" href="/clientes/ver/<%= cliente.id %>"><i class="bi bi-eye-fill text-info me-2"></i> Ver Perfil</a></li>
                                                            <li><a class="dropdown-item" href="/clientes/editar/<%= cliente.id %>"><i class="bi bi-pencil-fill text-warning me-2"></i> Editar</a></li>
                                                            <li><a class="dropdown-item text-success" href="#" onclick="recalcularScoreRapido(event, <%= cliente.id %>)"><i class="bi bi-shield-check-fill me-2"></i> Recalcular Score</a></li>
                                                            <li><hr class="dropdown-divider"></li>
                                                            
                                                            <% if(cliente.estado == 1 || cliente.estado == null) { %>
                                                                <li>
                                                                    <a class="dropdown-item text-danger" href="/clientes/cambiar-estado/<%= cliente.id %>" 
                                                                       onclick="confirmarCambioEstado(event, this.href, 'bloquear', 'cliente')">
                                                                        <i class="bi bi-lock-fill me-2"></i> Inhabilitar
                                                                    </a>
                                                                </li>
                                                            <% } else { %>
                                                                <li>
                                                                    <a class="dropdown-item text-success" href="/clientes/cambiar-estado/<%= cliente.id %>" 
                                                                       onclick="confirmarCambioEstado(event, this.href, 'activar', 'cliente')">
                                                                        <i class="bi bi-unlock-fill me-2"></i> Habilitar
                                                                    </a>
                                                                </li>
                                                            <% } %>
                                                        </ul>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr><td colspan="6" class="text-center py-5">No se encontraron clientes.</td></tr>
                                    <% } %>
                                </tbody>
                             </table>
                         </div>
                        
                        <!-- Vista Móvil: Tarjeticas Premium de Clientes -->
                        <div class="d-block d-md-none mt-3">
                            <% if (clientes.length > 0) { %>
                                <div class="d-flex flex-column gap-3">
                                    <% clientes.forEach(cliente => { %>
                                        <div class="card border border-light-subtle shadow-sm rounded-4 p-3 bg-white">
                                            <!-- Fila superior: Foto, Nombre, Estado y Dropdown -->
                                            <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-2">
                                                <div class="d-flex align-items-center gap-3">
                                                    <% if(cliente.foto) { %>
                                                        <img src="/uploads/<%= cliente.foto %>" class="rounded-circle border" style="width: 44px; height: 44px; object-fit: cover;">
                                                    <% } else { %>
                                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px; font-size: 1.1rem;">
                                                            <%= cliente.nombre.charAt(0) %>
                                                        </div>
                                                    <% } %>
                                                    <div>
                                                        <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;"><%= cliente.nombre %> <%= cliente.apellido %></h6>
                                                        <span class="badge bg-light text-dark border mt-1" style="font-size: 0.75rem;">CC <%= cliente.dni %></span>
                                                    </div>
                                                </div>
                                                
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-sm btn-light border rounded-pill px-2.5 py-1 d-flex align-items-center justify-content-center" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.8rem;">
                                                            <i class="bi bi-three-dots-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3" style="z-index: 1040;">
                                                            <li><a class="dropdown-item py-2" href="/clientes/ver/<%= cliente.id %>"><i class="bi bi-eye-fill text-info me-2"></i> Ver Perfil</a></li>
                                                            <li><a class="dropdown-item py-2" href="/clientes/editar/<%= cliente.id %>"><i class="bi bi-pencil-fill text-warning me-2"></i> Editar</a></li>
                                                            <li><a class="dropdown-item py-2 text-success" href="#" onclick="recalcularScoreRapido(event, <%= cliente.id %>)"><i class="bi bi-shield-check-fill me-2"></i> Recalcular Score</a></li>
                                                            <li><hr class="dropdown-divider"></li>
                                                            <% if(cliente.estado == 1 || cliente.estado == null) { %>
                                                                <li>
                                                                    <a class="dropdown-item py-2 text-danger" href="/clientes/cambiar-estado/<%= cliente.id %>" 
                                                                       onclick="confirmarCambioEstado(event, this.href, 'bloquear', 'cliente')">
                                                                        <i class="bi bi-lock-fill me-2"></i> Inhabilitar
                                                                    </a>
                                                                </li>
                                                            <% } else { %>
                                                                <li>
                                                                    <a class="dropdown-item py-2 text-success" href="/clientes/cambiar-estado/<%= cliente.id %>" 
                                                                       onclick="confirmarCambioEstado(event, this.href, 'activar', 'cliente')">
                                                                        <i class="bi bi-unlock-fill me-2"></i> Habilitar
                                                                    </a>
                                                                </li>
                                                            <% } %>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Información del Cliente (Dirección y Contactos) -->
                                            <div class="row g-2 small text-muted mb-3" style="font-size: 0.8rem;">
                                                <div class="col-12">
                                                    <i class="bi bi-geo-alt-fill text-secondary me-1.5"></i><%= cliente.direccion || 'Sin dirección' %>
                                                </div>
                                                <div class="col-6">
                                                    <a href="tel:<%= cliente.telefono %>" class="text-decoration-none text-muted d-block text-nowrap"><i class="bi bi-telephone-fill text-secondary me-1.5"></i><%= cliente.telefono || '-' %></a>
                                                </div>
                                                <div class="col-6">
                                                    <a href="mailto:<%= cliente.email %>" class="text-decoration-none text-muted d-block text-truncate"><i class="bi bi-envelope-fill text-secondary me-1.5"></i><%= cliente.email || '-' %></a>
                                                </div>
                                            </div>

                                            <!-- Fila inferior: Score, Estado y Último Login -->
                                            <div class="d-flex align-items-center justify-content-between pt-2 border-top bg-light bg-opacity-50 rounded-3 p-2">
                                                <div class="text-center flex-fill border-end">
                                                    <span class="d-block text-muted small mb-1" style="font-size: 0.65rem; text-uppercase; font-weight:600;">Score</span>
                                                    <% if (cliente.score !== null && typeof cliente.score !== 'undefined') { %>
                                                        <% 
                                                           let badgeClass = 'bg-secondary';
                                                           let categoria = 'C';
                                                           if (cliente.score >= 900) { badgeClass = 'bg-success'; categoria = 'A'; }
                                                           else if (cliente.score >= 700) { badgeClass = 'bg-info'; categoria = 'B'; }
                                                           else if (cliente.score >= 500) { badgeClass = 'bg-warning text-dark'; categoria = 'C'; }
                                                           else if (cliente.score >= 300) { badgeClass = 'bg-danger bg-opacity-75'; categoria = 'D'; }
                                                           else { badgeClass = 'bg-danger'; categoria = 'E'; }
                                                        %>
                                                        <span class="badge <%= badgeClass %> px-2 rounded-pill shadow-xs" style="font-size: 0.75rem; cursor: pointer;" onclick="mostrarAyudaScore()">
                                                            <%= cliente.score %> (<%= categoria %>)
                                                        </span>
                                                    <% } else { %>
                                                        <span class="text-muted small">--</span>
                                                    <% } %>
                                                </div>
                                                
                                                <div class="text-center flex-fill border-end">
                                                    <span class="d-block text-muted small mb-1" style="font-size: 0.65rem; text-uppercase; font-weight:600;">Estado</span>
                                                    <% if(cliente.estado == 1 || cliente.estado == null) { %>
                                                        <span class="badge bg-success bg-opacity-75 rounded-pill" style="font-size: 0.7rem;">Activo</span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.7rem;">Inactivo</span>
                                                    <% } %>
                                                    <% if(cliente.app_instalada) { %>
                                                        <span class="badge bg-primary bg-opacity-75 rounded-pill d-block mt-1 mx-auto" style="font-size: 0.6rem; max-width: fit-content; padding: 1px 4px;"><i class="bi bi-phone"></i> App</span>
                                                    <% } %>
                                                </div>

                                                <div class="text-center flex-fill">
                                                    <span class="d-block text-muted small mb-1" style="font-size: 0.65rem; text-uppercase; font-weight:600;">Último Acceso</span>
                                                    <% if(cliente.ultimo_login) { %>
                                                        <span class="fw-semibold text-dark small" style="font-size: 0.7rem;"><%= new Date(cliente.ultimo_login).toLocaleDateString('es-CO') %></span>
                                                    <% } else { %>
                                                        <span class="text-muted fst-italic" style="font-size: 0.7rem;">Nunca</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-4 bg-white rounded-4 border">No se encontraron clientes.</div>
                            <% } %>
                        </div>
                        
                        <% if (totalPages > 1) { %>
                            <nav class="mt-4 d-flex justify-content-between align-items-center">
                                <small class="text-muted">Página <%= currentPage %> de <%= totalPages %></small>
                                <ul class="pagination mb-0">
                                    <li class="page-item <%= currentPage == 1 ? 'disabled' : '' %>">
                                        <a class="page-link" href="/clientes?page=<%= currentPage - 1 %>&q=<%= busqueda %>">Anterior</a>
                                    </li>
                                    <li class="page-item <%= currentPage == totalPages ? 'disabled' : '' %>">
                                        <a class="page-link" href="/clientes?page=<%= currentPage + 1 %>&q=<%= busqueda %>">Siguiente</a>
                                    </li>
                                </ul>
                            </nav>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include('../partials/footer') %>
    <script>
        async function recalcularScoreRapido(event, clienteId) {
            event.preventDefault();
            
            Swal.fire({
                title: 'Recalculando Score...',
                text: 'Evaluando comportamiento histórico del cliente.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const response = await fetch(`/clientes/recalcular-score/${clienteId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Score Recalculado!',
                        text: `El nuevo score es de ${data.scoreData.score} puntos (Categoría ${data.scoreData.categoria}).`,
                        confirmButtonColor: '#10b981'
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Error', data.mensaje || 'No se pudo recalcular el score.', 'error');
                }
            } catch (err) {
                console.error(err);
                Swal.fire('Error de Red', 'No se pudo conectar con el servidor.', 'error');
            }
        }

        function mostrarAyudaScore() {
            const esMovil = window.innerWidth < 768;
            Swal.fire({
                title: 'Clasificación del Score Crediticio',
                width: esMovil ? '95%' : '700px',
                html: `
                    <!-- Vista Desktop: Tabla -->
                    <div class="table-responsive text-start small mt-2 d-none d-md-block">
                        <table class="table table-bordered align-middle mb-0 text-nowrap">
                            <thead class="table-light text-center">
                                <tr>
                                    <th>Categoría</th>
                                    <th>Rango Puntos</th>
                                    <th>Nivel de Riesgo</th>
                                    <th>Tasa (Int. / Mora)</th>
                                        <th>Cupo Máximo</th>
                                </tr>
                            </thead>
                            <tbody class="text-center">
                                <tr style="background-color: rgba(16, 185, 129, 0.08);">
                                    <td><span class="badge bg-success px-2 py-1">Categoría A</span></td>
                                    <td class="fw-bold text-success">900 - 1000 pts</td>
                                    <td class="fw-bold text-success">Excelente</td>
                                    <td class="fw-bold text-success">1.5% / 2.5%</td>
                                        <td class="fw-bold text-success">$ 2.000.000</td>
                                </tr>
                                <tr style="background-color: rgba(59, 130, 246, 0.08);">
                                    <td><span class="badge bg-info px-2 py-1">Categoría B</span></td>
                                    <td class="fw-bold text-primary">700 - 899 pts</td>
                                    <td class="fw-bold text-primary">Bueno</td>
                                    <td class="fw-bold text-primary">2.0% / 3.0%</td>
                                        <td class="fw-bold text-primary">$ 1.000.000</td>
                                </tr>
                                <tr style="background-color: rgba(245, 158, 11, 0.08);">
                                    <td><span class="badge bg-warning text-dark px-2 py-1">Categoría C</span></td>
                                    <td class="fw-bold text-warning">500 - 699 pts</td>
                                    <td class="fw-bold text-warning">Regular</td>
                                    <td class="fw-bold text-warning">2.5% / 3.5%</td>
                                        <td class="fw-bold text-warning">$ 500.000</td>
                                </tr>
                                <tr style="background-color: rgba(248, 113, 113, 0.08);">
                                    <td><span class="badge px-2 py-1 text-white" style="background-color: #f87171;">Categoría D</span></td>
                                    <td class="fw-bold text-danger">300 - 499 pts</td>
                                    <td class="fw-bold text-danger">Malo</td>
                                    <td class="fw-bold text-danger">3.0% / 4.0%</td>
                                        <td class="fw-bold text-danger">$ 300.000</td>
                                </tr>
                                <tr style="background-color: rgba(220, 38, 38, 0.08);">
                                    <td><span class="badge bg-danger px-2 py-1">Categoría E</span></td>
                                    <td class="fw-bold text-danger" style="color: #dc2626 !important;">0 - 299 pts</td>
                                    <td class="fw-bold text-danger" style="color: #dc2626 !important;">Crítico</td>
                                    <td class="fw-bold text-danger" style="color: #dc2626 !important;">3.5% / 4.5%</td>
                                        <td class="fw-bold text-danger" style="color: #dc2626 !important;">$ 200.000</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Vista Móvil: Tarjetas Premium -->
                    <div class="d-md-none mt-2">
                        <div class="d-flex flex-column gap-2 text-start">
                            <!-- Categoría A -->
                            <div class="p-2.5 rounded-3 border d-flex justify-content-between align-items-center" style="background-color: rgba(16, 185, 129, 0.06); border-color: rgba(16, 185, 129, 0.15) !important;">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-success px-2 py-1 rounded-2 fw-bold" style="font-size: 0.75rem;">Cat. A</span>
                                    <div>
                                        <div class="fw-bold text-success" style="font-size: 0.8rem; line-height: 1.2;">Excelente</div>
                                        <div class="text-muted" style="font-size: 0.65rem;">Riesgo Muy Bajo • Cupo: $ 2.000.000</div>
                                    </div>
                                </div>
                                <div class="text-end" style="line-height: 1.2;">
                                    <div class="fw-bold text-dark" style="font-size: 0.8rem;">900 - 1000 pts</div>
                                    <div class="text-success fw-bold" style="font-size: 0.7rem;"><i class="bi bi-percent me-0.5"></i> 1.5% / 2.5%</div>
                                </div>
                            </div>
                            <!-- Categoría B -->
                            <div class="p-2.5 rounded-3 border d-flex justify-content-between align-items-center" style="background-color: rgba(59, 130, 246, 0.06); border-color: rgba(59, 130, 246, 0.15) !important;">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-info px-2 py-1 rounded-2 fw-bold text-white" style="font-size: 0.75rem;">Cat. B</span>
                                    <div>
                                        <div class="fw-bold text-primary" style="font-size: 0.8rem; line-height: 1.2;">Bueno</div>
                                        <div class="text-muted" style="font-size: 0.65rem;">Riesgo Bajo • Cupo: $ 1.000.000</div>
                                    </div>
                                </div>
                                <div class="text-end" style="line-height: 1.2;">
                                    <div class="fw-bold text-dark" style="font-size: 0.8rem;">700 - 899 pts</div>
                                    <div class="text-primary fw-bold" style="font-size: 0.7rem;"><i class="bi bi-percent me-0.5"></i> 2.0% / 3.0%</div>
                                </div>
                            </div>
                            <!-- Categoría C -->
                            <div class="p-2.5 rounded-3 border d-flex justify-content-between align-items-center" style="background-color: rgba(245, 158, 11, 0.06); border-color: rgba(245, 158, 11, 0.15) !important;">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-warning text-dark px-2 py-1 rounded-2 fw-bold" style="font-size: 0.75rem;">Cat. C</span>
                                    <div>
                                        <div class="fw-bold text-warning" style="font-size: 0.8rem; line-height: 1.2;">Regular</div>
                                        <div class="text-muted" style="font-size: 0.65rem;">Riesgo Medio • Cupo: $ 500.000</div>
                                    </div>
                                </div>
                                <div class="text-end" style="line-height: 1.2;">
                                    <div class="fw-bold text-dark" style="font-size: 0.8rem;">500 - 699 pts</div>
                                    <div class="text-warning fw-bold" style="font-size: 0.7rem;"><i class="bi bi-percent me-0.5"></i> 2.5% / 3.5%</div>
                                </div>
