                                                                <span class="text-dark fw-bold" id="detallePagosAdminMob"><%= scoreData.detalles.prestamosPagadosATiempoCount %> préstamos</span>
                                                                <button type="button" class="btn btn-sm btn-link text-success p-0" onclick="auditarPagadosATiempo()" title="Auditar préstamos pagados a tiempo"><i class="bi bi-eye-fill"></i></button>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Saldo ahorro -->
                                                    <div class="card border border-light shadow-sm rounded-4 mb-2 p-3 bg-white">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span class="fw-bold text-dark">
                                                                Saldo en Cuenta de Ahorro
                                                                <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.8rem;" onclick="explicarRegla('ahorros')"></i>
                                                            </span>
                                                            <span class="badge bg-success bg-opacity-10 text-success fw-bold" id="desgloseAhorrosSaldoAdminMob">+<%= scoreData.desglose.ahorrosSaldo || 0 %> pts</span>
                                                        </div>
                                                        <div class="d-flex justify-content-between align-items-center mt-2 small">
                                                            <span class="text-muted">Impacto: +10 pts por cada $100.000, máx 70</span>
                                                            <span class="text-dark fw-bold" id="detalleAhorrosSaldoAdminMob"><%= empresa.moneda %> <%= formatCurrency(scoreData.detalles.ahorroSaldo, 0) %></span>
                                                        </div>
                                                    </div>

