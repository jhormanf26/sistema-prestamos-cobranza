                                                    <div class="card border border-light shadow-sm rounded-4 mb-2 p-3 bg-light">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span class="fw-bold text-dark">
                                                                Puntaje Base del Sistema
                                                                <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.8rem;" onclick="explicarRegla('base')"></i>
                                                            </span>
