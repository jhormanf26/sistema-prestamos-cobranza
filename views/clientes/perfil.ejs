<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>

    <body>
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <%- include('../partials/sidebar') %>

                    <div class="col py-3">
                        <div class="container-fluid px-4 py-4">

                            <div class="card card-box mb-4 border-primary border-top border-4">
                                <div class="card-body d-flex align-items-center flex-wrap gap-3">

                                    <div class="me-2">
                                        <% if (cliente.foto) { %>
                                            <img src="/uploads/<%= cliente.foto %>"
                                                class="rounded-circle border border-3 border-white shadow-sm"
                                                style="width: 100px; height: 100px; object-fit: cover;">
                                            <% } else { %>
                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                                    style="width: 100px; height: 100px; font-size: 2.5rem;">
                                                    <%= cliente.nombre.charAt(0) %>
                                                </div>
                                                <% } %>
                                    </div>

                                    <div class="flex-grow-1">
                                        <h2 class="mb-0 fw-bold">
                                            <%= cliente.nombre %>
                                                <%= cliente.apellido %>
                                        </h2>
                                        <p class="text-muted mb-2">CC: <strong>
                                                <%= cliente.dni %>
                                            </strong></p>

                                        <div class="d-flex gap-2 flex-wrap">
                                            <span class="badge bg-light text-dark border"><i
                                                    class="bi bi-geo-alt-fill text-danger"></i>
                                                <%= cliente.direccion || 'Sin dirección' %>
                                            </span>
                                            <span class="badge bg-light text-dark border"><i
                                                    class="bi bi-telephone-fill text-success"></i>
                                                <%= cliente.telefono || 'Sin teléfono' %>
                                            </span>
                                            <span class="badge bg-light text-dark border"><i
                                                    class="bi bi-envelope-fill text-primary"></i>
                                                <%= cliente.email || 'Sin email' %>
                                            </span>
                                            <span class="badge bg-light text-dark border" title="Última vez que el cliente ingresó a su portal">
                                                <i class="bi bi-person-badge-fill text-info"></i>
                                                Último acceso: <%= cliente.ultimo_login ? new Date(cliente.ultimo_login).toLocaleString() : 'Nunca' %>
                                            </span>
                                            <% if (cliente.app_instalada) { %>
                                                <span class="badge bg-primary text-white border border-primary shadow-sm" title="El cliente ha instalado la aplicación">
                                                    <i class="bi bi-phone-fill text-white"></i> APP INSTALADA
                                                </span>
                                            <% } %>
                                            <% if (cliente.monto_preaprobado > 0) { %>
                                                <span class="badge bg-warning text-dark border border-warning shadow-sm" title="Cupo disponible para nuevos créditos">
                                                    <i class="bi bi-star-fill text-primary"></i> PRE-APROBADO: <%= empresa.moneda %> <%= formatCurrency(cliente.monto_preaprobado, 0) %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="text-end mt-3 mt-md-0 d-flex gap-2">
                                        <% if (cliente.monto_preaprobado > 0 && cliente.email) { %>
                                            <button onclick="enviarCorreoPreaprobado(<%= cliente.id %>)" 
                                                    class="btn btn-primary shadow-sm px-4 fw-bold rounded-pill"
                                                    id="btnSendPre">
                                                <i class="bi bi-envelope-check-fill me-2"></i> Notificar Pre-aprobado
                                            </button>
                                        <% } %>
                                        <a href="/reportes/estado-cuenta/<%= cliente.id %>" target="_blank"
                                            class="btn btn-dark shadow-sm px-4 fw-bold rounded-pill">
                                            <i class="bi bi-file-earmark-bar-graph-fill me-2"></i> Estado de Cuenta
                                        </a>
                                        <a href="/clientes" class="btn btn-outline-secondary px-3 rounded-pill" title="Volver al listado">
                                            <i class="bi bi-arrow-left"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>                            <ul class="nav nav-tabs mb-3" id="clientTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="prestamos-tab" data-bs-toggle="tab"
                                        data-bs-target="#prestamos" type="button">
                                        <i class="bi bi-cash-stack"></i> Préstamos (<%= prestamos.length %>)
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="empenos-tab" data-bs-toggle="tab"
                                        data-bs-target="#empenos" type="button">
                                        <i class="bi bi-gem"></i> Empeños (<%= empenos.length %>)
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="ahorros-tab" data-bs-toggle="tab"
                                        data-bs-target="#ahorros" type="button">
                                        <i class="bi bi-piggy-bank"></i> Ahorros
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="preaprobados-tab" data-bs-toggle="tab"
                                        data-bs-target="#preaprobados" type="button">
                                        <i class="bi bi-star-fill text-warning"></i> Pre-aprobados
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content" id="clientTabsContent">
                                <!-- Tab Préstamos -->
                                <div class="tab-pane fade show active" id="prestamos" role="tabpanel">
                                    <div class="card card-box p-0 border-0 shadow-sm overflow-hidden">
                                        <% if(prestamos.length > 0) { %>
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0">
                                                    <thead class="table-light text-uppercase small fw-bold">
                                                        <tr>
                                                            <th>ID</th>
                                                            <th>Fecha</th>
                                                            <th>Prestado</th>
                                                            <th>Pagado</th>
                                                            <th>Saldo</th>
                                                            <th>Estado</th>
                                                            <th class="text-end pe-3">Acción</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% prestamos.forEach(p => { 
                                                            const pagado = p.total_pagado || 0;
                                                            const saldo = p.monto_total - pagado;
                                                        %>
                                                        <tr>
                                                            <td><span class="badge bg-dark">#<%= p.id %></span></td>
                                                            <td><%= new Date(p.fecha_inicio).toLocaleDateString() %></td>
                                                            <td class="small fw-bold"><%= empresa.moneda %> <%= formatCurrency(p.monto_prestado, 2) %></td>
                                                            <td class="text-primary fw-bold"><%= empresa.moneda %> <%= formatCurrency(pagado, 2) %></td>
                                                            <td class="text-danger fw-bold"><%= empresa.moneda %> <%= formatCurrency(saldo, 2) %></td>
                                                            <td>
                                                                <% if(p.estado == 'pendiente') { %>
                                                                    <span class="badge bg-warning text-dark px-2 rounded-pill">PENDIENTE</span>
                                                                <% } else if(p.estado == 'pagado') { %>
                                                                    <span class="badge bg-success px-2 rounded-pill">PAGADO</span>
                                                                <% } else { %>
                                                                    <span class="badge bg-danger px-2 rounded-pill">VENCIDO</span>
                                                                <% } %>
                                                            </td>
                                                            <td class="text-end pe-3">
                                                                <a href="/pagos/registrar/<%= p.id %>" class="btn btn-outline-success btn-sm"><i class="bi bi-cash"></i></a>
                                                                <a href="/prestamos/cronograma/<%= p.id %>" class="btn btn-outline-primary btn-sm"><i class="bi bi-calendar3"></i></a>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        <% } else { %>
                                            <div class="text-center py-5 text-muted">No hay historial de préstamos.</div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Tab Empeños -->
                                <div class="tab-pane fade" id="empenos" role="tabpanel">
                                    <div class="card card-box p-3 border-0 shadow-sm">
                                        <% if(empenos.length > 0) { %>
                                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                                <% empenos.forEach(e => { %>
                                                    <div class="col">
                                                        <div class="border rounded p-3 d-flex align-items-center bg-white shadow-sm">
                                                            <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center border" style="width: 50px; height: 50px;">
                                                                <i class="bi bi-gem fs-4 text-primary"></i>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <h6 class="mb-0 fw-bold"><%= e.nombre_articulo %></h6>
                                                                <small class="text-muted"><%= e.descripcion %></small>
                                                            </div>
                                                            <div class="text-end">
                                                                <span class="badge bg-primary d-block mb-1"><%= empresa.moneda %> <%= formatCurrency(e.monto_prestado, 2) %></span>
                                                                <span class="badge bg-info text-dark small"><%= e.estado %></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <div class="text-center py-5 text-muted">No hay empeños registrados.</div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Tab Ahorros -->
                                <div class="tab-pane fade" id="ahorros" role="tabpanel">
                                    <div class="card card-box p-4 text-center border-0 shadow-sm">
                                        <% if(cuentaAhorro) { %>
                                            <h6 class="text-muted text-uppercase mb-1">Saldo de Ahorros</h6>
                                            <h2 class="text-success fw-bold mb-3"><%= empresa.moneda %> <%= formatCurrency(cuentaAhorro.saldo_actual, 2) %></h2>
                                            <a href="/ahorros/ver/<%= cuentaAhorro.id %>" class="btn btn-primary px-4 btn-sm">Ver Movimientos</a>
                                        <% } else { %>
                                            <p class="text-muted">Sin cuenta de ahorros activa.</p>
                                            <a href="/ahorros/aperturar" class="btn btn-outline-primary btn-sm">Aperturar Cuenta</a>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Tab Pre-aprobados (NUEVA PESTAÑA) -->
                                <div class="tab-pane fade" id="preaprobados" role="tabpanel">
                                    <div class="card card-box border-0 shadow-sm overflow-hidden">
                                        <div class="row g-0">
                                            <div class="col-md-4 bg-primary text-white d-flex flex-column align-items-center justify-content-center p-5">
                                                <i class="bi bi-star-fill display-1 mb-3 opacity-50"></i>
                                                <h4 class="fw-bold">Cupo Especial</h4>
                                                <p class="small text-center opacity-75">Créditos de aprobación instantánea para clientes premium.</p>
                                            </div>
                                            <div class="col-md-8 p-5">
                                                <div class="text-center mb-4">
                                                    <p class="text-muted small mb-1 text-uppercase fw-bold">Cupo Disponible Actualmente</p>
                                                    <h1 id="montoPreDisplay" class="fw-bold text-primary mb-0" style="font-size: 3.5rem;">
                                                        <%= empresa.moneda %> <%= formatCurrency(cliente.monto_preaprobado || 0, 0) %>
                                                    </h1>
                                                </div>

                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <button onclick="editarCupoPreaprobado(<%= cliente.id %>, '<%= cliente.monto_preaprobado %>')" 
                                                                class="btn btn-outline-primary w-100 fw-bold py-3 rounded-pill">
                                                            <i class="bi bi-pencil-square me-2"></i> AJUSTAR CUPO
                                                        </button>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <% if (cliente.email) { %>
                                                            <button onclick="enviarCorreoPreaprobado(<%= cliente.id %>)" 
                                                                    id="btnSendPre" 
                                                                    class="btn btn-warning w-100 fw-bold py-3 rounded-pill shadow-sm"
                                                                    <%= cliente.monto_preaprobado > 0 ? '' : 'disabled' %>>
                                                                <i class="bi bi-envelope-check-fill me-2"></i> NOTIFICAR CLIENTE
                                                            </button>
                                                        <% } else { %>
                                                            <div class="alert alert-light border small text-muted mb-0 h-100 d-flex align-items-center justify-content-center">
                                                                <i class="bi bi-info-circle me-2"></i> Registra un email para notificar.
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </div>

                                                <hr class="my-4">
                                                
                                                <div class="d-flex align-items-start gap-3">
                                                    <div class="bg-light p-3 rounded-circle">
                                                        <i class="bi bi-lightning-charge-fill text-warning fs-4"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="fw-bold mb-1">Beneficio de Pre-aprobación</h6>
                                                        <p class="small text-muted mb-0">Al asignar un cupo, el sistema habilita al cliente para solicitar desembolsos rápidos sin necesidad de re-evaluar documentos.</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
            </div>
        </div>
        <%- include('../partials/footer') %>
        <script>
            function enviarCorreoPreaprobado(clienteId) {
                const btn = document.getElementById('btnSendPre');
                const originalHtml = btn.innerHTML;
                
                Swal.fire({
                    title: '¿Enviar Notificación?',
                    text: "¿Deseas enviar un correo al cliente informándole sobre su cupo pre-aprobado?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3b82f6',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, enviar ahora',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Enviando...';

                        fetch(`/clientes/enviar-preaprobado/${clienteId}`)
                            .then(res => res.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire('¡Enviado!', 'La notificación ha sido enviada correctamente.', 'success');
                                } else {
                                    Swal.fire('Error', data.mensaje || 'No se pudo enviar el correo.', 'error');
                                }
                            })
                            .catch(err => {
                                console.error(err);
                                Swal.fire('Error', 'Ocurrió un error en la conexión.', 'error');
                            })
                            .finally(() => {
                                btn.disabled = false;
                                btn.innerHTML = originalHtml;
                            });
                    }
                });
            }

            function editarCupoPreaprobado(clienteId, montoActual) {
                Swal.fire({
                    title: 'Ajustar Cupo Pre-aprobado',
                    input: 'text',
                    inputLabel: 'Ingrese el nuevo monto disponible',
                    inputValue: montoActual,
                    placeholder: '0',
                    showCancelButton: true,
                    confirmButtonText: 'Guardar Cambios',
                    cancelButtonText: 'Cancelar',
                    didOpen: () => {
                        const input = Swal.getInput();
                        // Aplicar máscara de moneda al input del modal
                        if (window.applyCurrencyMask) {
                            input.classList.add('money-mask');
                            applyCurrencyMask('.money-mask');
                        }
                    },
                    inputValidator: (value) => {
                        if (!value && value !== '0') {
                            return '¡Debes ingresar un monto!';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch(`/clientes/actualizar-preaprobado/${clienteId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ monto: result.value })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('¡Actualizado!', 'El cupo ha sido actualizado.', 'success').then(() => {
                                    location.reload(); // Recargar para ver los cambios
                                });
                            } else {
                                Swal.fire('Error', data.mensaje, 'error');
                            }
                        });
                    }
                });
            }
        </script>
    </body>
</html>