                                                                Consistencia de Ahorro
                                                                <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.8rem;" onclick="explicarRegla('ahorros')"></i>
                                                            </span>
                                                            <span class="badge bg-success bg-opacity-10 text-success fw-bold" id="desgloseAhorrosConsistenciaAdminMob">+<%= scoreData.desglose.ahorrosConsistencia || 0 %> pts</span>
