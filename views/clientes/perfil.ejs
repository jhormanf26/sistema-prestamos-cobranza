                                                        <div class="d-flex justify-content-between align-items-center mt-2 small">
                                                            <span class="text-muted">Impacto: +10 pts por depósito reciente >= $10k, máx 30</span>
                                                            <span class="text-dark fw-bold" id="detalleAhorrosConsistenciaAdminMob"><%= scoreData.detalles.ahorrosDepositos90d || 0 %> depósitos</span>
