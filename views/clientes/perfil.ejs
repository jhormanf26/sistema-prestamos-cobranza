                                                                </td>
                                                                <td class="text-center fw-bold <%= (scoreData.desglose.reincidenciaMora || 0) < 0 ? 'text-danger' : 'text-muted' %>" id="desgloseReincidenciaAdmin"><%= scoreData.desglose.reincidenciaMora || 0 %> pts</td>
                                                                <td class="text-center text-muted" id="detalleReincidenciaAdmin">
                                                                    <%= scoreData.detalles.totalCuotasConDemoraHistoricas || 0 %> cuotas tardías
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <div class="d-block d-md-none mb-4">
