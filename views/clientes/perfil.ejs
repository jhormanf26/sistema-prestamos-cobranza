<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>

    <body>
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <%- include('../partials/sidebar') %>

                    <div class="col py-3">
                        <div class="container-fluid px-4 py-4">

                            <div class="card card-box mb-4 border-primary border-top border-4">
                                <div class="card-body d-flex align-items-center flex-wrap gap-3">

                                    <div class="me-2">
                                        <% if (cliente.foto) { %>
                                            <img src="/uploads/<%= cliente.foto %>"
                                                class="rounded-circle border border-3 border-white shadow-sm"
                                                style="width: 100px; height: 100px; object-fit: cover;">
                                            <% } else { %>
                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                                    style="width: 100px; height: 100px; font-size: 2.5rem;">
                                                    <%= cliente.nombre.charAt(0) %>
                                                </div>
                                                <% } %>
                                    </div>

                                    <div class="flex-grow-1">
                                        <h2 class="mb-0 fw-bold">
                                            <%= cliente.nombre %>
                                                <%= cliente.apellido %>
                                        </h2>
                                        <p class="text-muted mb-2">CC: <strong>
                                                <%= cliente.dni %>
                                            </strong></p>

                                        <div class="d-flex gap-2 flex-wrap">
                                            <span class="badge bg-light text-dark border"><i
                                                    class="bi bi-geo-alt-fill text-danger"></i>
                                                <%= cliente.direccion || 'Sin dirección' %>
                                            </span>
                                            <span class="badge bg-light text-dark border"><i
                                                    class="bi bi-telephone-fill text-success"></i>
                                                <%= cliente.telefono || 'Sin teléfono' %>
                                            </span>
                                            <span class="badge bg-light text-dark border"><i
                                                    class="bi bi-envelope-fill text-primary"></i>
                                                <%= cliente.email || 'Sin email' %>
                                            </span>
                                            <span class="badge bg-light text-dark border" title="Última vez que el cliente ingresó a su portal">
                                                <i class="bi bi-person-badge-fill text-info"></i>
                                                Último acceso: <%= cliente.ultimo_login ? new Date(cliente.ultimo_login).toLocaleString() : 'Nunca' %>
                                            </span>
                                            <% if (cliente.app_instalada) { %>
                                                <span class="badge bg-primary text-white border border-primary shadow-sm" title="El cliente ha instalado la aplicación">
                                                    <i class="bi bi-phone-fill text-white"></i> APP INSTALADA
                                                </span>
                                            <% } %>
                                            <% if (cliente.monto_preaprobado > 0) { %>
                                                <span class="badge bg-warning text-dark border border-warning shadow-sm" title="Cupo disponible para nuevos créditos">
                                                    <i class="bi bi-star-fill text-primary"></i> PRE-APROBADO: <%= empresa.moneda %> <%= formatCurrency(cliente.monto_preaprobado, 0) %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="text-end mt-3 mt-md-0 d-flex gap-2">
                                        <% if (cliente.monto_preaprobado > 0 && cliente.email) { %>
                                            <button onclick="enviarCorreoPreaprobado(<%= cliente.id %>)" 
                                                    class="btn btn-primary shadow-sm px-4 fw-bold rounded-pill"
                                                    id="btnSendPre">
                                                <i class="bi bi-envelope-check-fill me-2"></i> Notificar Pre-aprobado
                                            </button>
                                        <% } %>
                                        <button onclick="iniciarChat(<%= cliente.id %>)" class="btn btn-success shadow-sm px-4 fw-bold rounded-pill">
                                            <i class="bi bi-chat-dots-fill me-2"></i> Mensaje Directo
                                        </button>
                                        <a href="/reportes/estado-cuenta/<%= cliente.id %>" target="_blank"
                                            class="btn btn-dark shadow-sm px-4 fw-bold rounded-pill">
                                            <i class="bi bi-file-earmark-bar-graph-fill me-2"></i> Estado de Cuenta
                                        </a>
                                        <a href="/clientes" class="btn btn-outline-secondary px-3 rounded-pill" title="Volver al listado">
                                            <i class="bi bi-arrow-left"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>                            <ul class="nav nav-tabs mb-3" id="clientTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="prestamos-tab" data-bs-toggle="tab"
                                        data-bs-target="#prestamos" type="button">
                                        <i class="bi bi-cash-stack"></i> Préstamos (<%= prestamos.length %>)
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="empenos-tab" data-bs-toggle="tab"
                                        data-bs-target="#empenos" type="button">
                                        <i class="bi bi-gem"></i> Empeños (<%= empenos.length %>)
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="ahorros-tab" data-bs-toggle="tab"
                                        data-bs-target="#ahorros" type="button">
                                        <i class="bi bi-piggy-bank"></i> Ahorros
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="preaprobados-tab" data-bs-toggle="tab"
                                        data-bs-target="#preaprobados" type="button">
                                        <i class="bi bi-star-fill text-warning"></i> Pre-aprobados
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="documentos-tab" data-bs-toggle="tab"
                                        data-bs-target="#documentos" type="button">
                                        <i class="bi bi-file-earmark-pdf-fill"></i> Documentos (<%= documentos.length %>)
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content" id="clientTabsContent">
                                <!-- Tab Préstamos -->
                                <div class="tab-pane fade show active" id="prestamos" role="tabpanel">
                                    <div class="card card-box p-0 border-0 shadow-sm overflow-hidden">
                                        <% if(prestamos.length > 0) { %>
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0">
                                                    <thead class="table-light text-uppercase small fw-bold">
                                                        <tr>
                                                            <th>ID</th>
                                                            <th>Fecha</th>
                                                            <th>Prestado</th>
                                                            <th>Pagado</th>
                                                            <th>Saldo</th>
                                                            <th>Estado</th>
                                                            <th class="text-end pe-3">Acción</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% prestamos.forEach(p => { 
                                                            const pagado = p.total_pagado || 0;
                                                            const saldo = p.monto_total - pagado;
                                                        %>
                                                        <tr>
                                                            <td><span class="badge bg-dark">#<%= p.id %></span></td>
                                                            <td><%= new Date(p.fecha_inicio).toLocaleDateString() %></td>
                                                            <td class="small fw-bold"><%= empresa.moneda %> <%= formatCurrency(p.monto_prestado, 2) %></td>
                                                            <td class="text-primary fw-bold"><%= empresa.moneda %> <%= formatCurrency(pagado, 2) %></td>
                                                            <td class="text-danger fw-bold"><%= empresa.moneda %> <%= formatCurrency(saldo, 2) %></td>
                                                            <td>
                                                                <% if(p.estado == 'pendiente') { %>
                                                                    <span class="badge bg-warning text-dark px-2 rounded-pill">PENDIENTE</span>
                                                                <% } else if(p.estado == 'pagado') { %>
                                                                    <span class="badge bg-success px-2 rounded-pill">PAGADO</span>
                                                                <% } else { %>
                                                                    <span class="badge bg-danger px-2 rounded-pill">VENCIDO</span>
                                                                <% } %>
                                                            </td>
                                                            <td class="text-end pe-3">
                                                                <a href="/pagos/registrar/<%= p.id %>" class="btn btn-outline-success btn-sm"><i class="bi bi-cash"></i></a>
                                                                <a href="/prestamos/cronograma/<%= p.id %>" class="btn btn-outline-primary btn-sm"><i class="bi bi-calendar3"></i></a>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        <% } else { %>
                                            <div class="text-center py-5 text-muted">No hay historial de préstamos.</div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Tab Empeños -->
                                <div class="tab-pane fade" id="empenos" role="tabpanel">
                                    <div class="card card-box p-3 border-0 shadow-sm">
                                        <% if(empenos.length > 0) { %>
                                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                                <% empenos.forEach(e => { %>
                                                    <div class="col">
                                                        <div class="border rounded p-3 d-flex align-items-center bg-white shadow-sm">
                                                            <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center border" style="width: 50px; height: 50px;">
                                                                <i class="bi bi-gem fs-4 text-primary"></i>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <h6 class="mb-0 fw-bold"><%= e.nombre_articulo %></h6>
                                                                <small class="text-muted"><%= e.descripcion %></small>
                                                            </div>
                                                            <div class="text-end">
                                                                <span class="badge bg-primary d-block mb-1"><%= empresa.moneda %> <%= formatCurrency(e.monto_prestado, 2) %></span>
                                                                <span class="badge bg-info text-dark small"><%= e.estado %></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <div class="text-center py-5 text-muted">No hay empeños registrados.</div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Tab Ahorros -->
                                <div class="tab-pane fade" id="ahorros" role="tabpanel">
                                    <div class="card card-box p-4 text-center border-0 shadow-sm">
                                        <% if(cuentaAhorro) { %>
                                            <h6 class="text-muted text-uppercase mb-1">Saldo de Ahorros</h6>
                                            <h2 class="text-success fw-bold mb-3"><%= empresa.moneda %> <%= formatCurrency(cuentaAhorro.saldo_actual, 2) %></h2>
                                            <a href="/ahorros/ver/<%= cuentaAhorro.id %>" class="btn btn-primary px-4 btn-sm">Ver Movimientos</a>
                                        <% } else { %>
                                            <p class="text-muted">Sin cuenta de ahorros activa.</p>
                                            <a href="/ahorros/aperturar" class="btn btn-outline-primary btn-sm">Aperturar Cuenta</a>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Tab Pre-aprobados (NUEVA PESTAÑA) -->
                                <div class="tab-pane fade" id="preaprobados" role="tabpanel">
                                    <div class="card card-box border-0 shadow-sm overflow-hidden">
                                        <div class="row g-0">
                                            <div class="col-md-4 bg-primary text-white d-flex flex-column align-items-center justify-content-center p-5">
                                                <i class="bi bi-star-fill display-1 mb-3 opacity-50"></i>
                                                <h4 class="fw-bold">Cupo Especial</h4>
                                                <p class="small text-center opacity-75">Créditos de aprobación instantánea para clientes premium.</p>
                                            </div>
                                            <div class="col-md-8 p-5">
                                                <div class="text-center mb-4">
                                                    <p class="text-muted small mb-1 text-uppercase fw-bold">Cupo Disponible Actualmente</p>
                                                    <h1 id="montoPreDisplay" class="fw-bold text-primary mb-0" style="font-size: 3.5rem;">
                                                        <%= empresa.moneda %> <%= formatCurrency(cliente.monto_preaprobado || 0, 0) %>
                                                    </h1>
                                                </div>

                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <button onclick="editarCupoPreaprobado(<%= cliente.id %>, '<%= cliente.monto_preaprobado %>')" 
                                                                class="btn btn-outline-primary w-100 fw-bold py-3 rounded-pill">
                                                            <i class="bi bi-pencil-square me-2"></i> AJUSTAR CUPO
                                                        </button>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <% if (cliente.email) { %>
                                                            <button onclick="enviarCorreoPreaprobado(<%= cliente.id %>)" 
                                                                    id="btnSendPre" 
                                                                    class="btn btn-warning w-100 fw-bold py-3 rounded-pill shadow-sm"
                                                                    <%= cliente.monto_preaprobado > 0 ? '' : 'disabled' %>>
                                                                <i class="bi bi-envelope-check-fill me-2"></i> NOTIFICAR CLIENTE
                                                            </button>
                                                        <% } else { %>
                                                            <div class="alert alert-light border small text-muted mb-0 h-100 d-flex align-items-center justify-content-center">
                                                                <i class="bi bi-info-circle me-2"></i> Registra un email para notificar.
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </div>

                                                <hr class="my-4">
                                                
                                                <div class="d-flex align-items-start gap-3">
                                                    <div class="bg-light p-3 rounded-circle">
                                                        <i class="bi bi-lightning-charge-fill text-warning fs-4"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="fw-bold mb-1">Beneficio de Pre-aprobación</h6>
                                                        <p class="small text-muted mb-0">Al asignar un cupo, el sistema habilita al cliente para solicitar desembolsos rápidos sin necesidad de re-evaluar documentos.</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Tab Documentos (NUEVA PESTAÑA) -->
                                <div class="tab-pane fade" id="documentos" role="tabpanel">
                                    <div class="card card-box border-0 shadow-sm p-4">
                                        <div class="row g-4">
                                            <!-- Listado de Documentos -->
                                            <div class="col-md-7">
                                                <h5 class="fw-bold mb-3"><i class="bi bi-folder-fill text-warning me-2"></i> Expediente Digital</h5>
                                                
                                                <% if (documentos && documentos.length > 0) { %>
                                                    <div class="table-responsive">
                                                        <table class="table table-hover align-middle">
                                                            <thead class="table-light text-uppercase small fw-bold">
                                                                <tr>
                                                                    <th>Documento</th>
                                                                    <th>Origen</th>
                                                                    <th>Fecha</th>
                                                                    <th>Estado</th>
                                                                    <th class="text-end">Acciones</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% documentos.forEach(doc => { %>
                                                                    <tr>
                                                                        <td>
                                                                            <div class="d-flex align-items-center gap-2">
                                                                                <i class="bi <%= doc.archivo_url.toLowerCase().endsWith('.pdf') ? 'bi-file-pdf text-danger' : 'bi-image text-primary' %> fs-4"></i>
                                                                                <div>
                                                                                    <span class="fw-bold d-block"><%= doc.nombre_documento %></span>
                                                                                    <a href="<%= doc.archivo_url %>" target="_blank" class="small text-decoration-none">Abrir archivo <i class="bi bi-box-arrow-up-right"></i></a>
                                                                                </div>
                                                                            </div>
                                                                        </td>
                                                                        <td>
                                                                            <span class="badge bg-light text-dark border">
                                                                                <%= doc.subido_por === 'cliente' ? 'Cliente' : 'Administrador' %>
                                                                            </span>
                                                                        </td>
                                                                        <td><span class="small text-muted"><%= new Date(doc.fecha_subida).toLocaleDateString() %></span></td>
                                                                        <td>
                                                                            <% if (doc.estado === 'pendiente') { %>
                                                                                <span class="badge bg-warning text-dark px-2 rounded-pill">PENDIENTE</span>
                                                                            <% } else if (doc.estado === 'aprobado') { %>
                                                                                <span class="badge bg-success px-2 rounded-pill animate-pulse">APROBADO</span>
                                                                            <% } else { %>
                                                                                <span class="badge bg-danger px-2 rounded-pill" title="Motivo: <%= doc.motivo_rechazo %>">RECHAZADO</span>
                                                                                <% if (doc.motivo_rechazo) { %>
                                                                                    <div class="small text-danger mt-1" style="font-size: 0.75rem; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= doc.motivo_rechazo %></div>
                                                                                <% } %>
                                                                            <% } %>
                                                                        </td>
                                                                        <td class="text-end">
                                                                            <div class="d-flex gap-1 justify-content-end">
                                                                                <% if (doc.estado !== 'aprobado') { %>
                                                                                    <button onclick="aprobarDoc(<%= doc.id %>)" class="btn btn-sm btn-outline-success" title="Aprobar"><i class="bi bi-check-lg"></i></button>
                                                                                <% } %>
                                                                                <% if (doc.estado !== 'rechazado') { %>
                                                                                    <button onclick="rechazarDoc(<%= doc.id %>)" class="btn btn-sm btn-outline-danger" title="Rechazar"><i class="bi bi-x-lg"></i></button>
                                                                                <% } %>
                                                                                <button onclick="eliminarDoc(<%= doc.id %>)" class="btn btn-sm btn-outline-secondary" title="Eliminar"><i class="bi bi-trash"></i></button>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                <% }) %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                <% } else { %>
                                                    <div class="text-center py-5 border rounded-4 bg-light">
                                                        <i class="bi bi-folder2-open display-6 text-muted mb-2"></i>
                                                        <p class="text-muted small mb-0">No hay documentos en el expediente de este cliente.</p>
                                                    </div>
                                                <% } %>
                                            </div>

                                            <!-- Subir Documento desde Admin -->
                                            <div class="col-md-5 border-start">
                                                <h5 class="fw-bold mb-3"><i class="bi bi-cloud-arrow-up-fill text-primary me-2"></i> Añadir al Expediente</h5>
                                                <p class="text-muted small">Puedes cargar documentos digitalizados directamente al expediente del cliente. Estos se marcarán como aprobados automáticamente.</p>
                                                
                                                <form action="/admin/documentos/subir/<%= cliente.id %>" method="POST" enctype="multipart/form-data" class="bg-light p-3 rounded-4 border">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold small text-muted">Tipo de Documento</label>
                                                        <select name="nombre_documento" class="form-select" required>
                                                            <option value="Cédula de Identidad">Cédula de Ciudadanía / Identidad</option>
                                                            <option value="Comprobante de Domicilio">Comprobante de Domicilio</option>
                                                            <option value="Certificación Laboral">Certificación Laboral</option>
                                                            <option value="Historial Crediticio">Historial Crediticio</option>
                                                            <option value="Otro Documento">Otro</option>
                                                        </select>
                                                    </div>
                                                    
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold small text-muted">Seleccionar Archivo (PDF/Imagen)</label>
                                                        <input type="file" name="documento" class="form-control" accept="application/pdf, image/*" required>
                                                    </div>
                                                    
                                                    <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill">
                                                        <i class="bi bi-upload me-2"></i> CARGAR Y APROBAR
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
            </div>
        </div>
        <%- include('../partials/footer') %>
        <script>
            function enviarCorreoPreaprobado(clienteId) {
                const btn = document.getElementById('btnSendPre');
                const originalHtml = btn.innerHTML;
                
                Swal.fire({
                    title: '¿Enviar Notificación?',
                    text: "¿Deseas enviar un correo al cliente informándole sobre su cupo pre-aprobado?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3b82f6',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, enviar ahora',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Enviando...';

                        fetch(`/clientes/enviar-preaprobado/${clienteId}`)
                            .then(res => res.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire('¡Enviado!', 'La notificación ha sido enviada correctamente.', 'success');
                                } else {
                                    Swal.fire('Error', data.mensaje || 'No se pudo enviar el correo.', 'error');
                                }
                            })
                            .catch(err => {
                                console.error(err);
                                Swal.fire('Error', 'Ocurrió un error en la conexión.', 'error');
                            })
                            .finally(() => {
                                btn.disabled = false;
                                btn.innerHTML = originalHtml;
                            });
                    }
                });
            }

            function iniciarChat(clienteId) {
                Swal.fire({
                    title: 'Enviar Mensaje Directo',
                    input: 'textarea',
                    inputLabel: 'Escribe el mensaje para iniciar o continuar la conversación',
                    inputPlaceholder: 'Hola, te escribimos para...',
                    showCancelButton: true,
                    confirmButtonText: 'Enviar Mensaje',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#10b981',
                    inputValidator: (value) => {
                        if (!value || value.trim().length === 0) {
                            return '¡Debes escribir un mensaje!';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Enviando...',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                        fetch(`/admin/soporte/chat/${clienteId}/responder`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ mensaje: result.value })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('¡Enviado!', 'El mensaje fue enviado correctamente. Redirigiendo al chat...', 'success').then(() => {
                                    window.location.href = '/admin/soporte'; // Redirigir a soporte
                                });
                            } else {
                                Swal.fire('Error', data.error || 'No se pudo enviar el mensaje.', 'error');
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.fire('Error', 'Ocurrió un error en la conexión.', 'error');
                        });
                    }
                });
            }

            function editarCupoPreaprobado(clienteId, montoActual) {
                Swal.fire({
                    title: 'Ajustar Cupo Pre-aprobado',
                    input: 'text',
                    inputLabel: 'Ingrese el nuevo monto disponible',
                    inputValue: montoActual,
                    placeholder: '0',
                    showCancelButton: true,
                    confirmButtonText: 'Guardar Cambios',
                    cancelButtonText: 'Cancelar',
                    didOpen: () => {
                        const input = Swal.getInput();
                        // Aplicar máscara de moneda al input del modal
                        if (window.applyCurrencyMask) {
                            input.classList.add('money-mask');
                            applyCurrencyMask('.money-mask');
                        }
                    },
                    inputValidator: (value) => {
                        if (!value && value !== '0') {
                            return '¡Debes ingresar un monto!';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch(`/clientes/actualizar-preaprobado/${clienteId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ monto: result.value })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('¡Actualizado!', 'El cupo ha sido actualizado.', 'success').then(() => {
                                    location.reload(); // Recargar para ver los cambios
                                });
                            } else {
                                Swal.fire('Error', data.mensaje, 'error');
                            }
                        });
                    }
                });
            }

            // --- GESTIÓN DE DOCUMENTOS ---
            function aprobarDoc(docId) {
                Swal.fire({
                    title: '¿Aprobar Documento?',
                    text: "El cliente será notificado de la aprobación de su documento.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#10b981',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, aprobar ahora',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Procesando...',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });
                        fetch(`/admin/documentos/estado/${docId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ estado: 'aprobado' })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('¡Aprobado!', 'El documento ha sido aprobado.', 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', data.error, 'error');
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.fire('Error', 'Conexión fallida.', 'error');
                        });
                    }
                });
            }

            function rechazarDoc(docId) {
                Swal.fire({
                    title: '¿Rechazar Documento?',
                    input: 'textarea',
                    inputLabel: 'Ingresa el motivo del rechazo para notificar al cliente',
                    inputPlaceholder: 'Ej: El documento está borroso o incompleto...',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Rechazar',
                    cancelButtonText: 'Cancelar',
                    inputValidator: (value) => {
                        if (!value || value.trim().length === 0) {
                            return '¡Debes ingresar un motivo para el rechazo!';
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Procesando...',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });
                        fetch(`/admin/documentos/estado/${docId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ estado: 'rechazado', motivo_rechazo: result.value })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('Rechazado', 'El documento ha sido rechazado y el cliente notificado.', 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', data.error, 'error');
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.fire('Error', 'Conexión fallida.', 'error');
                        });
                    }
                });
            }

            function eliminarDoc(docId) {
                Swal.fire({
                    title: '¿Eliminar Documento?',
                    text: "Esta acción no se puede deshacer. Se borrará el archivo de forma definitiva.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Eliminando...',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });
                        fetch(`/admin/documentos/eliminar/${docId}`, {
                            method: 'DELETE'
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('¡Eliminado!', 'El documento ha sido borrado.', 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', data.error, 'error');
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.fire('Error', 'Conexión fallida.', 'error');
                        });
                    }
                });
            }
        </script>
    </body>
</html>