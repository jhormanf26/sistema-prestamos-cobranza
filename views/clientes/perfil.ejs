                        dComportamientoMob.textContent = `${sd.desglose.comportamientoPago > 0 ? '+' : ''}${sd.desglose.comportamientoPago} pts`;
                        dComportamientoMob.className = `badge ${sd.desglose.comportamientoPago < 0 ? 'bg-danger text-danger bg-opacity-10' : (sd.desglose.comportamientoPago > 0 ? 'bg-success text-success bg-opacity-10' : 'bg-light text-muted')} fw-bold`;

                        const dReincidenciaMob = document.getElementById('desgloseReincidenciaAdminMob');
