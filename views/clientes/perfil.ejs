                        // Actualizar Detalle (Móvil)
                        document.getElementById('detallePagosAdminMob').textContent = `${sd.detalles.prestamosPagadosATiempoCount} préstamos`;
                        document.getElementById('detalleAhorrosSaldoAdminMob').textContent = `${sd.detalles.ahorroSaldo.toLocaleString('es-CO')}`;
