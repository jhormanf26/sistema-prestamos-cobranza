                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('Rechazado', 'El documento ha sido rechazado y el cliente notificado.', 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', data.error, 'error');
                            }
