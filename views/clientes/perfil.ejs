            function eliminarDoc(docId) {
                Swal.fire({
                    title: '¿Eliminar Documento?',
                    text: "Esta acción no se puede deshacer. Se borrará el archivo de forma definitiva.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Eliminando...',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });
                        fetch(`/admin/documentos/eliminar/${docId}`, {
                            method: 'DELETE'
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('¡Eliminado!', 'El documento ha sido borrado.', 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', data.error, 'error');
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.fire('Error', 'Conexión fallida.', 'error');
                        });
                    }
                });
            }

            async function recalcularScoreAdmin(clienteId) {
                const btn = document.getElementById('btnRecalcularScoreAdmin');
                const icon = document.getElementById('iconRecalcularScoreAdmin');
                const ring = document.getElementById('scoreProgressRingAdmin');
                const scoreEl = document.getElementById('scoreTextAdmin');
                const valContainer = document.getElementById('scoreValueContainerAdmin');
                const loaderContainer = document.getElementById('scoreLoaderContainerAdmin');
                
                if (!btn || btn.disabled) return;

                btn.disabled = true;
                icon.style.animation = 'spin 1s linear infinite';

                // Guardar valores originales
                const originalOffset = ring.style.strokeDashoffset;
                const originalColor = ring.getAttribute('stroke');

                // Agregar estilo spin si no existe
                if (!document.getElementById('spinStyleAdmin')) {
                    const style = document.createElement('style');
                    style.id = 'spinStyleAdmin';
                    style.innerHTML = `
                        @keyframes spin {
                            0% { transform: rotate(0deg); }
                            100% { transform: rotate(360deg); }
                        }
                    `;
                    document.head.appendChild(style);
                }

                // 1. Ocultar el valor actual con transición de escala y opacidad
                valContainer.style.opacity = '0';
                valContainer.style.transform = 'translate(-50%, -50%) scale(0.7)';

                // 2. Vaciar el círculo de progreso de forma fluida
                ring.style.transition = 'stroke-dashoffset 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
                ring.style.strokeDashoffset = '427';

                // 3. Mostrar el loader central premium
                setTimeout(() => {
                    if (btn.disabled) {
                        loaderContainer.style.opacity = '1';
                        loaderContainer.style.transform = 'translate(-50%, -50%) scale(1)';
                    }
                }, 150);

                try {
                    const response = await fetch(`/clientes/recalcular-score/${clienteId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const data = await response.json();

                    // Mínimo de tiempo de carga para apreciar la animación premium y fluida
                    await new Promise(resolve => setTimeout(resolve, 1200));

                    if (data.success) {
                        const sd = data.scoreData;
                        window.scoreDataAuditoria = sd;

                        // 1. Ocultar el loader central
                        loaderContainer.style.opacity = '0';
                        loaderContainer.style.transform = 'translate(-50%, -50%) scale(0.7)';

                        // Esperar a que se oculte el loader antes de mostrar el nuevo valor
                        await new Promise(resolve => setTimeout(resolve, 200));

                        // 2. Preparar y mostrar el valor definitivo desde escala reducida
                        scoreEl.textContent = '0';
                        valContainer.style.transform = 'translate(-50%, -50%) scale(0.7)';
                        valContainer.getBoundingClientRect(); // Reflow
                        valContainer.style.opacity = '1';
                        valContainer.style.transform = 'translate(-50%, -50%) scale(1)';

                        // 3. Rellenar el círculo al nuevo valor con efecto elástico premium
                        ring.style.transition = 'stroke-dashoffset 1.8s cubic-bezier(0.34, 1.56, 0.64, 1), stroke 1s ease';
                        ring.setAttribute('stroke', sd.circularColor);
                        const offset = 427 - (427 * sd.score / 1000);
                        ring.style.strokeDashoffset = offset;

                        // 4. Animación interactiva de Conteo de Puntos
                        const start = 0;
                        const end = sd.score;
                        const duration = 1500;
                        const startTime = performance.now();

                        function animate(now) {
                            const elapsed = now - startTime;
                            const progress = Math.min(elapsed / duration, 1);
                            const easeProgress = 1 - Math.pow(1 - progress, 3); // Cubic Out
                            const current = Math.floor(start + easeProgress * (end - start));
                            scoreEl.textContent = current;
                            if (progress < 1) {
                                requestAnimationFrame(animate);
                            } else {
                                scoreEl.textContent = end;
                            }
                        }
                        requestAnimationFrame(animate);

                        // Actualizar nivel y fecha
                        document.getElementById('scoreNivelAdmin').className = `badge ${sd.badgeBg} text-white px-3 py-1.5 rounded-pill shadow-sm`;
                        document.getElementById('scoreNivelAdmin').textContent = `Score: ${sd.nivel} (${sd.categoria})`;
                        document.getElementById('scoreFechaAdmin').textContent = `Cálculo: ${new Date(sd.fechaCalculo).toLocaleDateString()}`;

                        // Actualizar Desglose (Desktop)
                        document.getElementById('desglosePagosAdmin').textContent = `+${sd.desglose.pagadosATiempo} pts`;
                        document.getElementById('desgloseAhorrosSaldoAdmin').textContent = `+${sd.desglose.ahorrosSaldo || 0} pts`;
                        document.getElementById('desgloseAhorrosConsistenciaAdmin').textContent = `+${sd.desglose.ahorrosConsistencia || 0} pts`;
                        document.getElementById('desgloseAntiguedadAdmin').textContent = `+${sd.desglose.antiguedad} pts`;

                        const dVencidos = document.getElementById('desgloseVencidosAdmin');
                        dVencidos.textContent = `${sd.desglose.prestamosVencidos} pts`;
                        dVencidos.className = `text-center fw-bold ${sd.desglose.prestamosVencidos < 0 ? 'text-danger' : 'text-muted'}`;

                        const dCuotas = document.getElementById('desgloseCuotasAdmin');
                        dCuotas.textContent = `${sd.desglose.cuotasVencidas} pts`;
                        dCuotas.className = `text-center fw-bold ${sd.desglose.cuotasVencidas < 0 ? 'text-danger' : 'text-muted'}`;

                        const dComportamiento = document.getElementById('desgloseComportamientoAdmin');
                        dComportamiento.textContent = `${sd.desglose.comportamientoPago > 0 ? '+' : ''}${sd.desglose.comportamientoPago} pts`;
                        dComportamiento.className = `text-center fw-bold ${sd.desglose.comportamientoPago < 0 ? 'text-danger' : (sd.desglose.comportamientoPago > 0 ? 'text-success' : 'text-muted')}`;

                        const dReincidencia = document.getElementById('desgloseReincidenciaAdmin');
                        dReincidencia.textContent = `${sd.desglose.reincidenciaMora || 0} pts`;
                        dReincidencia.className = `text-center fw-bold ${sd.desglose.reincidenciaMora < 0 ? 'text-danger' : 'text-muted'}`;

                        // Actualizar Detalle (Desktop)
                        document.getElementById('detallePagosAdmin').textContent = `${sd.detalles.prestamosPagadosATiempoCount} préstamos`;
                        document.getElementById('detalleAhorrosSaldoAdmin').textContent = `${sd.detalles.ahorroSaldo.toLocaleString('es-CO')}`;
                        document.getElementById('detalleAhorrosConsistenciaAdmin').textContent = `${sd.detalles.ahorrosDepositos90d || 0} depósitos`;
                        document.getElementById('detalleAntiguedadAdmin').textContent = `${sd.detalles.antiguedadMeses} meses`;
                        document.getElementById('detalleVencidosAdmin').textContent = `${sd.detalles.prestamosVencidosCount} préstamos`;
                        document.getElementById('detalleCuotasAdmin').textContent = `${sd.detalles.cuotasAtrasadasCount} (< 30d) / ${sd.detalles.cuotasAtrasadas30Count} (> 30d)`;
                        document.getElementById('detalleComportamientoAdmin').textContent = `${sd.detalles.comportamientoPagoDetalle ? sd.detalles.comportamientoPagoDetalle.length : 0} cuotas`;
                        document.getElementById('detalleReincidenciaAdmin').textContent = `${sd.detalles.totalCuotasConDemoraHistoricas || 0} cuotas tardías`;

                        // Actualizar Desglose (Móvil)
                        document.getElementById('desglosePagosAdminMob').textContent = `+${sd.desglose.pagadosATiempo} pts`;
                        document.getElementById('desgloseAhorrosSaldoAdminMob').textContent = `+${sd.desglose.ahorrosSaldo || 0} pts`;
                        document.getElementById('desgloseAhorrosConsistenciaAdminMob').textContent = `+${sd.desglose.ahorrosConsistencia || 0} pts`;
                        document.getElementById('desgloseAntiguedadAdminMob').textContent = `+${sd.desglose.antiguedad} pts`;

                        const dVencidosMob = document.getElementById('desgloseVencidosAdminMob');
                        dVencidosMob.textContent = `${sd.desglose.prestamosVencidos} pts`;
                        dVencidosMob.className = `badge ${sd.desglose.prestamosVencidos < 0 ? 'bg-danger text-danger bg-opacity-10' : 'bg-light text-muted'} fw-bold`;

                        const dCuotasMob = document.getElementById('desgloseCuotasAdminMob');
                        dCuotasMob.textContent = `${sd.desglose.cuotasVencidas} pts`;
