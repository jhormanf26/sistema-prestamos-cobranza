                                                    <div class="card border border-light shadow-sm rounded-4 mb-2 p-3 bg-white">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span class="fw-bold text-dark">
                                                                Préstamos en mora/vencidos
                                                                <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.8rem;" onclick="explicarRegla('vencidos')"></i>
                                                            </span>
                                                            <span class="badge <%= scoreData.desglose.prestamosVencidos < 0 ? 'bg-danger text-danger bg-opacity-10' : 'bg-light text-muted' %> fw-bold" id="desgloseVencidosAdminMob"><%= scoreData.desglose.prestamosVencidos %> pts</span>
                                                        </div>
                                                        <div class="d-flex justify-content-between align-items-center mt-2 small">
