                                                                </td>
                                                                <td class="text-center fw-bold text-dark">500 pts</td>
                                                                <td class="text-center text-muted">Estándar</td>
                                                            </tr>
                                                            <tr>
                                                                <td class="text-dark">
                                                                    Préstamos pagados a tiempo (+100 pts c/u, máx 300)
                                                                    <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.85rem;" onclick="explicarRegla('pagos')" title="Saber más"></i>
                                                                </td>
                                                                <td class="text-center fw-bold text-success" id="desglosePagosAdmin">+<%= scoreData.desglose.pagadosATiempo %> pts</td>
                                                                <td class="text-center text-muted">
                                                                    <span id="detallePagosAdmin"><%= scoreData.detalles.prestamosPagadosATiempoCount %> préstamos</span>
                                                                    <button type="button" class="btn btn-sm btn-link text-success p-0 ms-2" onclick="auditarPagadosATiempo()" title="Auditar préstamos pagados a tiempo"><i class="bi bi-eye-fill"></i></button>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="text-dark">
                                                                    Saldo en Cuenta de Ahorro (+10 pts por cada $100.000, máx 70)
                                                                    <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.85rem;" onclick="explicarRegla('ahorros')" title="Saber más"></i>
                                                                </td>
                                                                <td class="text-center fw-bold text-success" id="desgloseAhorrosSaldoAdmin">+<%= scoreData.desglose.ahorrosSaldo || 0 %> pts</td>
                                                                <td class="text-center text-muted" id="detalleAhorrosSaldoAdmin"><%= empresa.moneda %> <%= formatCurrency(scoreData.detalles.ahorroSaldo, 0) %></td>
                                                            </tr>
                                                            <tr>
                                                                <td class="text-dark">
                                                                    Consistencia de Ahorro (+10 pts por depósito reciente >= $10.000, máx 30)
                                                                    <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.85rem;" onclick="explicarRegla('ahorros')" title="Saber más"></i>
                                                                </td>
                                                                <td class="text-center fw-bold text-success" id="desgloseAhorrosConsistenciaAdmin">+<%= scoreData.desglose.ahorrosConsistencia || 0 %> pts</td>
                                                                <td class="text-center text-muted" id="detalleAhorrosConsistenciaAdmin"><%= scoreData.detalles.ahorrosDepositos90d || 0 %> depósitos</td>
                                                            </tr>
                                                            <tr>
                                                                <td class="text-dark">
                                                                    Antigüedad de cuenta (> 6 meses otorga +50)
                                                                    <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.85rem;" onclick="explicarRegla('antiguedad')" title="Saber más"></i>
                                                                </td>
                                                                <td class="text-center fw-bold text-success" id="desgloseAntiguedadAdmin">+<%= scoreData.desglose.antiguedad %> pts</td>
                                                                <td class="text-center text-muted" id="detalleAntiguedadAdmin"><%= scoreData.detalles.antiguedadMeses %> meses</td>
                                                            </tr>
                                                            <tr>
                                                                <td class="text-dark">
                                                                    Préstamos activos en mora/vencidos (-200 pts c/u)
                                                                    <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.85rem;" onclick="explicarRegla('vencidos')" title="Saber más"></i>
                                                                </td>
                                                                <td class="text-center fw-bold <%= scoreData.desglose.prestamosVencidos < 0 ? 'text-danger' : 'text-muted' %>" id="desgloseVencidosAdmin"><%= scoreData.desglose.prestamosVencidos %> pts</td>
                                                                <td class="text-center text-muted" id="detalleVencidosAdmin"><%= scoreData.detalles.prestamosVencidosCount %> préstamos</td>
                                                            </tr>
                                                            <tr>
                                                                <td class="text-dark">
                                                                    Cuotas activas vencidas (-50 cuota < 30 días, -100 cuota > 30 días)
                                                                    <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.85rem;" onclick="explicarRegla('cuotas')" title="Saber más"></i>
                                                                </td>
                                                                <td class="text-center fw-bold <%= scoreData.desglose.cuotasVencidas < 0 ? 'text-danger' : 'text-muted' %>" id="desgloseCuotasAdmin"><%= scoreData.desglose.cuotasVencidas %> pts</td>
                                                                <td class="text-center text-muted">
                                                                    <span id="detalleCuotasAdmin"><%= scoreData.detalles.cuotasAtrasadasCount %> (< 30d) / <%= scoreData.detalles.cuotasAtrasadas30Count %> (> 30d)</span>
                                                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="auditarCuotasVencidas()" title="Auditar cuotas vencidas"><i class="bi bi-eye-fill"></i></button>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="text-dark">
                                                                    Comportamiento de Pago (Histórico: anticipación/demora de cuotas)
                                                                    <i class="bi bi-info-circle text-muted ms-1" style="cursor: pointer; font-size: 0.85rem;" onclick="explicarRegla('comportamiento')" title="Saber más"></i>
                                                                </td>
                                                                <td class="text-center fw-bold <%= scoreData.desglose.comportamientoPago < 0 ? 'text-danger' : (scoreData.desglose.comportamientoPago > 0 ? 'text-success' : 'text-muted') %>" id="desgloseComportamientoAdmin"><%= scoreData.desglose.comportamientoPago > 0 ? '+' : '' %><%= scoreData.desglose.comportamientoPago %> pts</td>
                                                                <td class="text-center text-muted">
                                                                    <span id="detalleComportamientoAdmin"><%= scoreData.detalles.comportamientoPagoDetalle ? scoreData.detalles.comportamientoPagoDetalle.length : 0 %> cuotas</span>
                                                                    <button type="button" class="btn btn-sm btn-link text-success p-0 ms-2" onclick="auditarComportamientoPago()" id="btnAuditarComportamientoAdmin" title="Auditar comportamiento de pago"><i class="bi bi-eye-fill"></i></button>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="text-dark">
                                                                    Reincidencia en moras (Penalización: 3-5: -50 pts, >=6: -100 pts)
