<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>

<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <%- include('../partials/sidebar') %>

            <div class="col py-0 py-md-3 main-content-wrapper">
                <%- include('../partials/mobile-header') %>

                <div class="container mt-4 mb-5" style="max-width: 1000px;">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="h3 mb-0 text-gray-800"><i class="bi bi-display"></i> Dispositivos Registrados para Notificaciones</h2>
            <p class="text-muted mt-1">Lista de dispositivos con acceso a recibir Push Notifications.</p>
        </div>
        <div class="col-md-6 text-end">
            <a href="/config" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver a Configuración</a>
        </div>
    </div>

    <div class="card card-box border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Usuario</th>
                            <th>Navegador / SO</th>
                            <th>Conexión</th>
                            <th>Batería</th>
                            <th>Actividad</th>
                            <th>ID Dispositivo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (dispositivos && dispositivos.length > 0) { %>
                            <% dispositivos.forEach(disp => { 
                                let info = {};
                                try { info = typeof disp.device_info === 'string' ? JSON.parse(disp.device_info) : (disp.device_info || {}); } catch(e){}
                                
                                // Parse simple user agent
                                let os = 'Desconocido';
                                let browser = '';
                                if(info.userAgent) {
                                    if(info.userAgent.includes('Android')) os = 'Android';
                                    else if(info.userAgent.includes('iPhone')) os = 'iPhone';
                                    else if(info.userAgent.includes('Windows')) os = 'Windows';
                                    else if(info.userAgent.includes('Mac')) os = 'Mac';
                                    else if(info.userAgent.includes('Linux')) os = 'Linux';
                                    
                                    if(info.userAgent.includes('Chrome')) browser = 'Chrome';
                                    else if(info.userAgent.includes('Safari') && !info.userAgent.includes('Chrome')) browser = 'Safari';
                                    else if(info.userAgent.includes('Firefox')) browser = 'Firefox';
                                }
                            %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <% let esCliente = disp.cliente_nombre ? true : false; %>
                                        <div class="<%= esCliente ? 'bg-success' : 'bg-primary' %> text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px; font-weight: bold;">
                                            <%= esCliente ? disp.cliente_nombre.charAt(0).toUpperCase() : (disp.nombre_completo ? disp.nombre_completo.charAt(0).toUpperCase() : '?') %>
                                        </div>
                                        <div>
                                            <div class="fw-bold d-flex align-items-center gap-2">
                                                <span id="name-<%= disp.id %>"><%= disp.nombre_dispositivo || (esCliente ? disp.cliente_nombre + ' ' + disp.cliente_apellido : disp.nombre_completo) || 'Dispositivo Sin Nombre' %></span>
                                                <button onclick="editarNombre(<%= disp.id %>)" class="btn btn-sm btn-link text-primary p-0 m-0" title="Editar Nombre">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </div>
                                            <small class="text-muted">
                                                <% if(esCliente) { %>
                                                    <span class="badge bg-success bg-opacity-75">Cliente</span> <%= disp.cliente_nombre + ' ' + disp.cliente_apellido %> (ID: <%= disp.id %>)
                                                <% } else { %>
                                                    <span class="badge bg-primary bg-opacity-75">Administrador</span> <%= disp.nombre_completo || 'Usuario Anónimo' %> (ID: <%= disp.id %>)
                                                <% } %>
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-dark"><%= os %></span>
                                    <span class="badge bg-secondary"><%= browser %></span>
                                </td>
                                <td>
                                    <% if(info.connection && info.connection !== 'unknown') { %>
                                        <span class="badge bg-info"><i class="bi bi-wifi"></i> <%= info.connection.toUpperCase() %></span>
                                    <% } else { %>
                                        <span class="text-muted small">N/A</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if(info.battery && info.battery !== 'unknown') { %>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi <%= info.isCharging === 'Sí' ? 'bi-battery-charging text-success' : 'bi-battery-half text-warning' %>"></i>
                                            <span><%= info.battery %></span>
                                        </div>
                                    <% } else { %>
                                        <span class="text-muted small">No Disponible</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="small">
                                        <div class="text-muted mb-1"><i class="bi bi-calendar-check"></i> Reg: <%= new Date(disp.created_at).toLocaleDateString() %></div>
                                        <div class="fw-bold text-success"><i class="bi bi-clock-history"></i> Visto: <%= disp.ultima_conexion ? new Date(disp.ultima_conexion).toLocaleString() : new Date(disp.created_at).toLocaleString() %></div>
                                    </div>
                                </td>
                                <td>
                                    <code class="small text-muted" title="<%= disp.endpoint %>"><%= disp.endpoint.substring(0, 30) %>...</code>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-phone text-muted" style="font-size: 3rem;"></i>
                                    <p class="mt-3">No hay ningún dispositivo suscrito a las notificaciones.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </div>
</div>

<script>
async function editarNombre(id) {
    const span = document.getElementById('name-' + id);
    const actual = span.innerText;
    const nuevo = prompt("Ingresa el nuevo nombre para este dispositivo:", actual);
    
    if (nuevo !== null && nuevo.trim() !== "" && nuevo !== actual) {
        try {
            const response = await fetch('/push/update-name', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, nombre: nuevo.trim() })
            });
            const data = await response.json();
            if (data.success) {
                span.innerText = nuevo.trim();
                alert("Nombre actualizado correctamente.");
            } else {
                alert("Error al actualizar el nombre.");
            }
        } catch (e) {
            alert("Error de conexión al servidor.");
        }
    }
}
</script>

            </div>
        </div>
    </div>
    <%- include('../partials/footer') %>
</body>
</html>
