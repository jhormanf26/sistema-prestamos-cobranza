<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>

    <body>
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <%- include('../partials/sidebar') %>

                    <div class="col py-0 py-md-3 main-content-wrapper">
                        <%- include('../partials/mobile-header') %>

                            <div class="container" style="max-width: 800px;">
                                <h2 class="mb-4">⚙️ Configuración del Negocio</h2>

                                <% if(mensajeExito && mensajeExito.length> 0) { %>
                                    <div class="alert alert-success">
                                        <%= mensajeExito %>
                                    </div>
                                    <% } %>
                                        <% if(mensajeError && mensajeError.length> 0) { %>
                                            <div class="alert alert-danger">
                                                <%= mensajeError %>
                                            </div>
                                            <% } %>

                                                <form action="/config/actualizar" method="POST"
                                                    enctype="multipart/form-data">
                                                    <div class="card card-box p-4 mb-4">

                                                        <div class="row g-4">
                                                            <div class="col-md-8">
                                                                <h5 class="text-secondary mb-3">Información General</h5>

                                                                <div class="mb-3">
                                                                    <label class="form-label">Nombre de la Empresa /
                                                                        Marca</label>
                                                                    <input type="text" name="nombre_empresa"
                                                                        class="form-control"
                                                                        value="<%= config.nombre_empresa %>" required>
                                                                </div>

                                                                <div class="row">
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label">RUC / ID
                                                                            Fiscal</label>
                                                                        <input type="text" name="ruc"
                                                                            class="form-control"
                                                                            value="<%= config.ruc %>">
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label">Moneda
                                                                            (Símbolo)</label>
                                                                        <input type="text" name="moneda"
                                                                            class="form-control"
                                                                            value="<%= config.moneda %>"
                                                                            placeholder="$">
                                                                    </div>
                                                                </div>

                                                                <div class="mb-3">
                                                                    <label class="form-label">Dirección Fiscal</label>
                                                                    <input type="text" name="direccion"
                                                                        class="form-control"
                                                                        value="<%= config.direccion %>">
                                                                </div>

                                                                <div class="row">
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label">Teléfono</label>
                                                                        <input type="text" name="telefono"
                                                                            class="form-control"
                                                                            value="<%= config.telefono %>">
                                                                    </div>
                                                                    <div class="col-md-6 mb-3">
                                                                        <label class="form-label">Email de
                                                                            Contacto</label>
                                                                        <input type="email" name="email_contacto"
                                                                            class="form-control"
                                                                            value="<%= config.email_contacto %>">
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-4 text-center">
                                                                <h5 class="text-secondary mb-3">Logotipo</h5>
                                                                <div class="border rounded p-3 bg-light mb-3 d-flex align-items-center justify-content-center"
                                                                    style="height: 150px;">
                                                                    <% if(config.logo) { %>
                                                                        <img src="/uploads/<%= config.logo %>"
                                                                            alt="Logo Actual"
                                                                            style="max-height: 100%; max-width: 100%;">
                                                                        <% } else { %>
                                                                            <span class="text-muted">Sin Logo</span>
                                                                            <% } %>
                                                                </div>
                                                                <label class="form-label">Cambiar Logo</label>
                                                                <input type="file" name="logo" class="form-control"
                                                                    accept="image/*">
                                                                <div class="form-text small">Se recomienda formato PNG
                                                                    transparente.</div>
                                                            </div>
                                                        </div>

                                                        <% 
                                                            let mod = {clientes:true, prestamos:true, simulador:true, gastos:true, reportes:true, empenos:true, ahorros:true, cadenas:true, promocion:true, comprobantes:true, solicitudes:true, soporte:true};
                                                            if (config.modulos_activos) {
                                                                try {
                                                                    mod = typeof config.modulos_activos === 'string' ? JSON.parse(config.modulos_activos) : config.modulos_activos;
                                                                } catch(e) {}
                                                            }
                                                        %>
                                                        <h5 class="text-secondary mb-3 mt-4"><i class="bi bi-ui-checks"></i> Módulos Visibles (Menú Lateral)</h5>
                                                        <div class="row g-3 mb-4">
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_clientes" id="mod_clientes" <%= mod.clientes !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_clientes">Clientes</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_prestamos" id="mod_prestamos" <%= mod.prestamos !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_prestamos">Préstamos</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_simulador" id="mod_simulador" <%= mod.simulador !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_simulador">Calculadora</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_gastos" id="mod_gastos" <%= mod.gastos !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_gastos">Gastos</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_reportes" id="mod_reportes" <%= mod.reportes !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_reportes">Reportes Excel</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_empenos" id="mod_empenos" <%= mod.empenos !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_empenos">Empeños</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_ahorros" id="mod_ahorros" <%= mod.ahorros !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_ahorros">Ahorros</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_cadenas" id="mod_cadenas" <%= mod.cadenas !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_cadenas">Cadenas</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_promocion" id="mod_promocion" <%= mod.promocion !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_promocion">Web Promocional</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_comprobantes" id="mod_comprobantes" <%= mod.comprobantes !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_comprobantes">Comprobantes</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_solicitudes" id="mod_solicitudes" <%= mod.solicitudes !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_solicitudes">Solicitudes Cupo</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" name="mod_soporte" id="mod_soporte" <%= mod.soporte !== false ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="mod_soporte">Chat Soporte</label>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <h5 class="text-secondary mb-3 mt-4"><i class="bi bi-wallet2"></i> Canales de Pago Autorizados (Portal Cliente)</h5>
                                                        <div class="row g-3 mb-4">
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-bold">Celular Nequi</label>
                                                                <input type="text" name="nequi_numero" class="form-control" value="<%= config.nequi_numero || '3123456789' %>">
                                                                <div class="form-text text-muted small">Número de celular Nequi autorizado para recibir pagos rápidos del cliente.</div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-bold">Bre-B / Transfiya (Celular o Llave)</label>
                                                                <input type="text" name="breve_numero" class="form-control" value="<%= config.breve_numero || '3123456789' %>">
                                                                <div class="form-text text-muted small">Número de celular o llave registrado en Bre-B / Transfiya.</div>
                                                            </div>
                                                        </div>

                                                        <h5 class="text-secondary mb-3 mt-4"><i class="bi bi-bell-fill"></i> Alertas de Cobro Automáticas (Push)</h5>
                                                        <div class="row g-3 mb-4">
                                                            <div class="col-md-12 mb-2">
                                                                <label class="form-label fw-bold">Hora de Envío Diario</label>
                                                                <select name="alerta_hora" class="form-select" style="max-width: 250px;">
                                                                    <% for (let h = 0; h < 24; h++) { %>
                                                                        <% let labelHora = h.toString().padStart(2, '0') + ':00 ' + (h >= 12 ? 'PM' : 'AM'); %>
                                                                        <option value="<%= h %>" <%= config.alerta_hora === h ? 'selected' : (config.alerta_hora === undefined && h === 8 ? 'selected' : '') %>><%= labelHora %></option>
                                                                    <% } %>
                                                                </select>
                                                                <div class="form-text text-muted small">Hora en la que el cobrador robótico del servidor disparará los correos y notificaciones push diariamente.</div>
                                                            </div>
                                                            <div class="col-md-12">
                                                                <label class="form-label fw-bold">Notificación Push (3 Días Antes del Vencimiento)</label>
                                                                <input type="text" name="push_texto_3d" class="form-control" value="<%= config.push_texto_3d || 'Hola {{cliente}}, recuerda que tu cuota #{{numero}} de {{moneda}}{{monto}} vence en 3 días.' %>">
                                                            </div>
                                                            <div class="col-md-12">
                                                                <label class="form-label fw-bold">Notificación Push (1 Día Antes del Vencimiento)</label>
                                                                <input type="text" name="push_texto_1d" class="form-control" value="<%= config.push_texto_1d || 'Hola {{cliente}}, mañana vence tu cuota #{{numero}} de {{moneda}}{{monto}}.' %>">
                                                            </div>
                                                            <div class="col-md-12">
                                                                <label class="form-label fw-bold">Notificación Push (El Mismo Día del Vencimiento)</label>
                                                                <input type="text" name="push_texto_0d" class="form-control" value="<%= config.push_texto_0d || 'Hola {{cliente}}, hoy vence tu cuota #{{numero}} de {{moneda}}{{monto}}. Evita recargos.' %>">
                                                            </div>
                                                            <div class="col-12 mt-2">
                                                                <div class="alert alert-info py-2 px-3 small border-0 bg-info-subtle text-info-emphasis mb-0">
                                                                    💡 <strong>Variables disponibles:</strong> Puedes usar <code>{{cliente}}</code>, <code>{{numero}}</code>, <code>{{moneda}}</code> y <code>{{monto}}</code> para que los mensajes se autocompleten de forma dinámica.
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <hr>
                                                        <div class="d-flex justify-content-end">
                                                            <button type="submit" class="btn btn-primary btn-lg">
                                                                <i class="bi bi-save"></i> Guardar Cambios
                                                            </button>
                                                        </div>
                                                    </div>
                                                </form>

                                                <div class="card card-box border-info mb-4">
                                                    <div class="card-header bg-info text-white fw-bold">
                                                        <i class="bi bi-bell-fill"></i> Notificaciones Push (Aplicación Móvil)
                                                    </div>
                                                    <div class="card-body">
                                                        <p class="card-text text-muted">Habilita las notificaciones en este dispositivo para recibir alertas automáticas cuando un préstamo esté por vencer o cuando un cliente ingrese/simule en tu web promocional.</p>
                                                        <button type="button" id="btnHabilitarPush" class="btn btn-info text-white mb-2">
                                                            <i class="bi bi-phone-vibrate"></i> Habilitar Notificaciones
                                                        </button>
                                                        <br>
                                                        <a href="/config/dispositivos" class="btn btn-sm btn-outline-secondary mt-2">
                                                            <i class="bi bi-display"></i> Ver Dispositivos Registrados
                                                        </a>
                                                    </div>
                                                </div>

                                                <div class="card card-box border-warning">
                                                    <div class="card-header bg-warning-subtle fw-bold text-dark">
                                                        <i class="bi bi-database-fill-gear"></i> Mantenimiento y
                                                        Seguridad
                                                    </div>
                                                    <div
                                                        class="card-body d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <h5 class="card-title">Copia de Seguridad</h5>
                                                            <p class="card-text text-muted small">Descarga un archivo
                                                                SQL
                                                                con toda la información de clientes, préstamos y pagos.
                                                            </p>
                                                        </div>
                                                        <a href="/backup/descargar" class="btn btn-outline-dark">
                                                            <i class="bi bi-cloud-download"></i> Descargar Base de Datos
                                                        </a>
                                                    </div>
                                                </div>

                            </div>
                    </div>
            </div>
        </div>
        
<script>
document.getElementById('btnHabilitarPush')?.addEventListener('click', async () => {
    const btn = document.getElementById('btnHabilitarPush');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Configurando...';
    btn.disabled = true;

    try {
        const permission = await Notification.requestPermission();
        if (permission !== 'granted') {
            alert("Permiso de notificaciones denegado. Habilita las notificaciones en tu navegador.");
            btn.innerHTML = originalText;
            btn.disabled = false;
            return;
        }

        const response = await fetch('/push/public-key');
        const vapidData = await response.json();
        const publicKey = vapidData.publicKey;

        const urlBase64ToUint8Array = (base64String) => {
            const padding = '='.repeat((4 - base64String.length % 4) % 4);
            const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
            const rawData = window.atob(base64);
            const outputArray = new Uint8Array(rawData.length);
            for (let i = 0; i < rawData.length; ++i) {
                outputArray[i] = rawData.charCodeAt(i);
            }
            return outputArray;
        };

        const convertedVapidKey = urlBase64ToUint8Array(publicKey);

        const registration = await navigator.serviceWorker.register('/sw.js');
        
        const subscription = await registration.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: convertedVapidKey
        });

        // Capturar información del dispositivo
        const deviceInfo = {
            userAgent: navigator.userAgent,
            language: navigator.language,
            platform: navigator.platform || 'unknown',
            connection: navigator.connection ? navigator.connection.effectiveType : 'unknown',
            battery: 'unknown',
            isCharging: 'unknown'
        };

        if ('getBattery' in navigator) {
            try {
                const battery = await navigator.getBattery();
                deviceInfo.battery = Math.round(battery.level * 100) + '%';
                deviceInfo.isCharging = battery.charging ? 'Sí' : 'No';
            } catch (e) {}
        }

        await fetch('/push/subscribe', {
            method: 'POST',
            body: JSON.stringify({ subscription, deviceInfo }),
            headers: { 'Content-Type': 'application/json' }
        });

        alert("¡Notificaciones habilitadas con éxito en este dispositivo!");
        btn.innerHTML = '<i class="bi bi-check-circle"></i> Notificaciones Activas';
        btn.classList.remove('btn-info');
        btn.classList.add('btn-success');
    } catch (e) {
        console.error("Error al habilitar push:", e);
        alert("Ocurrió un error al intentar habilitar las notificaciones.");
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
});
</script>

<%- include('../partials/footer') %>