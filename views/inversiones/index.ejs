    <!-- SCRIPT CHART.JS & LÓGICA INTERACTIVA -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Datos inyectados desde el servidor
            const serieLabels = <%- JSON.stringify(serieMensual.labels || []) %>;
            const serieRendimientos = <%- JSON.stringify(serieMensual.rendimientos || []) %>;
            const serieRetiros = <%- JSON.stringify(serieMensual.retiros || []) %>;
            const serieInversiones = <%- JSON.stringify(serieMensual.inversiones || []) %>;

            // 1. Chart de Flujo Mensual (Inversiones, Rendimientos, Retiros)
            let chartFlujoInstance = null;
            const ctxRendimientos = document.getElementById('chartRendimientosMensuales');
            if (ctxRendimientos && serieLabels.length > 0) {
                chartFlujoInstance = new Chart(ctxRendimientos, {
                    type: 'bar',
                    data: {
                        labels: serieLabels,
                        datasets: [
                            {
                                label: 'Inversiones / Aportes (<%= empresa.moneda %>)',
                                data: serieInversiones,
                                backgroundColor: '#3b82f6',
                                borderRadius: 6
                            },
                            {
                                label: 'Rendimientos (<%= empresa.moneda %>)',
                                data: serieRendimientos,
                                backgroundColor: '#10b981',
                                borderRadius: 6
                            },
                            {
                                label: 'Retiros (<%= empresa.moneda %>)',
                                data: serieRetiros,
                                backgroundColor: '#ef4444',
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' }
                        },
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });

                // Listener para el filtro interactivo de botones (Todos, Inversiones, Rendimientos, Retiros)
                const contenedorFiltro = document.getElementById('filtroGraficoFlujo');
                if (contenedorFiltro) {
                    const botonesFiltro = contenedorFiltro.querySelectorAll('button');
                    botonesFiltro.forEach(btn => {
                        btn.addEventListener('click', function() {
                            botonesFiltro.forEach(b => b.classList.remove('active', 'btn-dark'));
                            this.classList.add('active', 'btn-dark');

                            const dsVal = this.getAttribute('data-dataset');
                            if (dsVal === 'todos') {
                                chartFlujoInstance.setDatasetVisibility(0, true);
                                chartFlujoInstance.setDatasetVisibility(1, true);
                                chartFlujoInstance.setDatasetVisibility(2, true);
                            } else {
                                const targetIdx = parseInt(dsVal);
                                [0, 1, 2].forEach(idx => {
                                    chartFlujoInstance.setDatasetVisibility(idx, idx === targetIdx);
                                });
                            }
                            chartFlujoInstance.update();
                        });
                    });
                }
            }

            // 2. Chart de Distribución Financiera
            const ctxDistribucion = document.getElementById('chartDistribucion');
            if (ctxDistribucion) {
                const totalCapital = <%= kpis.capital_invertido || 0 %>;
                const totalRendimientos = <%= kpis.rendimientos_totales || 0 %>;
                const totalRetiros = <%= kpis.retiros_totales || 0 %>;

                new Chart(ctxDistribucion, {
                    type: 'doughnut',
                    data: {
                        labels: ['Capital Invertido', 'Rendimientos', 'Retiros'],
                        datasets: [{
                            data: [totalCapital, totalRendimientos, totalRetiros],
                            backgroundColor: ['#3b82f6', '#10b981', '#ef4444'],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }

            // 3. Selección y Drag-and-Drop de CSV
            const dropzone = document.getElementById('dropzoneCsv');
            const fileInput = document.getElementById('archivo_csv');
            const badgeNombre = document.getElementById('nombreArchivoSeleccionado');

            if (dropzone && fileInput) {
                dropzone.addEventListener('click', () => fileInput.click());

                fileInput.addEventListener('change', function() {
                    if (this.files.length > 0) {
                        badgeNombre.textContent = this.files[0].name;
                        badgeNombre.classList.remove('d-none');
                    }
                });

                dropzone.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    dropzone.style.backgroundColor = '#dbeafe';
                });

                dropzone.addEventListener('dragleave', () => {
                    dropzone.style.backgroundColor = '#f8fafc';
                });

                dropzone.addEventListener('drop', (e) => {
                    e.preventDefault();
                    dropzone.style.backgroundColor = '#f8fafc';
                    if (e.dataTransfer.files.length > 0) {
                        fileInput.files = e.dataTransfer.files;
                        badgeNombre.textContent = e.dataTransfer.files[0].name;
                        badgeNombre.classList.remove('d-none');
                    }
                });
            }

            function formatearMilesEnVivo(str) {
                if (!str) return '';
                let limpio = String(str).replace(/\./g, '').replace(/[^0-9,]/g, '');
                let partes = limpio.split(',');
                let entero = partes[0];
                let decimal = partes.length > 1 ? ',' + partes[1].slice(0, 2) : '';
                let enteroFmt = entero.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
                return enteroFmt + decimal;
            }

            // 4. Calculadora AJAX y Simulador Interactivo de Proyección Financiera
            const selectMeses = document.getElementById('selectMesesProyeccion');
            const tablaProyeccionBody = document.querySelector('#tablaProyeccion tbody');
            const inputSimAporte = document.getElementById('inputSimulacionAporte');
            const selectTipoAporte = document.getElementById('selectTipoAporte');
            const inputSimRetiro = document.getElementById('inputSimulacionRetiro');
            const selectTipoRetiro = document.getElementById('selectTipoRetiro');
            const btnResetSimulacion = document.getElementById('btnLimpiarSimulacion');
            const lblTasaProyeccion = document.getElementById('lblTasaProyeccion');

            const inversionIdActual = '<%= inversionSeleccionada || "" %>';
            const monedaEmpresa = '<%= empresa.moneda %>';

            let proyeccionBaseOriginal = <%- JSON.stringify(proyeccion.proyeccion) %>;
            let tasaMensualEstimada = <%= (proyeccion.tasaEstimadaPorcentaje || 0.62) / 100 %>;
            let saldoBaseCalculo = <%= proyeccion.saldoBase || 0 %>;

            function recalcularSimulacionEnCliente() {
                if (!tablaProyeccionBody || !proyeccionBaseOriginal) return;

                const valAporte = parsearLimpio(inputSimAporte ? inputSimAporte.value : '0');
                const valRetiro = parsearLimpio(inputSimRetiro ? inputSimRetiro.value : '0');
                const tipoAporte = selectTipoAporte ? selectTipoAporte.value : 'mensual';
                const tipoRetiro = selectTipoRetiro ? selectTipoRetiro.value : 'mensual';

                let saldoCorrido = saldoBaseCalculo;
                let html = '';

                proyeccionBaseOriginal.forEach((p, index) => {
                    // Si el aporte es 'unico', solo aplica en el primer mes (index === 0)
                    const montoAporteMes = (tipoAporte === 'unico' && index > 0) ? 0 : valAporte;
                    // Si el retiro es 'unico', solo aplica en el primer mes (index === 0)
                    const montoRetiroMes = (tipoRetiro === 'unico' && index > 0) ? 0 : valRetiro;

                    // Rendimiento estimado = (saldo previo + aporte del mes) * tasa
                    const saldoConAporte = saldoCorrido + montoAporteMes;
                    const rendMes = saldoConAporte * (tasaMensualEstimada > 0 ? tasaMensualEstimada : 0.005);
                    saldoCorrido = saldoConAporte - montoRetiroMes + rendMes;

                    const rendFmt = new Intl.NumberFormat('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(rendMes);
                    const saldoFmt = new Intl.NumberFormat('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(saldoCorrido);

                    let flujoBadge = `<span class="badge bg-light text-muted border">-</span>`;
                    const apFmt = new Intl.NumberFormat('es-CO', { minimumFractionDigits: 0 }).format(montoAporteMes);
                    const retFmt = new Intl.NumberFormat('es-CO', { minimumFractionDigits: 0 }).format(montoRetiroMes);

                    if (montoAporteMes > 0 && montoRetiroMes === 0) {
                        const tagUnico = (tipoAporte === 'unico') ? ' (Aporte único)' : ' /mes';
                        flujoBadge = `<span class="badge bg-success-subtle text-success border border-success">+ ${monedaEmpresa} ${apFmt}${tagUnico}</span>`;
                    } else if (montoRetiroMes > 0 && montoAporteMes === 0) {
                        const tagUnico = (tipoRetiro === 'unico') ? ' (Retiro único)' : ' /mes';
                        flujoBadge = `<span class="badge bg-danger-subtle text-danger border border-danger">- ${monedaEmpresa} ${retFmt}${tagUnico}</span>`;
                    } else if (montoAporteMes > 0 && montoRetiroMes > 0) {
                        const neto = montoAporteMes - montoRetiroMes;
                        const netoFmt = new Intl.NumberFormat('es-CO', { minimumFractionDigits: 0 }).format(Math.abs(neto));
                        if (neto >= 0) {
                            flujoBadge = `<span class="badge bg-success-subtle text-success border border-success">+ ${monedaEmpresa} ${netoFmt}</span>`;
                        } else {
                            flujoBadge = `<span class="badge bg-danger-subtle text-danger border border-danger">- ${monedaEmpresa} ${netoFmt}</span>`;
                        }
                    }

                    html += `
                        <tr>
                            <td class="fw-bold text-capitalize"><i class="bi bi-calendar-event me-2 text-muted"></i>${p.mes}</td>
                            <td class="text-center">${flujoBadge}</td>
                            <td class="text-end text-success fw-bold">+ ${monedaEmpresa} ${rendFmt}</td>
                            <td class="text-end text-dark fw-extrabold fs-6">${monedaEmpresa} ${saldoFmt}</td>
                        </tr>
                    `;
                });

                tablaProyeccionBody.innerHTML = html;
            }

            if (inputSimAporte) {
                inputSimAporte.addEventListener('input', function() {
                    this.value = formatearMilesEnVivo(this.value);
                    recalcularSimulacionEnCliente();
                });
            }

            if (inputSimRetiro) {
                inputSimRetiro.addEventListener('input', function() {
                    this.value = formatearMilesEnVivo(this.value);
                    recalcularSimulacionEnCliente();
                });
            }

            if (selectTipoAporte) selectTipoAporte.addEventListener('change', recalcularSimulacionEnCliente);
            if (selectTipoRetiro) selectTipoRetiro.addEventListener('change', recalcularSimulacionEnCliente);

            if (btnResetSimulacion) {
                btnResetSimulacion.addEventListener('click', function() {
                    if (inputSimAporte) inputSimAporte.value = '0';
                    if (inputSimRetiro) inputSimRetiro.value = '0';
                    if (selectTipoAporte) selectTipoAporte.value = 'mensual';
                    if (selectTipoRetiro) selectTipoRetiro.value = 'mensual';
                    recalcularSimulacionEnCliente();
                });
            }

            if (selectMeses && tablaProyeccionBody) {
                selectMeses.addEventListener('change', async function() {
                    const meses = this.value;
                    try {
                        const resp = await fetch(`/inversiones/proyeccion-ajax?meses=${meses}&inversion_id=${inversionIdActual}`);
                        const json = await resp.json();

                        if (json.exito && json.proyeccion) {
                            proyeccionBaseOriginal = json.proyeccion.proyeccion;
                            tasaMensualEstimada = (json.proyeccion.tasaEstimadaPorcentaje || 0.62) / 100;
                            saldoBaseCalculo = json.proyeccion.saldoBase || 0;

                            if (lblTasaProyeccion) {
                                lblTasaProyeccion.textContent = `${json.proyeccion.tasaEstimadaPorcentaje}% mensual`;
                            }

                            recalcularSimulacionEnCliente();
                        }
                    } catch (e) {
                        console.error("Error al actualizar proyección:", e);
                    }
                });
            }

            // 5. Confirmación para eliminar movimiento
            const formElimina = document.querySelectorAll('.form-eliminar-mov');
            formElimina.forEach(f => {
                f.addEventListener('submit', function(e) {
                    e.preventDefault();
                    Swal.fire({
                        title: '¿Eliminar movimiento?',
                        text: 'Esta acción actualizará el saldo de la cuenta de inversión.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc2626',
                        cancelButtonColor: '#6b7280',
                        confirmButtonText: 'Sí, eliminar',
                        cancelButtonText: 'Cancelar'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            f.submit();
                        }
                    });
                });
            });

            // Funciones para formato de miles con puntos y decimales con coma
            function formatearPuntos(num) {
                if (num === null || num === undefined || num === '') return '';
                let valStr = String(num).replace(/,/g, '.');
                let n = parseFloat(valStr);
                if (isNaN(n)) return '';
                return new Intl.NumberFormat('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
            }

            function parsearLimpio(str) {
                if (!str) return 0;
                let s = String(str).replace(/\./g, '').replace(/,/g, '.').replace(/[^0-9.-]/g, '');
                let n = parseFloat(s);
                return isNaN(n) ? 0 : n;
            }

            // 6. Edición y Eliminación de Cuentas de Inversión
            const modalGestion = document.getElementById('modalGestionCuentas');
            const modalEditar = new bootstrap.Modal(document.getElementById('modalEditarCuenta'));
            const formEditarCuenta = document.getElementById('formEditarCuenta');
            const inputEditTipo = document.getElementById('edit_tipo_cuenta');
            const inputEditNumero = document.getElementById('edit_numero_cuenta');
            const inputEditSaldoInicial = document.getElementById('edit_saldo_inicial');
            const inputEditSaldoInicialDisplay = document.getElementById('edit_saldo_inicial_display');
            const inputEditSaldoActualDeseado = document.getElementById('edit_saldo_actual_deseado');
            const inputEditDesc = document.getElementById('edit_descripcion');

            let netoMovimientosCuentaActual = 0;

            document.querySelectorAll('.btn-abrir-editar-cuenta').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    const tipo = this.getAttribute('data-tipo');
                    const numero = this.getAttribute('data-numero');
                    const saldoinicial = parseFloat(this.getAttribute('data-saldoinicial') || 0);
                    const saldoactual = parseFloat(this.getAttribute('data-saldoactual') || 0);
                    netoMovimientosCuentaActual = parseFloat(this.getAttribute('data-netomovimientos') || 0);
                    const descripcion = this.getAttribute('data-descripcion');

                    formEditarCuenta.action = `/inversiones/cuenta/editar/${id}`;
                    inputEditTipo.value = tipo;
                    inputEditNumero.value = numero;
                    if (inputEditSaldoInicial) inputEditSaldoInicial.value = saldoinicial;
                    if (inputEditSaldoInicialDisplay) inputEditSaldoInicialDisplay.value = formatearPuntos(saldoinicial);
                    if (inputEditSaldoActualDeseado) inputEditSaldoActualDeseado.value = formatearPuntos(saldoactual);
                    inputEditDesc.value = descripcion;

                    // Ocultar modal de gestión si estuviera abierto
                    const bsGestion = bootstrap.Modal.getInstance(modalGestion);
                    if (bsGestion) bsGestion.hide();

                    modalEditar.show();
                });
            });

            if (inputEditSaldoActualDeseado && inputEditSaldoInicialDisplay) {
                // Al escribir Saldo Actual Real -> recalcular Saldo Inicial Previo
                inputEditSaldoActualDeseado.addEventListener('input', function() {
                    const valActual = parsearLimpio(this.value);
                    const initCalculado = valActual - netoMovimientosCuentaActual;
                    const finalInit = initCalculado > 0 ? initCalculado : 0;
                    inputEditSaldoInicial.value = finalInit.toFixed(2);
                    inputEditSaldoInicialDisplay.value = formatearPuntos(finalInit);
                });

                inputEditSaldoActualDeseado.addEventListener('blur', function() {
                    const valActual = parsearLimpio(this.value);
                    this.value = formatearPuntos(valActual);
                });

                // Al escribir Saldo Inicial Previo -> recalcular Saldo Actual Real
                inputEditSaldoInicialDisplay.addEventListener('input', function() {
                    const valInit = parsearLimpio(this.value);
                    inputEditSaldoInicial.value = valInit.toFixed(2);
                    const actualCalculado = valInit + netoMovimientosCuentaActual;
                    inputEditSaldoActualDeseado.value = formatearPuntos(actualCalculado);
                });

                inputEditSaldoInicialDisplay.addEventListener('blur', function() {
                    const valInit = parsearLimpio(this.value);
                    this.value = formatearPuntos(valInit);
                });
            }

            if (formEditarCuenta) {
                formEditarCuenta.addEventListener('submit', function() {
                    if (inputEditSaldoInicialDisplay) {
                        inputEditSaldoInicial.value = parsearLimpio(inputEditSaldoInicialDisplay.value);
                    }
                });
            }

            document.querySelectorAll('.form-eliminar-cuenta').forEach(f => {
                f.addEventListener('submit', function(e) {
                    e.preventDefault();
                    Swal.fire({
                        title: '¿Eliminar cuenta de inversión?',
                        text: 'Esta acción eliminará la cuenta y TODOS los movimientos asociados a ella.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc2626',
                        cancelButtonColor: '#6b7280',
                        confirmButtonText: 'Sí, eliminar todo',
                        cancelButtonText: 'Cancelar'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            f.submit();
                        }
                    });
                });
            });
        });
    </script>

    <%- include('../partials/footer') %>
