<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <%- include('partials/sidebar') %>

            <div class="col py-0 py-md-3 main-content-wrapper" style="background-color: #f8fafc; min-height: 100vh;">
                <!-- Mobile Header Simple -->
                <div class="d-md-none bg-white p-3 shadow-sm d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-file-earmark-pdf-fill text-success fs-3 me-2"></i>
                        <h5 class="mb-0 fw-bold">Mis Documentos</h5>
                    </div>
                    <button class="btn btn-outline-secondary position-relative" id="openSidebarBtn">
                        <i class="bi bi-list fs-4"></i>
                        <% if (typeof clienteChatSinLeer !== 'undefined' && clienteChatSinLeer > 0) { %>
                            <span class="position-absolute top-0 start-100 translate-middle p-1.5 bg-danger border border-white rounded-circle animate-pulse" style="width: 10px; height: 10px;">
                                <span class="visually-hidden">Mensajes no leídos</span>
                            </span>
                        <% } %>
                    </button>
                </div>

                <div class="container-fluid px-4 py-3">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold text-dark my-0 fs-4">Expediente Digital</h2>
                            <p class="text-muted small mb-0">Sube tu cédula y otros documentos necesarios para el estudio de tus créditos.</p>
                        </div>
                    </div>

                    <% if(mensajeExito && mensajeExito.length > 0) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> <%= mensajeExito %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <% if(mensajeError && mensajeError.length > 0) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= mensajeError %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <div class="row g-4">
                        <!-- Subida de Documentos -->
                        <div class="col-lg-5">
                            <div class="card border-0 shadow-sm rounded-4 mb-4">
                                <div class="card-header bg-white border-0 pt-4 pb-0">
                                    <h5 class="fw-bold text-dark"><i class="bi bi-cloud-arrow-up-fill text-success me-2"></i> Subir Documento</h5>
                                </div>
                                <div class="card-body">
                                    <form action="/portal-cliente/documentos/subir" method="POST" enctype="multipart/form-data" id="uploadForm">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold text-muted small">Tipo de Documento</label>
                                            <select name="nombre_documento" id="nombre_documento" class="form-select rounded-3 border-secondary-subtle" required>
                                                <option value="Cédula de Identidad" selected>Cédula de Ciudadanía / Identidad (Requerido)</option>
                                                <option value="Comprobante de Domicilio">Comprobante de Domicilio</option>
                                                <option value="Certificación Laboral">Certificación Laboral o Ingresos</option>
                                                <option value="Otro Documento">Otro Documento de Soporte</option>
                                            </select>
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label fw-bold text-muted small">Seleccionar Archivo</label>
                                            <!-- Drag and Drop Zone -->
                                            <div class="drag-drop-zone border border-2 border-dashed border-success-subtle rounded-4 p-4 text-center cursor-pointer position-relative bg-light-subtle" id="dropZone" style="transition: all 0.25s ease-in-out;">
                                                <input type="file" name="documento" id="documentoInput" class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer" accept="application/pdf, image/jpeg, image/jpg, image/png" required>
                                                
                                                <div class="drop-zone-prompt">
                                                    <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 60px; height: 60px;">
                                                        <i class="bi bi-file-earmark-pdf fs-3"></i>
                                                    </div>
                                                    <h6 class="fw-bold text-dark mb-1">Arrastra tu archivo aquí o haz clic</h6>
                                                    <p class="text-muted small mb-0">Formatos permitidos: <strong>PDF, JPG, PNG</strong> (Máx. 10MB)</p>
                                                </div>
                                                
                                                <div class="drop-zone-selected d-none text-success">
                                                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 60px; height: 60px;">
                                                        <i class="bi bi-file-earmark-check fs-3"></i>
                                                    </div>
                                                    <h6 class="fw-bold mb-1" id="selectedFileName">Archivo seleccionado</h6>
                                                    <p class="text-muted small mb-0">Haz clic para cambiar el archivo</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-success fw-bold py-2.5 rounded-pill shadow-sm" id="btnSubmit">
                                                <i class="bi bi-upload me-2"></i> ENVIAR DOCUMENTO
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <div class="card border-0 shadow-sm rounded-4 bg-light-subtle">
                                <div class="card-body p-4">
                                    <h6 class="fw-bold text-dark"><i class="bi bi-shield-check text-success me-2"></i> ¿Por qué necesitamos esto?</h6>
                                    <p class="text-muted small mb-0">Por razones de seguridad y cumplimiento legal, debemos verificar tu identidad. Tu información y tus documentos se cifran y almacenan en un entorno completamente protegido.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Historial de Documentos -->
                        <div class="col-lg-7">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold text-dark"><i class="bi bi-folder-fill text-warning me-2"></i> Documentos Cargados</h5>
                                    <span class="badge bg-light text-dark border fw-semibold rounded-pill"><%= documentos.length %> archivos</span>
                                </div>
                                <div class="card-body">
                                    <% if (documentos && documentos.length > 0) { %>
                                        <div class="row g-3">
                                            <% documentos.forEach(doc => { %>
                                                <div class="col-12" id="doc-card-<%= doc.id %>">
                                                    <div class="border rounded-4 p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white shadow-sm hover-effect" style="transition: transform 0.2s ease;">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="rounded-3 p-3 d-flex align-items-center justify-content-center border <%= doc.archivo_url.toLowerCase().endsWith('.pdf') ? 'bg-danger-subtle text-danger' : 'bg-primary-subtle text-primary' %>" style="width: 50px; height: 50px;">
                                                                <i class="bi <%= doc.archivo_url.toLowerCase().endsWith('.pdf') ? 'bi-file-pdf-fill' : 'bi-image' %> fs-3"></i>
                                                            </div>
                                                            <div>
                                                                <h6 class="mb-0 fw-bold text-dark"><%= doc.nombre_documento %></h6>
                                                                <small class="text-muted"><%= new Date(doc.fecha_subida).toLocaleString('es-CO') %></small>
                                                            </div>
                                                        </div>
                                                        
                                                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-md-0">
                                                            <!-- Badge de Estado -->
                                                            <% if (doc.estado === 'pendiente') { %>
                                                                <span class="badge bg-warning-subtle text-warning border border-warning px-2.5 py-1.5 rounded-pill fw-bold">
                                                                    <i class="bi bi-clock-history me-1"></i> EN REVISIÓN
                                                                </span>
                                                            <% } else if (doc.estado === 'aprobado') { %>
                                                                <span class="badge bg-success-subtle text-success border border-success px-2.5 py-1.5 rounded-pill fw-bold animate-pulse">
                                                                    <i class="bi bi-check-circle-fill me-1"></i> APROBADO
                                                                </span>
                                                            <% } else { %>
                                                                <span class="badge bg-danger-subtle text-danger border border-danger px-2.5 py-1.5 rounded-pill fw-bold">
                                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> RECHAZADO
                                                                </span>
                                                            <% } %>

                                                            <!-- Acciones -->
                                                            <div class="d-flex gap-1 ms-md-2">
                                                                <a href="<%= doc.archivo_url %>" target="_blank" class="btn btn-outline-primary btn-sm rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Ver Documento">
                                                                    <i class="bi bi-eye-fill"></i>
                                                                </a>
                                                                
                                                                <!-- Solo permitir eliminar si es pendiente o rechazado -->
                                                                <% if (doc.estado !== 'aprobado') { %>
                                                                    <button onclick="eliminarDocumento(<%= doc.id %>)" class="btn btn-outline-danger btn-sm rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Eliminar">
                                                                        <i class="bi bi-trash-fill"></i>
                                                                    </button>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Si está rechazado, mostrar el motivo inmediatamente debajo -->
                                                    <% if (doc.estado === 'rechazado' && doc.motivo_rechazo) { %>
                                                        <div class="alert alert-danger border-start border-4 rounded-4 mt-2 mb-3 py-2 px-3 shadow-sm border-danger" style="font-size: 0.85rem;">
                                                            <i class="bi bi-info-circle-fill me-1"></i> <strong>Motivo de rechazo:</strong> <em>"<%= doc.motivo_rechazo %>"</em>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <div class="text-center py-5">
                                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-muted shadow-inner" style="width: 80px; height: 80px;">
                                                <i class="bi bi-folder2-open display-6"></i>
                                            </div>
                                            <h6 class="fw-bold text-dark">No has subido documentos</h6>
                                            <p class="text-muted small mx-auto" style="max-width: 300px;">Sube una copia de tu cédula en PDF o foto para iniciar el proceso de verificación de tu cuenta.</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts Esenciales -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Manejo del sidebar en móviles
            const sidebar = document.getElementById("sidebarMenu");
            const openBtn = document.getElementById("openSidebarBtn");
            const closeBtn = document.getElementById("closeSidebarBtn");
            const overlay = document.getElementById("sidebarOverlay");

            if(openBtn && closeBtn && sidebar) {
                openBtn.addEventListener("click", () => {
                    sidebar.classList.add("sidebar-open");
                    if(overlay) overlay.classList.add("active");
                });
                closeBtn.addEventListener("click", () => {
                    sidebar.classList.remove("sidebar-open");
                    if(overlay) overlay.classList.remove("active");
                });
            }
            if(overlay) {
                overlay.addEventListener("click", () => {
                    sidebar.classList.remove("sidebar-open");
                    overlay.classList.remove("active");
                });
            }

            // Lógica Drag and Drop para subir archivos
            const dropZone = document.getElementById("dropZone");
            const fileInput = document.getElementById("documentoInput");
            const promptView = dropZone.querySelector(".drop-zone-prompt");
            const selectedView = dropZone.querySelector(".drop-zone-selected");
            const selectedFileName = document.getElementById("selectedFileName");

            fileInput.addEventListener("change", function() {
                if (fileInput.files.length > 0) {
                    const file = fileInput.files[0];
                    selectedFileName.textContent = file.name + ` (${(file.size / (1024 * 1024)).toFixed(2)} MB)`;
                    promptView.classList.add("d-none");
                    selectedView.classList.remove("d-none");
                    dropZone.classList.add("border-success");
                }
            });

            // Animaciones dragover / dragleave / drop
            ['dragover', 'dragenter'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    dropZone.classList.add("border-success", "bg-success-subtle");
                }, false);
            });

            ['dragleave', 'dragend', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    if (fileInput.files.length === 0) {
                        dropZone.classList.remove("border-success", "bg-success-subtle");
                    }
                }, false);
            });

            // Enviar Formulario con loading
            const uploadForm = document.getElementById("uploadForm");
            const btnSubmit = document.getElementById("btnSubmit");

            uploadForm.addEventListener("submit", function() {
                btnSubmit.disabled = true;
                btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Enviando...';
            });
        });

        // Eliminar Documento con SweetAlert2
        function eliminarDocumento(id) {
            Swal.fire({
                title: '¿Eliminar Documento?',
                text: "Esta acción no se puede deshacer. Se borrará el archivo de nuestro sistema.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Eliminando...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    fetch(`/admin/documentos/eliminar/${id}`, {
                        method: 'DELETE'
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('¡Eliminado!', 'El archivo ha sido removido.', 'success').then(() => {
                                const card = document.getElementById(`doc-card-${id}`);
                                if (card) {
                                    card.parentElement.remove(); // Borra el contenedor completo de la tarjeta
                                    
                                    // Si no quedan más documentos, recargamos la página para mostrar el empty state
                                    const items = document.querySelectorAll('[id^="doc-card-"]');
                                    if (items.length === 0) {
                                        window.location.reload();
                                    }
                                }
                            });
                        } else {
                            Swal.fire('Error', data.error || 'Ocurrió un error al eliminar.', 'error');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire('Error', 'Ocurrió un error en la conexión.', 'error');
                    });
                }
            });
        }
    </script>
    <%- include('partials/asistente-ia') %>
</body>
</html>
