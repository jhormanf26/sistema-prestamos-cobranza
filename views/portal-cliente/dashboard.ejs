<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <%- include('partials/sidebar') %>

            <div class="col py-0 py-md-3 main-content-wrapper" style="background-color: #f8fafc; min-height: 100vh;">
                <!-- Mobile Header Simple -->
                <div class="d-md-none bg-white p-3 shadow-sm d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-badge text-success fs-3 me-2"></i>
                        <h5 class="mb-0 fw-bold">Mi Portal</h5>
                    </div>
                    <button class="btn btn-outline-secondary position-relative" id="openSidebarBtn">
                        <i class="bi bi-list fs-4"></i>
                        <% if (typeof clienteChatSinLeer !== 'undefined' && clienteChatSinLeer > 0) { %>
                            <span class="position-absolute top-0 start-100 translate-middle p-1.5 bg-danger border border-white rounded-circle animate-pulse" style="width: 10px; height: 10px;">
                                <span class="visually-hidden">Mensajes no leídos</span>
                            </span>
                        <% } %>
                    </button>
                </div>

                <div class="container-fluid px-4 py-3">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold text-dark my-0 fs-4">Hola, <%= cliente.nombre %> 👋</h2>
                            <p class="text-muted small mb-0">Resumen de tus préstamos</p>
                        </div>
                        <div class="d-none d-sm-block">
                            <span class="badge bg-white text-dark border p-2 fw-normal shadow-sm">
                                <i class="bi bi-calendar3 text-success me-1"></i> <%= new Date().toLocaleDateString() %>
                            </span>
                        </div>
                    </div>

                    <!-- Notificaciones Push -->
                    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-info bg-opacity-10">
                        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2">
                            <div>
                                <h6 class="mb-1 text-info fw-bold"><i class="bi bi-bell-fill"></i> Alertas y Recordatorios</h6>
                                <small class="text-muted">Activa las notificaciones en este dispositivo para recibir alertas automáticas cuando tengas una cuota próxima a vencer.</small>
                            </div>
                            <button id="btnHabilitarPushCliente" class="btn btn-sm btn-info text-white rounded-pill px-3 shadow-sm text-nowrap">
                                <i class="bi bi-phone-vibrate"></i> Activar
                            </button>
                        </div>
                    </div>

                    <!-- Alerta de Mensajes de Soporte sin Leer -->
                    <% if (typeof clienteChatSinLeer !== 'undefined' && clienteChatSinLeer > 0) { %>
                        <div class="card border-0 shadow-sm rounded-4 mb-4 text-dark position-relative overflow-hidden" style="background: rgba(220, 53, 69, 0.05); border: 1px solid rgba(220, 53, 69, 0.15) !important;">
                            <div class="position-absolute top-50 end-0 translate-middle-y opacity-10" style="font-size: 7rem; right: 2%; pointer-events: none;">
                                <i class="bi bi-chat-heart-fill text-danger"></i>
                            </div>
                            <div class="card-body p-4 position-relative">
                                <div class="row align-items-center">
                                    <div class="col-md-8 col-lg-9">
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 mb-2 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.75rem;">
                                            <i class="bi bi-envelope-fill me-1 animate-pulse"></i> Tienes <%= clienteChatSinLeer %> <%= clienteChatSinLeer === 1 ? 'mensaje nuevo' : 'mensajes nuevos' %>
                                        </span>
                                        <h4 class="fw-bold mb-1 text-dark">¡El Administrador te ha respondido!</h4>
                                        <p class="mb-0 text-muted small">
                                            Tienes respuestas pendientes del equipo de soporte en nuestro chat interno. Revisa el chat para conocer el estado de tus consultas o reportes de pago.
                                        </p>
                                    </div>
                                    <div class="col-md-4 col-lg-3 text-md-end mt-3 mt-md-0">
                                        <a href="/portal-cliente/chat" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center" style="transition: all 0.3s ease;">
                                            <i class="bi bi-headset me-2"></i> Ir a Soporte
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Banner de Fidelización - Cupo Pre-aprobado -->
                    <% if (cliente.monto_preaprobado && parseFloat(cliente.monto_preaprobado) > 0) { %>
                        <div class="card border-0 shadow-lg rounded-4 mb-4 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #6366f1 0%, #10b981 100%);">
                            <div class="position-absolute top-0 end-0 opacity-10" style="font-size: 8rem; transform: translate(20%, -20%); pointer-events: none;">
                                <i class="bi bi-award-fill"></i>
                            </div>
                            <div class="card-body p-4 position-relative">
                                <div class="row align-items-center">
                                    <div class="col-md-8 col-lg-9">
                                        <span class="badge bg-white bg-opacity-25 text-white mb-2 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.75rem;">
                                            <i class="bi bi-gem me-1 animate-pulse"></i> Oportunidad Exclusiva
                                        </span>
                                        <h4 class="fw-bold mb-1"><i class="bi bi-rocket-takeoff-fill"></i> ¡Tienes un cupo pre-aprobado disponible!</h4>
                                        <p class="mb-0 text-white-50 small">
                                            Por tu excelente historial de pago, tienes acceso inmediato a un desembolso de hasta 
                                            <strong class="text-white">$<%= parseFloat(cliente.monto_preaprobado).toLocaleString('es-CO') %></strong>. 
                                            Solicítalo en segundos y recíbelo directamente en tu cuenta registrada.
                                        </p>
                                    </div>
                                    <div class="col-md-4 col-lg-3 text-md-end mt-3 mt-md-0">
                                        <button class="btn btn-light text-success fw-bold rounded-pill px-4 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalSolicitarCupo" style="transition: all 0.3s ease;">
                                            <i class="bi bi-cash-coin me-1"></i> Retirar Cupo
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Préstamos Activos -->
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-activity text-success me-2"></i> Préstamos Activos</h5>
                    <div class="row g-3 mb-5">
                        <% if(prestamosActivos && prestamosActivos.length > 0) { %>
                            <% prestamosActivos.forEach(p => { %>
                                <div class="col-12 col-xl-6">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <div class="card-body p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                                <div>
                                                    <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1 fw-bold">
                                                        Préstamo #<%= p.id %>
                                                    </span>
                                                    <small class="text-muted d-block mt-2">Iniciado: <%= new Date(p.fecha_inicio).toLocaleDateString() %></small>
                                                </div>
                                                <div class="text-end">
                                                    <% if(p.estado === 'vencido') { %>
                                                        <span class="badge bg-danger">Vencido</span>
                                                    <% } else { %>
                                                        <span class="badge bg-success">Al Día</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                            
                                            <div class="row mt-3">
                                                <div class="col-6">
                                                    <p class="text-muted small mb-1">Monto Total</p>
                                                    <h5 class="fw-bold">$<%= parseFloat(p.monto_total).toLocaleString('en-US', {minimumFractionDigits: 2}) %></h5>
                                                </div>
                                                <div class="col-6 text-end">
                                                    <p class="text-muted small mb-1">Pagado</p>
                                                    <h5 class="fw-bold text-success">$<%= parseFloat(p.total_pagado || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %></h5>
                                                </div>
                                            </div>

                                            <div class="mt-3">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <span class="small text-muted">Progreso</span>
                                                    <span class="small fw-bold text-success"><%= ((p.total_pagado / p.monto_total) * 100).toFixed(0) %>%</span>
                                                </div>
                                                <div class="progress" style="height: 8px;">
                                                    <div class="progress-bar bg-success" style="width: <%= (p.total_pagado / p.monto_total) * 100 %>%"></div>
                                                </div>
                                            </div>

                                            <% 
                                            if (p.fecha_proxima_cuota) { 
                                                const hoy = new Date();
                                                hoy.setHours(0,0,0,0);
                                                const fechaCuota = new Date(p.fecha_proxima_cuota);
                                                fechaCuota.setHours(0,0,0,0);
                                                const esCuotaVencida = fechaCuota < hoy;
                                            %>
                                                <div class="mt-4 p-3 rounded-4 <%= esCuotaVencida ? 'bg-danger bg-opacity-10 border border-danger-subtle' : 'bg-primary-subtle bg-opacity-25 border border-primary-subtle' %>" style="border: 1px solid;">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="small fw-bold <%= esCuotaVencida ? 'text-danger' : 'text-primary' %>">
                                                            <i class="bi <%= esCuotaVencida ? 'bi-exclamation-triangle-fill text-danger animate-pulse' : 'bi-calendar-check-fill' %> me-1"></i>
                                                            Próxima Cuota #<%= p.numero_proxima_cuota %>
                                                        </span>
                                                        <% if (esCuotaVencida) { %>
                                                            <span class="badge bg-danger rounded-pill px-2 py-1 text-uppercase font-monospace" style="font-size: 0.7rem;">¡Vencida!</span>
                                                        <% } else { %>
                                                            <span class="badge bg-primary rounded-pill px-2 py-1 text-uppercase font-monospace" style="font-size: 0.7rem;">Pendiente</span>
                                                        <% } %>
                                                    </div>
                                                    <div class="row align-items-center">
                                                        <div class="col-7 col-sm-8">
                                                            <p class="mb-0 text-muted small" style="font-size: 0.75rem;">Vence el:</p>
                                                            <h6 class="mb-0 fw-bold <%= esCuotaVencida ? 'text-danger' : 'text-dark' %>" style="font-size: 0.85rem;">
                                                                <%= new Date(p.fecha_proxima_cuota).toLocaleDateString('es-CO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                                            </h6>
                                                        </div>
                                                        <div class="col-5 col-sm-4 text-end">
                                                            <p class="mb-0 text-muted small" style="font-size: 0.75rem;">Monto:</p>
                                                            <h6 class="mb-0 fw-bold <%= esCuotaVencida ? 'text-danger' : 'text-primary' %>" style="font-size: 1.1rem;">
                                                                $<%= parseFloat(p.restante_proxima_cuota).toLocaleString('es-CO', {minimumFractionDigits: 2}) %>
                                                            </h6>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% } else { %>
                                                <div class="mt-4 p-3 bg-success bg-opacity-10 border border-success-subtle rounded-4 text-center">
                                                    <span class="small fw-bold text-success">
                                                        <i class="bi bi-patch-check-fill me-1"></i> ¡Estás al día! No tienes más cuotas programadas.
                                                    </span>
                                                </div>
                                            <% } %>

                                            <!-- Historial de Pagos Colapsable -->
                                            <div class="mt-3">
                                                <div class="d-grid">
                                                    <button class="btn btn-outline-secondary btn-sm rounded-pill fw-bold border-1 py-2 text-muted shadow-xs d-flex align-items-center justify-content-center" type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#historialCollapse<%= p.id %>"
                                                        style="font-size: 0.8rem; border-color: #e2e8f0; transition: all 0.2s;">
                                                        <i class="bi bi-clock-history me-1.5"></i> Ver Historial de Pagos
                                                    </button>
                                                </div>
                                                <div class="collapse mt-2" id="historialCollapse<%= p.id %>">
                                                    <div class="card card-body bg-light border-0 rounded-4 p-3 shadow-sm">
                                                        <ul class="list-group list-group-flush bg-transparent mb-0 small">
                                                            <% if(p.pagos && p.pagos.length > 0) { %>
                                                                <% p.pagos.forEach(h => { %>
                                                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-0 px-0 py-1.5">
                                                                        <span class="text-muted">
                                                                            <i class="bi bi-calendar-check text-success me-1.5"></i>
                                                                            <%= new Date(h.fecha_pago).toLocaleDateString('es-CO') %>
                                                                        </span>
                                                                        <span class="fw-bold text-success font-monospace" style="font-size: 0.9rem;">
                                                                            + $<%= parseFloat(h.monto_pagado).toLocaleString('es-CO') %>
                                                                        </span>
                                                                    </li>
                                                                <% }) %>
                                                            <% } else { %>
                                                                <li class="list-group-item bg-transparent border-0 px-0 text-center text-muted py-2">
                                                                    <i class="bi bi-info-circle me-1"></i> Sin pagos registrados aún.
                                                                </li>
                                                            <% } %>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                                                <a href="/prestamos/pdf-cronograma/<%= p.id %>" target="_blank" class="btn btn-outline-dark btn-sm flex-fill text-nowrap">
                                                    <i class="bi bi-file-earmark-pdf text-danger"></i> Cronograma
                                                </a>
                                                <a href="/prestamos/pdf-contrato/<%= p.id %>" target="_blank" class="btn btn-outline-dark btn-sm flex-fill text-nowrap">
                                                    <i class="bi bi-file-text text-primary"></i> Contrato
                                                </a>
                                                <button type="button" class="btn btn-success btn-sm flex-fill fw-bold text-nowrap btn-reportar-pago" data-prestamo-id="<%= p.id %>" data-monto="<%= p.fecha_proxima_cuota ? Math.round(p.restante_proxima_cuota) : '' %>">
                                                    <i class="bi bi-wallet2 me-1"></i> Reportar Pago
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-12">
                                <div class="alert alert-info border-0 shadow-sm d-flex align-items-center">
                                    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                    <div>No tienes préstamos activos en este momento.</div>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Cuentas de Ahorro -->
                    <% if(cuentaAhorro) { %>
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-piggy-bank text-warning me-2"></i> Mi Cuenta de Ahorro</h5>
                        <div class="row g-3 mb-5">
                            <div class="col-12 col-xl-6">
                                <div class="card border-0 shadow-sm rounded-4 h-100 bg-warning bg-opacity-10">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div>
                                                <h6 class="fw-bold text-warning mb-1">Saldo Disponible</h6>
                                                <h3 class="fw-bold mb-0">$<%= parseFloat(cuentaAhorro.saldo_actual).toLocaleString('en-US', {minimumFractionDigits: 2}) %></h3>
                                            </div>
                                            <div class="text-end">
                                                <i class="bi bi-wallet2 text-warning opacity-50" style="font-size: 3rem;"></i>
                                            </div>
                                        </div>
                                        <% if(cuentaAhorro.meta_nombre && cuentaAhorro.meta_monto) { %>
                                            <div class="mt-4 pt-3 border-top border-warning border-opacity-25">
                                                <p class="text-muted small mb-1">Meta: <%= cuentaAhorro.meta_nombre %></p>
                                                <div class="d-flex justify-content-between mb-1">
                                                    <span class="small text-muted">Progreso</span>
                                                    <span class="small fw-bold text-warning"><%= ((cuentaAhorro.saldo_actual / cuentaAhorro.meta_monto) * 100).toFixed(0) %>%</span>
                                                </div>
                                                <div class="progress" style="height: 8px;">
                                                    <div class="progress-bar bg-warning" style="width: <%= (cuentaAhorro.saldo_actual / cuentaAhorro.meta_monto) * 100 %>%"></div>
                                                </div>
                                                <p class="text-end text-muted small mt-1">Objetivo: $<%= parseFloat(cuentaAhorro.meta_monto).toLocaleString('en-US', {minimumFractionDigits: 2}) %></p>
                                            </div>
                                        <% } %>
                                        <div class="mt-4 pt-3 border-top border-warning border-opacity-25 d-flex flex-wrap gap-2">
                                            <button type="button" class="btn btn-warning btn-sm flex-fill fw-bold text-nowrap" data-bs-toggle="modal" data-bs-target="#modalReportarAporte">
                                                <i class="bi bi-piggy-bank me-1"></i> Reportar Aporte
                                            </button>
                                            <button type="button" class="btn btn-outline-dark btn-sm flex-fill fw-bold text-nowrap" data-bs-toggle="modal" data-bs-target="#modalSolicitarRetiro">
                                                <i class="bi bi-cash-stack me-1"></i> Solicitar Retiro
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Historial de Movimientos -->
                            <div class="col-12 col-xl-6">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-header bg-white border-bottom-0 p-3 pb-0">
                                        <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                                            <i class="bi bi-clock-history text-warning me-2"></i> Historial de Movimientos
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill ms-auto" style="font-size: 0.7rem;"><%= locals.movimientosAhorro ? movimientosAhorro.length : 0 %></span>
                                        </h6>
                                    </div>
                                    <div class="card-body p-0" style="max-height: 320px; overflow-y: auto;">
                                        <% if(locals.movimientosAhorro && movimientosAhorro.length > 0) { %>
                                            <div class="list-group list-group-flush">
                                                <% movimientosAhorro.slice(0, 15).forEach(mov => { %>
                                                    <div class="list-group-item border-0 px-3 py-2.5 d-flex align-items-center gap-3">
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px; background-color: <%= mov.tipo_movimiento === 'deposito' ? '#dcfce7' : '#fee2e2' %>;">
                                                            <i class="bi <%= mov.tipo_movimiento === 'deposito' ? 'bi-arrow-down-circle text-success' : 'bi-arrow-up-circle text-danger' %>" style="font-size: 1.1rem;"></i>
                                                        </div>
                                                        <div class="flex-grow-1 min-w-0">
                                                            <div class="fw-bold small text-dark text-truncate">
                                                                <%= mov.tipo_movimiento === 'deposito' ? 'Depósito' : 'Retiro' %>
                                                            </div>
                                                            <small class="text-muted" style="font-size: 0.7rem;">
                                                                <%= new Date(mov.fecha_movimiento).toLocaleDateString() %> · <%= new Date(mov.fecha_movimiento).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                                            </small>
                                                        </div>
                                                        <div class="text-end flex-shrink-0">
                                                            <span class="fw-bold font-monospace small <%= mov.tipo_movimiento === 'deposito' ? 'text-success' : 'text-danger' %>">
                                                                <%= mov.tipo_movimiento === 'deposito' ? '+' : '-' %>$<%= parseFloat(mov.monto).toLocaleString('es-CO') %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <div class="text-center py-5 px-3">
                                                <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                                                <p class="text-muted small mt-2 mb-0">Aún no tienes movimientos registrados.</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Empeños -->
                    <% if(empenos && empenos.length > 0) { %>
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-gem text-info me-2"></i> Mis Empeños</h5>
                        <div class="row g-3 mb-5">
                            <% empenos.forEach(e => { %>
                                <div class="col-12 col-xl-6">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <div class="card-body p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                                <div>
                                                    <span class="badge bg-info-subtle text-info border rounded-pill px-3 py-1 fw-bold">
                                                        Empeño #<%= e.id %>
                                                    </span>
                                                    <h6 class="fw-bold mt-2 mb-0"><%= e.articulo %></h6>
                                                </div>
                                                <div class="text-end">
                                                    <% if(e.estado === 'activo') { %>
                                                        <span class="badge bg-success">Activo</span>
                                                    <% } else if(e.estado === 'vencido') { %>
                                                        <span class="badge bg-danger">Vencido</span>
                                                    <% } else if(e.estado === 'retirado') { %>
                                                        <span class="badge bg-secondary">Retirado</span>
                                                    <% } else if(e.estado === 'rematado') { %>
                                                        <span class="badge bg-dark">Rematado</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                            
                                            <div class="row mt-3">
                                                <div class="col-6">
                                                    <p class="text-muted small mb-1">Préstamo Base</p>
                                                    <h5 class="fw-bold text-dark">$<%= parseFloat(e.monto_prestamo).toLocaleString('en-US', {minimumFractionDigits: 2}) %></h5>
                                                </div>
                                                <div class="col-6 text-end">
                                                    <p class="text-muted small mb-1">Fecha Límite</p>
                                                    <h6 class="fw-bold text-danger"><%= new Date(e.fecha_vencimiento).toLocaleDateString() %></h6>
                                                </div>
                                            </div>
                                            <% if(e.descripcion) { %>
                                                <p class="text-muted small mt-2 mb-0 text-truncate"><i class="bi bi-info-circle me-1"></i><%= e.descripcion %></p>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>

                    <!-- Mis Reportes de Pago -->
                    <h5 id="seccion-reportes" class="fw-bold text-dark mb-3"><i class="bi bi-receipt text-success me-2"></i> Mis Reportes de Pago</h5>
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">Reporte ID</th>
                                            <th>Préstamo</th>
                                            <th>Monto Reportado</th>
                                            <th>Fecha Envío</th>
                                            <th>Estado</th>
                                            <th class="text-end pe-4">Detalle</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if(locals.reportesPago && reportesPago.length > 0) { %>
                                            <% reportesPago.forEach(rp => { %>
                                                <tr>
                                                    <td class="ps-4 fw-bold text-success">#<%= rp.id %></td>
                                                    <td>
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5">
                                                            Préstamo #<%= rp.prestamo_id %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <h6 class="fw-bold text-dark mb-0 font-monospace">
                                                            $<%= parseFloat(rp.monto).toLocaleString('es-CO') %>
                                                        </h6>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted d-block">
                                                            <%= new Date(rp.fecha_reporte).toLocaleDateString() %>
                                                        </small>
                                                        <small class="text-muted" style="font-size: 0.75rem;">
                                                            <%= new Date(rp.fecha_reporte).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                                        </small>
                                                    </td>
                                                    <td>
                                                        <% if(rp.estado === 'pendiente') { %>
                                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2.5 py-1">
                                                                <i class="bi bi-clock-history me-1"></i> Pendiente
                                                            </span>
                                                        <% } else if(rp.estado === 'aprobado') { %>
                                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                                                <i class="bi bi-check-circle-fill me-1"></i> Aprobado
                                                            </span>
                                                        <% } else if(rp.estado === 'rechazado') { %>
                                                            <button class="btn btn-sm btn-link text-danger p-0 fw-bold border-0 align-baseline btn-ver-motivo" data-motivo="<%= rp.observaciones || 'No se especificaron motivos en el sistema.' %>" style="text-decoration: none;">
                                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1 animate-pulse">
                                                                    <i class="bi bi-x-circle-fill me-1"></i> Rechazado (Ver motivo)
                                                                </span>
                                                            </button>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        <% if(rp.comprobante_url) { %>
                                                            <a href="<%= rp.comprobante_url %>" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill" title="Ver Comprobante">
                                                                <i class="bi bi-image"></i>
                                                            </a>
                                                        <% } else { %>
                                                            <span class="text-muted small" title="Pago en efectivo / sin comprobante">
                                                                <i class="bi bi-dash"></i>
                                                            </span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="6" class="text-center py-4 text-muted">Aún no has reportado ningún pago por este medio.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <% if (cuentaAhorro) { %>
                    <!-- Mis Aportes de Ahorro -->
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-piggy-bank text-warning me-2"></i> Mis Aportes de Ahorro</h5>
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">ID</th>
                                            <th>Monto</th>
                                            <th>Fecha</th>
                                            <th>Estado</th>
                                            <th class="text-end pe-4">Comprobante</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if(locals.reportesAporte && reportesAporte.length > 0) { %>
                                            <% reportesAporte.forEach(ra => { %>
                                                <tr>
                                                    <td class="ps-4 fw-bold text-warning">#<%= ra.id %></td>
                                                    <td>
                                                        <h6 class="fw-bold text-dark mb-0 font-monospace">
                                                            $<%= parseFloat(ra.monto).toLocaleString('es-CO') %>
                                                        </h6>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted d-block">
                                                            <%= new Date(ra.fecha_reporte).toLocaleDateString() %>
                                                        </small>
                                                    </td>
                                                    <td>
                                                        <% if(ra.estado === 'pendiente') { %>
                                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2.5 py-1">
                                                                <i class="bi bi-clock-history me-1"></i> Pendiente
                                                            </span>
                                                        <% } else if(ra.estado === 'aprobado') { %>
                                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                                                <i class="bi bi-check-circle-fill me-1"></i> Aprobado
                                                            </span>
                                                        <% } else if(ra.estado === 'rechazado') { %>
                                                            <button class="btn btn-sm btn-link text-danger p-0 fw-bold border-0 align-baseline btn-ver-motivo" data-motivo="<%= ra.observaciones || 'No se especificó un motivo de rechazo.' %>" style="text-decoration: none;">
                                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1 animate-pulse">
                                                                    <i class="bi bi-x-circle-fill me-1"></i> Rechazado (Ver motivo)
                                                                </span>
                                                            </button>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        <% if(ra.comprobante_url) { %>
                                                            <a href="<%= ra.comprobante_url %>" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill" title="Ver Comprobante">
                                                                <i class="bi bi-image"></i>
                                                            </a>
                                                        <% } else { %>
                                                            <span class="text-muted small" title="Aporte en efectivo / sin comprobante">
                                                                <i class="bi bi-dash"></i>
                                                            </span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">Aún no has reportado ningún aporte de ahorro.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Mis Solicitudes de Retiro -->
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-cash-stack text-dark me-2"></i> Mis Solicitudes de Retiro</h5>
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">ID</th>
                                            <th>Monto Solicitado</th>
                                            <th>Fecha</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if(locals.solicitudesRetiro && solicitudesRetiro.length > 0) { %>
                                            <% solicitudesRetiro.forEach(sr => { %>
                                                <tr>
                                                    <td class="ps-4 fw-bold">#<%= sr.id %></td>
                                                    <td>
                                                        <h6 class="fw-bold text-danger mb-0 font-monospace">
                                                            $<%= parseFloat(sr.monto_solicitado).toLocaleString('es-CO') %>
                                                        </h6>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted d-block">
                                                            <%= new Date(sr.fecha_solicitud).toLocaleDateString() %>
                                                        </small>
                                                    </td>
                                                    <td>
                                                        <% if(sr.estado === 'pendiente') { %>
                                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2.5 py-1">
                                                                <i class="bi bi-clock-history me-1"></i> Pendiente
                                                            </span>
                                                        <% } else if(sr.estado === 'aprobado') { %>
                                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                                                <i class="bi bi-check-circle-fill me-1"></i> Aprobado
                                                            </span>
                                                        <% } else if(sr.estado === 'rechazado') { %>
                                                            <button class="btn btn-sm btn-link text-danger p-0 fw-bold border-0 align-baseline btn-ver-motivo" data-motivo="<%= sr.comentarios || 'No se especificó un motivo de rechazo.' %>" style="text-decoration: none;">
                                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1 animate-pulse">
                                                                    <i class="bi bi-x-circle-fill me-1"></i> Rechazado (Ver motivo)
                                                                </span>
                                                            </button>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted">Aún no has solicitado ningún retiro.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <!-- Préstamos Históricos -->
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history text-secondary me-2"></i> Historial (Pagados)</h5>
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">ID</th>
                                            <th>Fecha Fin</th>
                                            <th>Monto</th>
                                            <th class="text-end pe-4">Documentos</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if(prestamosPagados && prestamosPagados.length > 0) { %>
                                            <% prestamosPagados.forEach(p => { %>
                                                <tr>
                                                    <td class="ps-4 fw-bold">#<%= p.id %></td>
                                                    <td><%= p.fecha_fin ? new Date(p.fecha_fin).toLocaleDateString() : 'N/A' %></td>
                                                    <td class="fw-bold text-success">$<%= parseFloat(p.monto_total).toLocaleString('en-US', {minimumFractionDigits: 2}) %></td>
                                                    <td class="text-end pe-4">
                                                        <a href="/prestamos/pdf-cronograma/<%= p.id %>" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill" title="Ver Historial de Pagos">
                                                            <i class="bi bi-file-earmark-pdf"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted">Sin historial de préstamos cancelados.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <!-- Cierre de columnas de préstamos/ahorros/historial -->
                </div>
            </div>
        </div>
    </div>

    <!-- Estilos Premium Adicionales -->
    <style>
        .hover-scale {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .hover-scale:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1) !important;
        }
        .upload-area {
            border: 2px dashed #10b981;
            background-color: #f0fdf4;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .upload-area:hover {
            background-color: #dcfce7;
            border-color: #059669;
        }
        .custom-slider::-webkit-slider-thumb {
            background: #10b981 !important;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
        }
        .custom-slider::-moz-range-thumb {
            background: #10b981 !important;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
        }
        .font-monospace {
            font-family: 'Courier New', Courier, monospace;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
    </style>

    <!-- 1. MODAL: REPORTAR PAGO -->
    <div class="modal fade" id="modalReportarPago" tabindex="-1" aria-labelledby="modalReportarPagoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-success text-white py-3">
                    <h5 class="modal-title fw-bold" id="modalReportarPagoLabel">
                        <i class="bi bi-wallet2 me-2"></i> Reportar Pago Rápido
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/portal-cliente/reportar-pago" method="POST" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        
                        <!-- Cuentas de Transferencia Autorizadas -->
                        <div class="p-3 rounded-4 mb-3 border border-dashed border-success border-2 bg-light">
                            <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-bank text-success me-1"></i> Canales de Pago Autorizados</h6>
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-center p-2 bg-white rounded-3 shadow-xs">
                                    <div>
                                        <span class="small text-muted d-block" style="font-size: 0.7rem; font-weight: 700;">CELULAR NEQUI</span>
                                        <span class="fw-bold text-dark font-monospace" id="nequiCopy"><%= (typeof empresa !== 'undefined' && empresa.nequi_numero) ? empresa.nequi_numero : '3123456789' %></span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-success border-0 px-2 rounded-circle btn-copiar-datos" data-copiar="<%= (typeof empresa !== 'undefined' && empresa.nequi_numero) ? empresa.nequi_numero : '3123456789' %>" title="Copiar número">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                                <div class="d-flex justify-content-between align-items-center p-2 bg-white rounded-3 shadow-xs">
                                    <div>
                                        <span class="small text-muted d-block" style="font-size: 0.7rem; font-weight: 700;">BRE-B / TRANSFIYA (CELULAR)</span>
                                        <span class="fw-bold text-dark font-monospace" id="transfiyaCopy"><%= (typeof empresa !== 'undefined' && empresa.breve_numero) ? empresa.breve_numero : '3123456789' %></span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-success border-0 px-2 rounded-circle btn-copiar-datos" data-copiar="<%= (typeof empresa !== 'undefined' && empresa.breve_numero) ? empresa.breve_numero : '3123456789' %>" title="Copiar llave">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Préstamo ID -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Préstamo Asociado</label>
                            <select name="prestamo_id" id="formReportarPrestamoId" class="form-select rounded-pill px-3" required>
                                <option value="" disabled selected>Selecciona tu préstamo...</option>
                                <% if (prestamosActivos && prestamosActivos.length > 0) { %>
                                    <% prestamosActivos.forEach(p => { %>
                                        <option value="<%= p.id %>">Préstamo #<%= p.id %> (Monto Total: $<%= parseFloat(p.monto_total).toLocaleString('es-CO') %>)</option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <!-- Monto del Abono -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Monto del Abono ($ Pesos Colombianos)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-dark rounded-start-pill border-end-0 px-3 fw-bold">$</span>
                                <input type="text" name="monto" id="formReportarMonto" class="form-control rounded-end-pill px-3 border-start-0 currency-input fw-bold text-success fs-5" placeholder="0" required>
                            </div>
                            <small class="text-muted" style="font-size: 0.75rem;">Ingresa el valor transferido sin centavos.</small>
                        </div>

                        <!-- Comprobante File Uploader -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Captura o Foto del Comprobante</label>
                            <div class="upload-area p-4 rounded-4 text-center position-relative" id="dropArea">
                                <input type="file" name="comprobante" id="fileInput" class="position-absolute top-0 start-0 opacity-0 w-100 h-100 cursor-pointer" accept="image/*">
                                <i class="bi bi-cloud-arrow-up-fill text-success fs-1 mb-2 d-block"></i>
                                <span class="fw-bold text-dark d-block" id="fileName">Arrastra aquí tu comprobante, haz clic, o déjalo vacío si es pago en efectivo</span>
                                <small class="text-muted" style="font-size: 0.75rem;">Formatos aceptados: JPG, JPEG, PNG (Máx 5MB)</small>
                            </div>
                        </div>

                        <!-- Observaciones -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Notas / Comentarios (Opcional)</label>
                            <textarea name="observaciones" class="form-control rounded-3" rows="2" placeholder="Ej. Abono cuota #3 de este mes."></textarea>
                        </div>

                    </div>
                    <div class="modal-footer bg-light border-0 py-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                            <i class="bi bi-send-fill me-1"></i> Enviar Reporte
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. MODAL: SOLICITAR PRESTAMO CUPO PRE-APROBADO -->
    <% if (cliente.monto_preaprobado && parseFloat(cliente.monto_preaprobado) > 0) { %>
    <div class="modal fade" id="modalSolicitarCupo" tabindex="-1" aria-labelledby="modalSolicitarCupoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white py-3">
                    <h5 class="modal-title fw-bold" id="modalSolicitarCupoLabel">
                        <i class="bi bi-rocket-takeoff me-2"></i> Solicitar Desembolso Rápido
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/portal-cliente/solicitar-cupo" method="POST">
                    <div class="modal-body p-4">
