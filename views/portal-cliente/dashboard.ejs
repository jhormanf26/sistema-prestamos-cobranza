                                    </label>
                                    <h2 class="text-center fw-extrabold text-success mb-3 font-monospace py-2 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25" id="sliderAmountDisplay" style="font-size: 2.2rem; letter-spacing: -1px;">
                                        $ 50.000
                                    </h2>
                                    <input type="range" class="form-range custom-slider" id="cupoSlider" min="50000" max="<%= cliente.monto_preaprobado %>" step="10000" value="50000">
                                    <input type="hidden" name="monto_solicitado" id="formCupoMonto" value="50000">
                                </div>

                                <div class="row">
                                    <!-- Cuotas -->
                                    <div class="col-6 mb-3">
                                        <label class="form-label text-dark fw-bold small">Número de Cuotas</label>
                                        <select name="cuotas" id="formCupoCuotas" class="form-select rounded-pill px-3" required>
                                            <option value="1">1 Cuota</option>
                                            <option value="2">2 Cuotas</option>
                                            <option value="3">3 Cuotas</option>
                                            <option value="4">4 Cuotas</option>
                                            <option value="6" selected>6 Cuotas</option>
                                            <option value="12">12 Cuotas</option>
                                            <option value="18">18 Cuotas</option>
                                            <option value="24">24 Cuotas</option>
                                        </select>
                                    </div>
                                    
                                    <!-- Frecuencia -->
                                    <div class="col-6 mb-3">
                                        <label class="form-label text-dark fw-bold small">Frecuencia de Pago</label>
                                        <select name="frecuencia" id="formCupoFrecuencia" class="form-select rounded-pill px-3" required>
                                            <option value="diario">Diario</option>
                                            <option value="semanal">Semanal</option>
                                            <option value="quincenal" selected>Quincenal</option>
                                            <option value="mensual">Mensual</option>
                                            <option value="bimensual">Bimensual</option>
                                            <option value="trimensual">Trimensual</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Resumen / Preview Simulación -->
                            <div class="col-12 col-md-5 mt-4 mt-md-0 border-start ps-md-4">
                                <div class="card border-0 bg-light rounded-4 h-100 shadow-xs">
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                            <i class="bi bi-calculator-fill text-primary"></i> Detalle de Simulación
                                        </h6>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted small">Capital Solicitado:</span>
                                            <span class="fw-bold text-dark font-monospace" id="simCapital">$ 50.000</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted small">Interés Mensual:</span>
                                            <span class="fw-bold text-primary font-monospace" id="simTasa">2.0 %</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted small">Plazo de Pago:</span>
                                            <span class="fw-bold text-dark" id="simCuotasInfo">6 Quincenales</span>
                                        </div>
                                        <hr class="my-3 border-secondary border-opacity-25">
                                        
                                        <div class="text-center mb-3">
                                            <span class="text-muted d-block small" style="font-size: 0.75rem;">VALOR CUOTA ESTIMADO</span>
                                            <h3 class="fw-bold text-success font-monospace my-0" id="simCuotaValor">$ 9.583</h3>
                                        </div>
                                        <div class="text-center bg-white p-2 rounded-3 border">
                                            <span class="text-muted d-block small" style="font-size: 0.7rem;">TOTAL A PAGAR ESTIMADO</span>
                                            <h5 class="fw-bold text-dark font-monospace my-0" id="simTotalPagar">$ 57.500</h5>
                                        </div>
                                        <small class="text-muted d-block mt-3 text-center" style="font-size: 0.7rem;">* Valores aproximados. Sujeto a validación del administrador.</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
