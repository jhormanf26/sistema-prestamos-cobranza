                                                    <button class="btn btn-sm btn-link text-success p-0 fw-bold border-0 align-baseline btn-ver-motivo" data-motivo="<%= sc.comentarios || 'Solicitud aprobada y desembolsada.' %>" style="text-decoration: none;">
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                                            <i class="bi bi-check-circle-fill me-1"></i> Aprobado (Ver detalle)
                                                        </span>
                                                    </button>
                                                <% } else if(sc.estado === 'rechazado') { %>
                                                    <button class="btn btn-sm btn-link text-danger p-0 fw-bold border-0 align-baseline btn-ver-motivo" data-motivo="<%= sc.comentarios || 'No se especificó un motivo de rechazo.' %>" style="text-decoration: none;">
                                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1 animate-pulse">
                                                            <i class="bi bi-x-circle-fill me-1"></i> Rechazado (Ver motivo)
                                                        </span>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="row g-2 pt-2 border-top">
                                            <div class="col-6">
                                                <small class="text-muted d-block" style="font-size: 0.75rem;">Monto Solicitado</small>
                                                <h6 class="fw-bold text-primary mb-0 font-monospace" style="font-size: 0.9rem;">
                                                    $<%= parseFloat(sc.monto_solicitado).toLocaleString('es-CO') %>
                                                </h6>
                                            </div>
                                            <div class="col-6 text-end">
                                                <small class="text-muted d-block" style="font-size: 0.75rem;">Plazo</small>
                                                <span class="small text-dark fw-bold" style="font-size: 0.75rem;">
                                                    <%= sc.cuotas %> Cuotas (<%= sc.frecuencia %>)
                                                </span>
                                            </div>
                                        </div>
                                        <div class="mt-2 pt-2 border-top">
                                            <small class="text-muted" style="font-size: 0.75rem;">Fecha de Solicitud:</small>
                                            <small class="text-dark fw-semibold" style="font-size: 0.75rem;">
                                                <%= new Date(sc.fecha_solicitud).toLocaleDateString() %>
                                            </small>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="card border-0 shadow-sm rounded-4 p-4 text-center text-muted bg-white">
                                Aún no has solicitado ningún préstamo.
                            </div>
                        <% } %>
                    </div>

                    <!-- Préstamos Históricos -->
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history text-secondary me-2"></i> Historial (Pagados)</h5>
                    <!-- Vista Desktop: Tabla -->
                    <div class="d-none d-md-block card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">ID</th>
                                            <th>Fecha Fin</th>
                                            <th>Monto</th>
                                            <th class="text-end pe-4">Documentos</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if(prestamosPagados && prestamosPagados.length > 0) { %>
                                            <% prestamosPagados.forEach(p => { %>
                                                <tr>
                                                    <td class="ps-4 fw-bold">#<%= p.id %></td>
                                                    <td><%= p.fecha_fin ? new Date(p.fecha_fin).toLocaleDateString() : 'N/A' %></td>
                                                    <td class="fw-bold text-success">$<%= parseFloat(p.monto_total).toLocaleString('en-US', {minimumFractionDigits: 2}) %></td>
                                                    <td class="text-end pe-4">
                                                        <a href="/prestamos/pdf-cronograma/<%= p.id %>" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill" title="Ver Historial de Pagos">
                                                            <i class="bi bi-file-earmark-pdf"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted">Sin historial de préstamos cancelados.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Vista Móvil: Tarjetas Premium -->
                    <div class="d-block d-md-none mb-4">
                        <% if(prestamosPagados && prestamosPagados.length > 0) { %>
                            <div class="d-flex flex-column gap-3">
                                <% prestamosPagados.forEach(p => { %>
                                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div>
                                                <span class="fw-bold text-dark" style="font-size: 0.95rem;">#<%= p.id %></span>
                                                <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2.5 py-0.5 ms-2" style="font-size: 0.75rem;">
                                                    Pagado
                                                </span>
                                            </div>
                                            <div>
                                                <a href="/prestamos/pdf-cronograma/<%= p.id %>" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold" style="font-size: 0.75rem;" title="Ver Historial de Pagos">
                                                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i> PDF
                                                </a>
                                            </div>
                                        </div>
                                        <div class="row g-2 pt-2 border-top">
                                            <div class="col-6">
                                                <small class="text-muted d-block" style="font-size: 0.75rem;">Monto Total</small>
                                                <h6 class="fw-bold text-success mb-0 font-monospace" style="font-size: 0.9rem;">
                                                    $<%= parseFloat(p.monto_total).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                                                </h6>
                                            </div>
                                            <div class="col-6 text-end">
                                                <small class="text-muted d-block" style="font-size: 0.75rem;">Fecha Fin</small>
                                                <small class="text-dark fw-semibold" style="font-size: 0.75rem;">
                                                    <%= p.fecha_fin ? new Date(p.fecha_fin).toLocaleDateString() : 'N/A' %>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="card border-0 shadow-sm rounded-4 p-4 text-center text-muted bg-white">
                                Sin historial de préstamos cancelados.
                            </div>
                        <% } %>
                    </div>
                    <!-- Cierre de columnas de préstamos/ahorros/historial -->
                </div>
            </div>
        </div>
    </div>

    <!-- Estilos Premium Adicionales -->
    <style>
        .hover-scale {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .hover-scale:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1) !important;
        }
        .upload-area {
            border: 2px dashed #10b981;
            background-color: #f0fdf4;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .upload-area:hover {
            background-color: #dcfce7;
            border-color: #059669;
        }
        .custom-slider::-webkit-slider-thumb {
            background: #10b981 !important;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
        }
        .custom-slider::-moz-range-thumb {
            background: #10b981 !important;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
        }
        .font-monospace {
            font-family: 'Courier New', Courier, monospace;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
    </style>

    <!-- 1. MODAL: REPORTAR PAGO -->
    <div class="modal fade" id="modalReportarPago" tabindex="-1" aria-labelledby="modalReportarPagoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-success text-white py-3">
                    <h5 class="modal-title fw-bold" id="modalReportarPagoLabel">
                        <i class="bi bi-wallet2 me-2"></i> Reportar Pago Rápido
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/portal-cliente/reportar-pago" method="POST" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        
                        <!-- Cuentas de Transferencia Autorizadas -->
                        <div class="p-3 rounded-4 mb-3 border border-dashed border-success border-2 bg-light">
                            <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-bank text-success me-1"></i> Canales de Pago Autorizados</h6>
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-center p-2 bg-white rounded-3 shadow-xs">
                                    <div>
                                        <span class="small text-muted d-block" style="font-size: 0.7rem; font-weight: 700;">CELULAR NEQUI</span>
                                        <span class="fw-bold text-dark font-monospace" id="nequiCopy"><%= (typeof empresa !== 'undefined' && empresa.nequi_numero) ? empresa.nequi_numero : '--' %></span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-success border-0 px-2 rounded-circle btn-copiar-datos" data-copiar="<%= (typeof empresa !== 'undefined' && empresa.nequi_numero) ? empresa.nequi_numero : '--' %>" title="Copiar número">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                                <div class="d-flex justify-content-between align-items-center p-2 bg-white rounded-3 shadow-xs">
                                    <div>
                                        <span class="small text-muted d-block" style="font-size: 0.7rem; font-weight: 700;">BRE-B / TRANSFIYA (CELULAR)</span>
                                        <span class="fw-bold text-dark font-monospace" id="transfiyaCopy"><%= (typeof empresa !== 'undefined' && empresa.breve_numero) ? empresa.breve_numero : '--' %></span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-success border-0 px-2 rounded-circle btn-copiar-datos" data-copiar="<%= (typeof empresa !== 'undefined' && empresa.breve_numero) ? empresa.breve_numero : '--' %>" title="Copiar llave">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Préstamo ID -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Préstamo Asociado</label>
                            <select name="prestamo_id" id="formReportarPrestamoId" class="form-select rounded-pill px-3" required>
                                <option value="" disabled selected>Selecciona tu préstamo...</option>
                                <% if (prestamosActivos && prestamosActivos.length > 0) { %>
                                    <% prestamosActivos.forEach(p => { %>
                                        <option value="<%= p.id %>">Préstamo #<%= p.id %> (Monto Total: $<%= parseFloat(p.monto_total).toLocaleString('es-CO') %>)</option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <!-- Monto del Abono -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Monto del Abono ($ Pesos Colombianos)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-dark rounded-start-pill border-end-0 px-3 fw-bold">$</span>
                                <input type="text" name="monto" id="formReportarMonto" class="form-control rounded-end-pill px-3 border-start-0 currency-input fw-bold text-success fs-5" placeholder="0" required>
                            </div>
                            <small class="text-muted" style="font-size: 0.75rem;">Ingresa el valor transferido sin centavos.</small>
                        </div>

                        <!-- Comprobante File Uploader -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Captura o Foto del Comprobante</label>
                            <div class="upload-area p-4 rounded-4 text-center position-relative" id="dropArea">
                                <input type="file" name="comprobante" id="fileInput" class="position-absolute top-0 start-0 opacity-0 w-100 h-100 cursor-pointer" accept="image/*">
                                <i class="bi bi-cloud-arrow-up-fill text-success fs-1 mb-2 d-block"></i>
                                <span class="fw-bold text-dark d-block" id="fileName">Arrastra aquí tu comprobante, haz clic, o déjalo vacío si es pago en efectivo</span>
                                <small class="text-muted" style="font-size: 0.75rem;">Formatos aceptados: JPG, JPEG, PNG (Máx 5MB)</small>
                            </div>
                        </div>

                        <!-- Observaciones -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Notas / Comentarios (Opcional)</label>
                            <textarea name="observaciones" class="form-control rounded-3" rows="2" placeholder="Ej. Abono cuota #3 de este mes."></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                                <i class="bi bi-send-fill me-1"></i> Enviar Reporte
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. MODAL: SOLICITAR PRESTAMO -->
    <% 
        const tieneCupo = cliente.monto_preaprobado && parseFloat(cliente.monto_preaprobado) > 0;
        const limiteMaximo = tieneCupo ? parseFloat(cliente.monto_preaprobado) : 3000000;
        const tituloModal = tieneCupo ? 'Solicitar Desembolso Rápido' : 'Solicitar Crédito Ordinario';
        const subtituloMonto = tieneCupo 
            ? `Límite disponible: $${parseFloat(cliente.monto_preaprobado).toLocaleString('es-CO')}` 
            : 'Límite máximo general: $3.000.000';

        // Determinar tasa según score crediticio del cliente (se calcula en el controlador)
        const _tieneScoreReal = (typeof tasaInfoPortal !== 'undefined' && tasaInfoPortal !== null);
        const tasaModalEjs    = _tieneScoreReal ? tasaInfoPortal.tasaMensual : (typeof empresa !== 'undefined' && empresa.interes_global ? parseFloat(empresa.interes_global) : 2.0);
        const tasaCatModal    = _tieneScoreReal ? tasaInfoPortal.categoria : null;
        const tasaDescModal   = _tieneScoreReal ? tasaInfoPortal.descripcion : 'Tasa Estándar';
    %>
    <div class="modal fade" id="modalSolicitarCupo" tabindex="-1" aria-labelledby="modalSolicitarCupoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white py-3">
                    <h5 class="modal-title fw-bold" id="modalSolicitarCupoLabel">
                        <i class="bi bi-rocket-takeoff me-2"></i> <%= tituloModal %>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/portal-cliente/solicitar-cupo" method="POST">
                    <div class="modal-body p-4">
                        <div class="row">
                            <!-- Simulador Interactivo -->
                            <div class="col-12 col-md-7">
                                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-sliders text-primary"></i> Ajusta el Monto y Plazo</h6>
                                
                                <!-- Slider de Monto -->
                                <div class="mb-4">
                                    <label class="form-label d-flex justify-content-between">
                                        <span class="text-muted small">¿Cuánto necesitas?</span>
                                        <span class="text-primary fw-bold small"><%= subtituloMonto %></span>
                                    </label>
                                    <h2 class="text-center fw-extrabold text-success mb-3 font-monospace py-2 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25" id="sliderAmountDisplay" style="font-size: 2.2rem; letter-spacing: -1px;">
                                        $ 50.000
                                    </h2>
                                    <input type="range" class="form-range custom-slider" id="cupoSlider" min="50000" max="<%= limiteMaximo %>" step="10000" value="50000">
                                    <input type="hidden" name="monto_solicitado" id="formCupoMonto" value="50000">
                                </div>

                                <div class="row">
                                    <!-- Cuotas -->
                                    <div class="col-6 mb-3">
                                        <label class="form-label text-dark fw-bold small">Número de Cuotas</label>
                                        <select name="cuotas" id="formCupoCuotas" class="form-select rounded-pill px-3" required>
                                            <option value="1">1 Cuota</option>
                                            <option value="2">2 Cuotas</option>
                                            <option value="3">3 Cuotas</option>
                                            <option value="4">4 Cuotas</option>
                                            <option value="6" selected>6 Cuotas</option>
                                            <option value="12">12 Cuotas</option>
                                            <option value="18">18 Cuotas</option>
                                            <option value="24">24 Cuotas</option>
                                        </select>
                                    </div>
                                    
                                    <!-- Frecuencia -->
                                    <div class="col-6 mb-3">
                                        <label class="form-label text-dark fw-bold small">Frecuencia de Pago</label>
                                        <select name="frecuencia" id="formCupoFrecuencia" class="form-select rounded-pill px-3" required>
                                            <option value="diario">Diario</option>
                                            <option value="semanal">Semanal</option>
                                            <option value="quincenal" selected>Quincenal</option>
                                            <option value="mensual">Mensual</option>
                                            <option value="bimensual">Bimensual</option>
                                            <option value="trimensual">Trimensual</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Resumen / Preview Simulación -->
                            <div class="col-12 col-md-5 mt-4 mt-md-0 border-start ps-md-4">
                                <div class="card border-0 bg-light rounded-4 h-100 shadow-xs">
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                            <i class="bi bi-calculator-fill text-primary"></i> Detalle de Simulación
                                        </h6>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted small">Capital Solicitado:</span>
                                            <span class="fw-bold text-dark font-monospace" id="simCapital">$ 50.000</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted small">Interés Mensual:</span>
                                            <span class="fw-bold text-primary font-monospace" id="simTasa"><%= tasaModalEjs.toFixed(1) %> %
                                                <% if (tasaCatModal) { %>
                                                    <span class="badge bg-primary bg-opacity-15 text-primary rounded-pill ms-1" style="font-size:0.65rem;">Score <%= tasaCatModal %></span>
                                                <% } %>
                                            </span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted small">Plazo de Pago:</span>
                                            <span class="fw-bold text-dark" id="simCuotasInfo">6 Quincenales</span>
                                        </div>
                                        <hr class="my-3 border-secondary border-opacity-25">
                                        
                                        <div class="text-center mb-3">
                                            <span class="text-muted d-block small" style="font-size: 0.75rem;">VALOR CUOTA ESTIMADO</span>
                                            <h3 class="fw-bold text-success font-monospace my-0" id="simCuotaValor">$ 9.583</h3>
                                        </div>
                                        <div class="text-center bg-white p-2 rounded-3 border">
                                            <span class="text-muted d-block small" style="font-size: 0.7rem;">TOTAL A PAGAR ESTIMADO</span>
                                            <h5 class="fw-bold text-dark font-monospace my-0" id="simTotalPagar">$ 57.500</h5>
                                        </div>
                                        <small class="text-muted d-block mt-3 text-center" style="font-size: 0.7rem;">* Valores aproximados. Sujeto a validación del administrador.</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0 py-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-rocket-takeoff-fill me-1"></i> Confirmar Solicitud
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: REPORTAR APORTE AHORRO -->
    <div class="modal fade" id="modalReportarAporte" tabindex="-1" aria-labelledby="modalReportarAporteLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-warning text-dark py-3">
                    <h5 class="modal-title fw-bold" id="modalReportarAporteLabel">
                        <i class="bi bi-piggy-bank me-2"></i> Reportar Aporte de Ahorro
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/portal-cliente/reportar-aporte" method="POST" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        <input type="hidden" name="cuenta_id" value="<%= cuentaAhorro ? cuentaAhorro.id : '' %>">
                        
                        <!-- Cuentas de Transferencia Autorizadas -->
                        <div class="p-3 rounded-4 mb-3 border border-dashed border-warning border-2 bg-light">
                            <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-bank text-warning me-1"></i> Canales de Aporte Autorizados</h6>
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-center p-2 bg-white rounded-3 shadow-xs">
                                    <div>
                                        <span class="small text-muted d-block" style="font-size: 0.7rem; font-weight: 700;">CELULAR NEQUI</span>
                                        <span class="fw-bold text-dark font-monospace" id="nequiCopyAhorro"><%= (typeof empresa !== 'undefined' && empresa.nequi_numero) ? empresa.nequi_numero : '--' %></span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark border-0 px-2 rounded-circle btn-copiar-datos" data-copiar="<%= (typeof empresa !== 'undefined' && empresa.nequi_numero) ? empresa.nequi_numero : '--' %>" title="Copiar número">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                                <div class="d-flex justify-content-between align-items-center p-2 bg-white rounded-3 shadow-xs">
                                    <div>
                                        <span class="small text-muted d-block" style="font-size: 0.7rem; font-weight: 700;">BRE-B / TRANSFIYA (CELULAR)</span>
                                        <span class="fw-bold text-dark font-monospace" id="transfiyaCopyAhorro"><%= (typeof empresa !== 'undefined' && empresa.breve_numero) ? empresa.breve_numero : '--' %></span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark border-0 px-2 rounded-circle btn-copiar-datos" data-copiar="<%= (typeof empresa !== 'undefined' && empresa.breve_numero) ? empresa.breve_numero : '--' %>" title="Copiar llave">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Monto del Aporte -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Monto Consignado ($ Pesos Colombianos)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-dark rounded-start-pill border-end-0 px-3 fw-bold">$</span>
                                <input type="text" name="monto" class="form-control rounded-end-pill px-3 border-start-0 currency-input fw-bold text-warning fs-5" placeholder="0" required>
                            </div>
                            <small class="text-muted" style="font-size: 0.75rem;">Ingresa el valor transferido sin centavos.</small>
                        </div>

                        <!-- Comprobante File Uploader -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Captura o Foto del Comprobante</label>
                            <div class="upload-area p-4 rounded-4 text-center position-relative" style="border-color: #ffc107; background-color: #fffbef;" id="dropAreaAhorro">
                                <input type="file" name="comprobante" class="position-absolute top-0 start-0 opacity-0 w-100 h-100 cursor-pointer upload-input-ahorro" id="fileInputAhorro" accept="image/*">
                                <i class="bi bi-cloud-arrow-up-fill text-warning fs-1 mb-2 d-block"></i>
                                <span class="fw-bold text-dark d-block text-name-ahorro" id="fileNameAhorro">Arrastra aquí tu comprobante, haz clic, o déjalo vacío si es aporte en efectivo</span>
                                <small class="text-muted" style="font-size: 0.75rem;">Formatos aceptados: JPG, JPEG, PNG (Máx 5MB)</small>
                            </div>
                        </div>

                        <!-- Observaciones -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Notas / Comentarios (Opcional)</label>
                            <textarea name="observaciones" class="form-control rounded-3" rows="2" placeholder="Ej. Aporte de quincena"></textarea>
                        </div>

                    </div>
                    <div class="modal-footer bg-light border-0 py-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold text-dark">
                            <i class="bi bi-send-fill me-1"></i> Enviar Reporte
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: SOLICITAR RETIRO AHORRO -->
    <div class="modal fade" id="modalSolicitarRetiro" tabindex="-1" aria-labelledby="modalSolicitarRetiroLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fw-bold text-white" id="modalSolicitarRetiroLabel">
                        <i class="bi bi-cash-stack me-2"></i> Solicitar Retiro de Ahorro
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/portal-cliente/solicitar-retiro" method="POST">
                    <div class="modal-body p-4">
                        <input type="hidden" name="cuenta_id" value="<%= cuentaAhorro ? cuentaAhorro.id : '' %>">
                        
                        <div class="alert alert-info rounded-3 mb-4 border-0">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                                <span class="fw-bold">Saldo Disponible para Retiro</span>
                            </div>
                            <h3 class="mb-0 text-center fw-bold text-dark">$<%= cuentaAhorro ? parseFloat(cuentaAhorro.saldo_actual).toLocaleString('es-CO') : '0' %></h3>
                        </div>

                        <!-- Monto a Retirar -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Monto que deseas retirar</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-dark rounded-start-pill border-end-0 px-3 fw-bold">$</span>
                                <input type="text" name="monto_solicitado" class="form-control rounded-end-pill px-3 border-start-0 currency-input fw-bold text-dark fs-5" placeholder="0" required>
                            </div>
                            <small class="text-muted" style="font-size: 0.75rem;">El dinero será enviado a la cuenta registrada a tu nombre.</small>
                        </div>

                        <!-- Comentarios -->
                        <div class="mb-3">
                            <label class="form-label text-dark fw-bold small">Motivo / Notas (Opcional)</label>
                            <textarea name="comentarios" class="form-control rounded-3" rows="2" placeholder="Ej. Retiro parcial de ahorros"></textarea>
                        </div>

                    </div>
                    <div class="modal-footer bg-light border-0 py-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-dark rounded-pill px-4 fw-bold">
                            <i class="bi bi-send-fill me-1"></i> Solicitar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Toast de Notificación Rápida -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2000;">
        <div id="toastCopiar" class="toast align-items-center text-white bg-success border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fw-bold">
                    <i class="bi bi-check-circle-fill me-2"></i> Copiado al portapapeles correctamente.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Scripts Esenciales -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Formateador y Máscara de Moneda Local para el Portal del Cliente
        window.formatCurrency = (valor, decimales = 0) => {
            if (valor === null || valor === undefined || isNaN(valor)) return '0';
            return new Intl.NumberFormat('es-CO', {
                minimumFractionDigits: decimales,
                maximumFractionDigits: decimales
            }).format(valor);
        };

        window.applyCurrencyMask = (selector) => {
            const inputs = document.querySelectorAll(selector);
            inputs.forEach(input => {
                input.type = 'text'; // Cambiamos a texto para permitir puntos
                
                input.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value === "") {
                        e.target.value = "";
                        return;
                    }
                    
                    const numericValue = parseInt(value, 10);
                    if (isNaN(numericValue)) return;

                    e.target.value = new Intl.NumberFormat('es-CO').format(numericValue);
                    
                    // Disparar evento personalizado para otros oyentes
                    e.target.dispatchEvent(new CustomEvent('moneyInput', { detail: { rawValue: value } }));
                });

                // Formatear valor inicial si existe
                if (input.value) {
                    let initialValue = input.value.replace(/\D/g, '');
                    if (initialValue) {
                        try {
                            input.value = new Intl.NumberFormat('es-CO').format(parseInt(initialValue, 10));
                        } catch (e) {
                            console.error("Error formatting initial value", e);
                        }
                    }
                }
            });
        };

        document.addEventListener("DOMContentLoaded", function () {
            // --- 1. MANEJO DEL SIDEBAR EN MÓVILES ---
            const sidebar = document.getElementById("sidebarMenu");
            const openBtn = document.getElementById("openSidebarBtn");
            const closeBtn = document.getElementById("closeSidebarBtn");
            const overlay = document.getElementById("sidebarOverlay");

            if(openBtn && closeBtn && sidebar) {
                openBtn.addEventListener("click", () => {
                    sidebar.classList.add("sidebar-open");
                    if(overlay) overlay.classList.add("active");
                });
                closeBtn.addEventListener("click", () => {
                    sidebar.classList.remove("sidebar-open");
                    if(overlay) overlay.classList.remove("active");
                });
            }
            if(overlay) {
                overlay.addEventListener("click", () => {
                    sidebar.classList.remove("sidebar-open");
                    overlay.classList.remove("active");
                });
            }

            // --- SCROLL SUAVE A LA SECCIÓN DE REPORTES ---
            const btnSidebarReportes = document.querySelector('.btn-sidebar-reportes');
            if (btnSidebarReportes) {
                btnSidebarReportes.addEventListener('click', function(e) {
                    if (window.location.pathname === '/portal-cliente' || window.location.pathname === '/portal-cliente/') {
                        e.preventDefault();
                        const seccion = document.getElementById('seccion-reportes');
                        if (seccion) {
                            seccion.scrollIntoView({ behavior: 'smooth' });
                            // Cerrar sidebar en móviles si está abierto
                            if (sidebar) {
                                sidebar.classList.remove("sidebar-open");
                                if (overlay) overlay.classList.remove("active");
                            }
                        }
                    }
                });
            }

            // Si entra con el hash directamente, hacer scroll suave al cargar
            if (window.location.hash === '#seccion-reportes') {
                setTimeout(() => {
                    const seccion = document.getElementById('seccion-reportes');
                    if (seccion) {
                        seccion.scrollIntoView({ behavior: 'smooth' });
                    }
                }, 300);
            }

            // --- 2. DETECTAR INSTALACIÓN PWA ---
            if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true) {
                fetch('/portal-cliente/registrar-instalacion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                }).catch(e => console.error('Error registrando app:', e));
            }

            // --- 3. NOTIFICACIONES PUSH CLIENTE ---
            const btnPush = document.getElementById('btnHabilitarPushCliente');
            if(btnPush) {
                if ('serviceWorker' in navigator && 'PushManager' in window) {
                    navigator.serviceWorker.ready.then(async (registration) => {
                        try {
                            const subscription = await registration.pushManager.getSubscription();
                            if (subscription) {
                                btnPush.innerHTML = '<i class="bi bi-check-circle"></i> Activas';
                                btnPush.classList.replace('btn-info', 'btn-success');
                            }
                        } catch (e) {
                            console.error("Error al chequear suscripción push:", e);
                        }
                    }).catch(err => console.error("SW no listo:", err));
                }

                btnPush.addEventListener('click', async () => {
                    const originalText = btnPush.innerHTML;
                    btnPush.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                    btnPush.disabled = true;

                    try {
                        const permission = await Notification.requestPermission();
                        if (permission !== 'granted') {
                            alert("Permiso denegado. Habilita las notificaciones en tu navegador.");
                            btnPush.innerHTML = originalText;
                            btnPush.disabled = false;
                            return;
                        }

                        const response = await fetch('/push/public-key');
                        const vapidData = await response.json();
                        
                        const urlBase64ToUint8Array = (base64String) => {
                            const padding = '='.repeat((4 - base64String.length % 4) % 4);
                            const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
                            const rawData = window.atob(base64);
                            const outputArray = new Uint8Array(rawData.length);
                            for (let i = 0; i < rawData.length; ++i) {
                                outputArray[i] = rawData.charCodeAt(i);
                            }
                            return outputArray;
                        };

                        const registration = await navigator.serviceWorker.register('/sw.js');
                        const subscription = await registration.pushManager.subscribe({
                            userVisibleOnly: true,
                            applicationServerKey: urlBase64ToUint8Array(vapidData.publicKey)
                        });

                        const deviceInfo = {
                            userAgent: navigator.userAgent,
                            language: navigator.language,
                            platform: navigator.platform || 'unknown',
                            connection: navigator.connection ? navigator.connection.effectiveType : 'unknown',
                            battery: 'unknown',
                            isCharging: 'unknown'
                        };

                        if ('getBattery' in navigator) {
                            try {
                                const battery = await navigator.getBattery();
                                deviceInfo.battery = Math.round(battery.level * 100) + '%';
                                deviceInfo.isCharging = battery.charging ? 'Sí' : 'No';
                            } catch (e) {}
                        }

                        await fetch('/push/subscribe', {
                            method: 'POST',
                            body: JSON.stringify({ subscription, deviceInfo }),
                            headers: { 'Content-Type': 'application/json' }
                        });

                        alert("¡Notificaciones habilitadas con éxito!");
                        btnPush.innerHTML = '<i class="bi bi-check-circle"></i> Activas';
                        btnPush.classList.replace('btn-info', 'btn-success');
                    } catch (e) {
                        console.error("Error:", e);
                        alert("Ocurrió un error al intentar habilitar las notificaciones.");
                        btnPush.innerHTML = originalText;
                        btnPush.disabled = false;
                    }
                });
            }

            // --- 4. FORMATO DE MÁSCARA DE MONEDA EN COMPROBANTES ---
            if (window.applyCurrencyMask) {
                window.applyCurrencyMask('.currency-input');
            }

            // --- 5. CONTROLADOR DEL BOTÓN "REPORTAR PAGO" EN LAS CUOTAS ---
            const btnsReportar = document.querySelectorAll('.btn-reportar-pago');
            const selectPrestamo = document.getElementById('formReportarPrestamoId');
            const inputMonto = document.getElementById('formReportarMonto');
            const modalReportar = new bootstrap.Modal(document.getElementById('modalReportarPago'));

            btnsReportar.forEach(btn => {
                btn.addEventListener('click', () => {
                    const prestamoId = btn.getAttribute('data-prestamo-id');
                    const montoCuota = btn.getAttribute('data-monto');

                    if (selectPrestamo) {
                        selectPrestamo.value = prestamoId;
                    }
                    if (inputMonto) {
                        inputMonto.value = montoCuota;
                        // Forzar el evento input para que corra la máscara
                        const event = new Event('input', { bubbles: true });
                        inputMonto.dispatchEvent(event);
                    }

                    modalReportar.show();
                });
            });

            // --- 6. UPLOADER VISUAL CON DRAG & DROP ---
            const fileInput = document.getElementById('fileInput');
            const fileName = document.getElementById('fileName');
            const dropArea = document.getElementById('dropArea');

            if (fileInput && fileName) {
                fileInput.addEventListener('change', (e) => {
                    if (fileInput.files.length > 0) {
                        fileName.innerHTML = `<i class="bi bi-check2-circle text-success me-1"></i> ${fileInput.files[0].name}`;
                        fileName.classList.add('text-success');
                    }
                });
            }

            if (dropArea && fileInput) {
                ['dragenter', 'dragover'].forEach(eventName => {
                    dropArea.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        dropArea.style.borderColor = '#059669';
                        dropArea.style.backgroundColor = '#dcfce7';
                    }, false);
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropArea.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        dropArea.style.borderColor = '#10b981';
                        dropArea.style.backgroundColor = '#f0fdf4';
                    }, false);
                });

                dropArea.addEventListener('drop', (e) => {
                    const dt = e.dataTransfer;
                    const files = dt.files;
                    if (files.length > 0) {
                        fileInput.files = files;
                        // Disparar evento change
                        const event = new Event('change', { bubbles: true });
                        fileInput.dispatchEvent(event);
                    }
                }, false);
            }

            // --- 7. COPIAR DATOS DE TRANSFERENCIA ---
            const toastEl = document.getElementById('toastCopiar');
            const toast = new bootstrap.Toast(toastEl);
            const copyBtns = document.querySelectorAll('.btn-copiar-datos');

            copyBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const val = btn.getAttribute('data-copiar');
                    navigator.clipboard.writeText(val).then(() => {
                        toast.show();
                    }).catch(err => {
                        console.error('Error al copiar:', err);
                    });
                });
            });

            // --- 8. SIMULADOR DE CUPO PRE-APROBADO ---
            const cupoSlider = document.getElementById('cupoSlider');
            const formCupoMonto = document.getElementById('formCupoMonto');
            const sliderAmountDisplay = document.getElementById('sliderAmountDisplay');
            const formCupoCuotas = document.getElementById('formCupoCuotas');
            const formCupoFrecuencia = document.getElementById('formCupoFrecuencia');

            const simCapital = document.getElementById('simCapital');
            const simTasa = document.getElementById('simTasa');
            const simCuotasInfo = document.getElementById('simCuotasInfo');
            const simCuotaValor = document.getElementById('simCuotaValor');
            const simTotalPagar = document.getElementById('simTotalPagar');

            function actualizarSimulador() {
                if (!cupoSlider) return;
                const monto = parseFloat(cupoSlider.value);
                if (formCupoMonto) formCupoMonto.value = monto;
                
                // Formatear en el display superior
                if (sliderAmountDisplay) {
                    sliderAmountDisplay.innerText = '$ ' + (window.formatCurrency ? window.formatCurrency(monto, 0) : monto.toLocaleString('es-CO'));
                }

                const cuotas = parseInt(formCupoCuotas.value) || 1;
                const frecuencia = formCupoFrecuencia.value;

                // Tasa mensual dinámica basada en el Score Crediticio del cliente
                const tasaMensual = <%= tasaModalEjs %>;  // Score <%= tasaCatModal %> — <%= tasaDescModal %>

                let factor = 1;
                if (frecuencia === 'diario') factor = 1/30;
                else if (frecuencia === 'semanal') factor = 7/30;
                else if (frecuencia === 'quincenal') factor = 0.5;
                else if (frecuencia === 'mensual') factor = 1;
                else if (frecuencia === 'bimensual') factor = 2;
                else if (frecuencia === 'trimensual') factor = 3;

                const tasaTotal = tasaMensual * (cuotas * factor);
                const montoInteres = monto * (tasaTotal / 100);
                const montoTotal = monto + montoInteres;
                const montoCuota = montoTotal / cuotas;

                if (simCapital) simCapital.innerText = '$ ' + (window.formatCurrency ? window.formatCurrency(monto, 0) : monto.toLocaleString('es-CO'));
                if (simTasa) simTasa.innerText = tasaMensual.toFixed(1) + ' %';
                if (simCuotasInfo) simCuotasInfo.innerText = cuotas + ' ' + frecuencia.charAt(0).toUpperCase() + frecuencia.slice(1) + 's';
                if (simCuotaValor) simCuotaValor.innerText = '$ ' + (window.formatCurrency ? window.formatCurrency(Math.round(montoCuota), 0) : Math.round(montoCuota).toLocaleString('es-CO'));
                if (simTotalPagar) simTotalPagar.innerText = '$ ' + (window.formatCurrency ? window.formatCurrency(Math.round(montoTotal), 0) : Math.round(montoTotal).toLocaleString('es-CO'));
            }

            if (cupoSlider) {
                cupoSlider.addEventListener('input', actualizarSimulador);
                formCupoCuotas.addEventListener('change', actualizarSimulador);
                formCupoFrecuencia.addEventListener('change', actualizarSimulador);
                actualizarSimulador();
            }

            // --- 9. MOTIVO DE RECHAZO EN COMPROBANTES ---
            document.querySelectorAll('.btn-ver-motivo').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const motivo = this.getAttribute('data-motivo') || 'No se especificó motivo de rechazo.';
                    Swal.fire({
                        title: 'Motivo del Rechazo',
                        text: motivo,
                        icon: 'warning',
                        confirmButtonText: 'Entendido',
                        customClass: {
                            confirmButton: 'btn btn-success rounded-pill px-4 fw-bold'
                        },
                        buttonsStyling: false
                    });
                });
            });

            // --- 10. POLLING EN TIEMPO REAL (ESTADO Y CHAT) ---
            setInterval(async () => {
                try {
                    const res = await fetch('/portal-cliente/estado-actual');
                    const data = await res.json();
                    if (data.success) {
                        // 1. Actualizar Chat Badges
                        const openSidebarBtn = document.getElementById('openSidebarBtn');
                        if (openSidebarBtn) {
                            let mobileBadge = openSidebarBtn.querySelector('.bg-danger.rounded-circle');
                            if (data.chatSinLeer > 0) {
                                if (!mobileBadge) {
                                    openSidebarBtn.insertAdjacentHTML('beforeend', `<span class="position-absolute top-0 start-100 translate-middle p-1.5 bg-danger border border-white rounded-circle animate-pulse" style="width: 10px; height: 10px;" id="mobileChatBadge"><span class="visually-hidden">Mensajes no leídos</span></span>`);
                                }
                            } else if (mobileBadge) {
                                mobileBadge.remove();
                            }
                        }

                        const sidebarLink = document.querySelector('#menu a[href="/portal-cliente/chat"]');
                        if (sidebarLink) {
                            let badge = sidebarLink.querySelector('.badge');
                            if (data.chatSinLeer > 0) {
                                if (!badge) {
                                    sidebarLink.insertAdjacentHTML('beforeend', `<span class="badge rounded-pill bg-danger ms-auto me-2 text-white animate-pulse" style="font-size: 0.7rem; padding: 0.3em 0.55em;">${data.chatSinLeer}</span>`);
                                } else {
                                    badge.textContent = data.chatSinLeer;
                                }
                            } else if (badge) {
                                badge.remove();
                            }
                        }

                        // 2. Actualizar Tabla de Reportes
                        if (data.reportes) {
                            data.reportes.forEach(reporte => {
                                const trs = Array.from(document.querySelectorAll('#seccion-reportes + div tbody tr, #seccion-reportes + .card tbody tr, .d-none.d-md-block tbody tr'));
                                const row = trs.find(tr => {
                                    const firstTd = tr.querySelector('td.ps-4');
                                    return firstTd && firstTd.textContent.trim() === '#' + reporte.id;
                                });
                                
                                let newHtml = '';
                                if (reporte.estado === 'pendiente') {
                                    newHtml = `<span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2.5 py-1">
                                                    <i class="bi bi-clock-history me-1"></i> Pendiente
                                                </span>`;
                                } else if (reporte.estado === 'aprobado') {
                                    newHtml = `<span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Aprobado
                                                </span>`;
                                } else if (reporte.estado === 'rechazado') {
                                    const motivo = reporte.observaciones || 'No se especificaron motivos en el sistema.';
                                    newHtml = `<button class="btn btn-sm btn-link text-danger p-0 fw-bold border-0 align-baseline btn-ver-motivo" data-motivo="${motivo}" style="text-decoration: none;">
                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1 animate-pulse">
                                                        <i class="bi bi-x-circle-fill me-1"></i> Rechazado (Ver motivo)
                                                    </span>
                                                </button>`;
                                }

                                if (row) {
                                    const estadoTd = row.querySelector('td:nth-child(5)');
                                    if (estadoTd) {
                                        const currentHtml = estadoTd.innerHTML.toLowerCase();
                                        if (!currentHtml.includes(reporte.estado.toLowerCase())) {
                                            estadoTd.innerHTML = newHtml;
                                            
                                            // Re-bind the click event for the new button
                                            const newBtn = estadoTd.querySelector('.btn-ver-motivo');
                                            if (newBtn) {
                                                newBtn.addEventListener('click', function(e) {
                                                    e.preventDefault();
                                                    Swal.fire({
                                                        title: 'Motivo del Rechazo',
                                                        text: this.getAttribute('data-motivo'),
                                                        icon: 'warning',
                                                        confirmButtonText: 'Entendido',
                                                        customClass: { confirmButton: 'btn btn-success rounded-pill px-4 fw-bold' },
                                                        buttonsStyling: false
                                                    });
                                                });
                                            }
                                        }
                                    }
                                }

                                // Actualizar en vista móvil (tarjetas)
                                const cardMovil = document.querySelector(`.reporte-card-movil[data-reporte-id="${reporte.id}"]`);
                                if (cardMovil) {
                                    const estadoDiv = cardMovil.querySelector('.estado-reporte-movil-container');
                                    if (estadoDiv) {
                                        const currentHtml = estadoDiv.innerHTML.toLowerCase();
                                        if (!currentHtml.includes(reporte.estado.toLowerCase())) {
                                            estadoDiv.innerHTML = newHtml;

                                            // Re-bind the click event for the new button in mobile card
                                            const newBtn = estadoDiv.querySelector('.btn-ver-motivo');
                                            if (newBtn) {
                                                newBtn.addEventListener('click', function(e) {
                                                    e.preventDefault();
                                                    Swal.fire({
                                                        title: 'Motivo del Rechazo',
                                                        text: this.getAttribute('data-motivo'),
                                                        icon: 'warning',
                                                        confirmButtonText: 'Entendido',
                                                        customClass: { confirmButton: 'btn btn-success rounded-pill px-4 fw-bold' },
                                                        buttonsStyling: false
                                                    });
                                                });
                                            }
                                        }
                                    }
                                }
                            });
                        }
                    }
                } catch (error) {
                    console.error('Error polling status:', error);
                }
            }, 8000); // Polling cada 8 segundos

            // --- 11. MERCADOPAGO LOGIC ---
            // Calcular comisión
            function calcularMp(montoNeto) {
                if(!montoNeto || isNaN(montoNeto)) {
                    document.getElementById('txtMpMontoNeto').textContent = '$0';
                    document.getElementById('txtMpComision').textContent = '$0';
                    document.getElementById('txtMpTotal').textContent = '$0';
                    return;
                }
                const costoFijo = 800 * 1.19; // 952
                const porcentajeConIva = 0.0329 * 1.19; // 0.039151
                const reteFuente = 0.015; // 1.5%
                const reteIca = 0.00414; // 0.414%
                
                const porcentajesTotales = porcentajeConIva + reteFuente + reteIca; // 0.058291
                const montoBruto = Math.ceil((montoNeto + costoFijo) / (1 - porcentajesTotales));
                const comision = montoBruto - montoNeto;

                document.getElementById('txtMpMontoNeto').textContent = '$' + montoNeto.toLocaleString('es-CO');
                document.getElementById('txtMpComision').textContent = '$' + comision.toLocaleString('es-CO');
                document.getElementById('txtMpTotal').textContent = '$' + montoBruto.toLocaleString('es-CO');
            }

            // Abrir Modal
            document.querySelectorAll('.btn-pagar-mp').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.getAttribute('data-prestamo-id');
                    let monto = this.getAttribute('data-monto');
                    if(!monto || monto === '') monto = 1000;
                    
                    document.getElementById('mpPrestamoId').value = id;
                    const mpInput = document.getElementById('mpMontoNeto');
                    mpInput.value = monto;
                    // Forzar el evento input para que aplique la máscara de moneda y calcule MP
                    mpInput.dispatchEvent(new Event('input', { bubbles: true }));
                    
                    new bootstrap.Modal(document.getElementById('modalMercadoPago')).show();
                });
            });

            // Cambiar monto en vivo
            document.getElementById('mpMontoNeto')?.addEventListener('input', function() {
                // Remover puntos de miles antes de calcular
                const cleanValue = this.value.replace(/\./g, '');
                calcularMp(parseFloat(cleanValue));
            });

            // Enviar Formulario
            document.getElementById('formMercadoPago')?.addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('btnProcesarMp');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Conectando...';
                btn.disabled = true;

                try {
                    const formData = new FormData(this);
                    
                    // Limpiar puntos de miles antes de enviar al servidor
                    if (formData.has('monto_pagar')) {
                        formData.set('monto_pagar', formData.get('monto_pagar').replace(/\./g, ''));
                    }

                    const res = await fetch('/pagos/checkout', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(Object.fromEntries(formData))
                    });
                    const data = await res.json();
                    
                    if(data.success && data.init_point) {
                        window.location.href = data.init_point; // Redirigir a pasarela
                    } else {
                        Swal.fire('Error', data.message || 'No se pudo generar el pago', 'error');
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    }
                } catch(error) {
                    Swal.fire('Error', 'Error de conexión con el servidor', 'error');
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            });

            // Detectar si venimos de un pago exitoso
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('pago') === 'success') {
                Swal.fire({
                    title: '¡Pago Exitoso!',
                    text: 'Tu pago está siendo procesado automáticamente y se verá reflejado en instantes.',
                    icon: 'success',
                    confirmButtonText: 'Genial',
                    customClass: { confirmButton: 'btn btn-success rounded-pill px-4 fw-bold' },
                    buttonsStyling: false
                });
                // Limpiar URL
                window.history.replaceState({}, document.title, window.location.pathname);
            } else if (urlParams.get('pago') === 'failure') {
                Swal.fire('Pago Fallido', 'No se pudo completar el pago en la pasarela. Intenta de nuevo.', 'error');
                window.history.replaceState({}, document.title, window.location.pathname);
            }

                // --- 12. RETIRO DE AHORROS CON OTP ---
                const formRetiro = document.querySelector('#modalSolicitarRetiro form');
                if (formRetiro) {
                    formRetiro.addEventListener('submit', function(e) {
                        if (formRetiro.querySelector('input[name="otp"]')) {
                            return; // Dejar pasar si ya tiene el input hidden de OTP (submit programático)
                        }
                        
                        e.preventDefault();
                        
                        const cuentaIdInput = formRetiro.querySelector('input[name="cuenta_id"]');
                        const montoInput = formRetiro.querySelector('input[name="monto_solicitado"]');
                        const btnSubmit = formRetiro.querySelector('button[type="submit"]');
                        
                        const cuenta_id = cuentaIdInput ? cuentaIdInput.value : '';
                        const monto_solicitado = montoInput ? montoInput.value : '';
                        
                        if (!cuenta_id || !monto_solicitado) {
                            Swal.fire('Atención', 'Por favor completa todos los campos requeridos.', 'warning');
                            return;
                        }
                        
                        // Validar que el monto no esté vacío o sea inválido
                        const cleanMonto = parseFloat(monto_solicitado.toString().replace(/\./g, '').replace(/,/g, '.').trim());
                        if (isNaN(cleanMonto) || cleanMonto <= 0) {
                            Swal.fire('Atención', 'Por favor ingresa un monto válido.', 'warning');
                            return;
                        }
                        
                        btnSubmit.disabled = true;
                        const originalHtml = btnSubmit.innerHTML;
                        btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Enviando OTP...';
                        
                        // Cerrar el modal de Bootstrap temporalmente para no empalmarse con SweetAlert2
                        const modalEl = document.getElementById('modalSolicitarRetiro');
                        const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                        
                        Swal.fire({
                            title: 'Enviando código...',
                            text: 'Estamos generando tu código de seguridad OTP para autorizar el retiro.',
                            allowOutsideClick: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                        
                        fetch('/portal-cliente/ahorros/otp/solicitar', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                cuenta_id: cuenta_id,
                                monto_solicitado: monto_solicitado
                            })
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (!data.success) {
                                Swal.fire('Error', data.message || 'No se pudo enviar el código de verificación.', 'error').then(() => {
                                    if (modalInstance) modalInstance.show();
                                    btnSubmit.disabled = false;
                                    btnSubmit.innerHTML = originalHtml;
                                });
                                return;
                            }
                            
                            // Abrir el modal OTP interactivo
                            abrirModalOtpRetiro(cuenta_id, monto_solicitado, formRetiro, btnSubmit, originalHtml, modalInstance);
                        })
                        .catch(error => {
                            console.error('Error al solicitar OTP de retiro:', error);
                            Swal.fire('Error', 'Error de red o conexión al solicitar código OTP.', 'error').then(() => {
                                if (modalInstance) modalInstance.show();
                                btnSubmit.disabled = false;
                                btnSubmit.innerHTML = originalHtml;
                            });
                        });
                    });
                }

                function abrirModalOtpRetiro(cuentaId, montoSolicitado, formRetiro, btnSubmit, originalHtml, modalInstance) {
                    let timerInterval;
                    let tiempoRestante = 30; // 30 segundos

                    Swal.fire({
                        title: 'Verificación de Seguridad',
                        html: `
                            <div class="text-center p-2">
                                <p class="text-dark fw-bold mb-2">Te hemos enviado un código de verificación por correo electrónico.</p>
                                <p class="text-muted small mb-3">El código es válido por <strong>5 minutos</strong>. Revisa tu bandeja de entrada o correo no deseado (spam).</p>
                                <div class="d-flex justify-content-center gap-2 my-4" id="otp-input-container">
                                    <input type="text" maxlength="1" class="form-control text-center fs-3 fw-bold otp-digit" style="width: 44px; height: 52px; padding: 0; border-radius: 8px; border: 2px solid #cbd5e1; font-family: monospace;" inputmode="numeric" pattern="[0-9]*">
                                    <input type="text" maxlength="1" class="form-control text-center fs-3 fw-bold otp-digit" style="width: 44px; height: 52px; padding: 0; border-radius: 8px; border: 2px solid #cbd5e1; font-family: monospace;" inputmode="numeric" pattern="[0-9]*">
                                    <input type="text" maxlength="1" class="form-control text-center fs-3 fw-bold otp-digit" style="width: 44px; height: 52px; padding: 0; border-radius: 8px; border: 2px solid #cbd5e1; font-family: monospace;" inputmode="numeric" pattern="[0-9]*">
                                    <input type="text" maxlength="1" class="form-control text-center fs-3 fw-bold otp-digit" style="width: 44px; height: 52px; padding: 0; border-radius: 8px; border: 2px solid #cbd5e1; font-family: monospace;" inputmode="numeric" pattern="[0-9]*">
                                    <input type="text" maxlength="1" class="form-control text-center fs-3 fw-bold otp-digit" style="width: 44px; height: 52px; padding: 0; border-radius: 8px; border: 2px solid #cbd5e1; font-family: monospace;" inputmode="numeric" pattern="[0-9]*">
                                    <input type="text" maxlength="1" class="form-control text-center fs-3 fw-bold otp-digit" style="width: 44px; height: 52px; padding: 0; border-radius: 8px; border: 2px solid #cbd5e1; font-family: monospace;" inputmode="numeric" pattern="[0-9]*">
                                </div>
                                <div class="mt-3" style="min-height: 30px;">
                                    <span class="text-muted small" id="otp-timer-text">Si no te llega el correo, podrás solicitar otro en <strong id="otp-timer-count">30</strong>s.</span>
                                    <button type="button" class="btn btn-link btn-sm d-none fw-bold text-decoration-none text-primary" id="btn-reenviar-otp" style="font-size: 0.85rem;">Reenviar Código</button>
                                </div>
                            </div>
                        `,
                        showCancelButton: true,
                        confirmButtonText: 'Confirmar Retiro',
                        cancelButtonText: 'Cancelar',
                        focusConfirm: false,
                        preConfirm: () => {
                            const inputs = document.querySelectorAll('.otp-digit');
                            let otp = '';
                            inputs.forEach(input => otp += input.value);
                            
                            if (otp.length !== 6) {
                                Swal.showValidationMessage('Por favor, ingresa los 6 dígitos.');
                                return false;
                            }
                            return otp;
                        },
                        didOpen: () => {
                            const container = document.getElementById('otp-input-container');
                            const inputs = container.querySelectorAll('.otp-digit');
                            const timerCount = document.getElementById('otp-timer-count');
                            const timerText = document.getElementById('otp-timer-text');
                            const btnReenviar = document.getElementById('btn-reenviar-otp');

                            inputs[0].focus();

                            inputs.forEach((input, index) => {
                                input.addEventListener('input', (e) => {
                                    const val = e.target.value;
                                    if (val.length === 1 && index < inputs.length - 1) {
                                        inputs[index + 1].focus();
                                    }
                                    const filledAll = Array.from(inputs).every(inp => inp.value !== '');
                                    if (filledAll) {
                                        Swal.clickConfirm();
                                    }
                                });

                                input.addEventListener('keydown', (e) => {
                                    if (e.key === 'Backspace') {
                                        if (input.value === '' && index > 0) {
                                            inputs[index - 1].focus();
                                            inputs[index - 1].value = '';
                                        }
                                    }
                                });

                                input.addEventListener('paste', (e) => {
                                    e.preventDefault();
                                    const pasteData = (e.clipboardData || window.clipboardData).getData('text');
                                    const numbers = pasteData.replace(/\D/g, '').substring(0, 6);
                                    
                                    for (let i = 0; i < numbers.length && i < inputs.length; i++) {
                                        inputs[i].value = numbers[i];
                                    }
                                    
                                    const nextFocus = Math.min(numbers.length, inputs.length - 1);
                                    inputs[nextFocus].focus();

                                    if (numbers.length === 6) {
                                        Swal.clickConfirm();
                                    }
                                });
                            });

                            // Temporizador
                            timerInterval = setInterval(() => {
                                tiempoRestante--;
                                if (tiempoRestante <= 0) {
                                    clearInterval(timerInterval);
                                    timerText.classList.add('d-none');
                                    btnReenviar.classList.remove('d-none');
                                } else {
                                    timerCount.textContent = tiempoRestante;
                                }
                            }, 1000);

                            // Reenviar
                            btnReenviar.addEventListener('click', () => {
                                btnReenviar.classList.add('d-none');
                                timerText.classList.remove('d-none');
                                tiempoRestante = 30;
                                timerCount.textContent = tiempoRestante;

                                timerInterval = setInterval(() => {
                                    tiempoRestante--;
                                    if (tiempoRestante <= 0) {
                                        clearInterval(timerInterval);
                                        timerText.classList.add('d-none');
                                        btnReenviar.classList.remove('d-none');
                                    } else {
                                        timerCount.textContent = tiempoRestante;
                                    }
                                }, 1000);

                                fetch('/portal-cliente/ahorros/otp/solicitar', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify({
                                        cuenta_id: cuentaId,
                                        monto_solicitado: montoSolicitado,
                                        force: true
                                    })
                                })
                                .then(response => response.json())
                                .then(data => {
                                    if (data.success) {
                                        const Toast = Swal.mixin({
                                            toast: true,
                                            position: 'top-end',
                                            showConfirmButton: false,
                                            timer: 3000,
                                            timerProgressBar: true
                                        });
                                        Toast.fire({
                                            icon: 'success',
                                            title: 'Se ha reenviado un nuevo código a tu correo.'
                                        });
                                    } else {
                                        Swal.showValidationMessage(data.message || 'Error al reenviar código.');
                                    }
                                })
                                .catch(err => {
                                    console.error('Error al reenviar OTP:', err);
                                    Swal.showValidationMessage('Error de red al reenviar el código.');
                                });
                            });
                        },
                        willClose: () => {
                            clearInterval(timerInterval);
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const otp = result.value;
                            
                            // Crear input hidden y enviarlo
                            const otpInput = document.createElement('input');
                            otpInput.type = 'hidden';
                            otpInput.name = 'otp';
                            otpInput.value = otp;
                            formRetiro.appendChild(otpInput);
                            
                            Swal.fire({
                                title: 'Enviando solicitud...',
                                allowOutsideClick: false,
                                didOpen: () => {
                                    Swal.showLoading();
                                }
                            });
                            
                            formRetiro.submit();
                        } else {
                            if (modalInstance) modalInstance.show();
                            btnSubmit.disabled = false;
                            btnSubmit.innerHTML = originalHtml;
                        }
                    });
                }

        });
    </script>

    <script>
        async function recalcularScore() {
            const icon = document.getElementById('iconRecalcularScore');
            const btn = document.getElementById('btnRecalcularScore');
            const circle = document.getElementById('scoreProgressRing');
            const scoreElement = document.getElementById('scoreText');
            const valContainer = document.getElementById('scoreValueContainer');
            const loaderContainer = document.getElementById('scoreLoaderContainer');
            
            if (btn.disabled) return;
            
            // Deshabilitar botón
            btn.disabled = true;
            
            // Animación del botón de recarga (giro infinito)
            icon.style.animation = 'spin 1s linear infinite';
            
            // Guardar valores originales
            const originalOffset = circle.style.strokeDashoffset;
            const originalColor = circle.getAttribute('stroke');
            
            // Inyectar estilo de spin para el icono si no existe
            if (!document.getElementById('spinStyle')) {
                const style = document.createElement('style');
                style.id = 'spinStyle';
                style.innerHTML = `
                    @keyframes spin {
                        0% { transform: rotate(0deg); }
                        100% { transform: rotate(360deg); }
                    }
                `;
                document.head.appendChild(style);
            }
            
            // 1. Ocultar el valor actual con transición de escala y opacidad
            valContainer.style.opacity = '0';
            valContainer.style.transform = 'translate(-50%, -50%) scale(0.7)';
            
            // 2. Vaciar el círculo de progreso de forma fluida
            circle.style.transition = 'stroke-dashoffset 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
            circle.style.strokeDashoffset = '427';
            
            // 3. Mostrar el loader central premium
            setTimeout(() => {
                if (btn.disabled) {
                    loaderContainer.style.opacity = '1';
                    loaderContainer.style.transform = 'translate(-50%, -50%) scale(1)';
                }
            }, 150);

            try {
                const response = await fetch('/portal-cliente/recalcular-score', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const data = await response.json();

                // Esperar un mínimo de 1.2 segundos para que la animación de carga sea apreciable y fluida
                await new Promise(resolve => setTimeout(resolve, 1200));

                if (data.success) {
                    const sd = data.scoreData;
                    
                    // 1. Ocultar el loader central
                    loaderContainer.style.opacity = '0';
                    loaderContainer.style.transform = 'translate(-50%, -50%) scale(0.7)';
                    
                    // Esperar a que se oculte el loader antes de mostrar el nuevo valor
                    await new Promise(resolve => setTimeout(resolve, 200));
                    
                    // 2. Preparar y mostrar el valor definitivo desde escala reducida
                    scoreElement.textContent = '0';
                    valContainer.style.transform = 'translate(-50%, -50%) scale(0.7)';
                    valContainer.getBoundingClientRect(); // Reflow
                    valContainer.style.opacity = '1';
                    valContainer.style.transform = 'translate(-50%, -50%) scale(1)';
                    
                    // 3. Rellenar el círculo al nuevo valor con un efecto elástico premium
                    circle.style.transition = 'stroke-dashoffset 1.8s cubic-bezier(0.34, 1.56, 0.64, 1), stroke 1s ease';
                    circle.setAttribute('stroke', sd.circularColor);
                    const newOffset = 427 - (427 * sd.score / 1000);
                    circle.style.strokeDashoffset = newOffset;

                    // 4. Animación interactiva del texto: De 0 al valor definitivo
                    const startScore = 0;
                    const endScore = sd.score;
                    const duration = 1500;
                    const startTime = performance.now();

                    function animateScore(now) {
                        const elapsed = now - startTime;
                        const progress = Math.min(elapsed / duration, 1);
                        const easeProgress = 1 - Math.pow(1 - progress, 3); // Cubic Out
                        const currentScore = Math.floor(startScore + easeProgress * (endScore - startScore));
                        scoreElement.textContent = currentScore;
                        if (progress < 1) {
                            requestAnimationFrame(animateScore);
                        } else {
                            scoreElement.textContent = endScore;
                        }
                    }
                    requestAnimationFrame(animateScore);

                    // Actualizar badge del nivel y categoría
                    const badge = document.getElementById('scoreNivel');
                    badge.className = `badge ${sd.badgeBg} text-white px-3 py-1.5 rounded-pill shadow-sm`;
                    badge.textContent = `Score: ${sd.nivel} (${sd.categoria})`;

                    // Actualizar desglose de puntos
                    document.getElementById('desglosePagos').textContent = `+${sd.desglose.pagadosATiempo} pts`;
                    document.getElementById('desgloseAhorros').textContent = `+${sd.desglose.ahorros} pts`;
                    document.getElementById('desgloseAntiguedad').textContent = `+${sd.desglose.antiguedad} pts`;
                    
                    const dVencidos = document.getElementById('desgloseVencidos');
                    dVencidos.textContent = `${sd.desglose.prestamosVencidos} pts`;
                    dVencidos.className = `fw-bold ${sd.desglose.prestamosVencidos < 0 ? 'text-danger' : 'text-muted'}`;

                    const dCuotas = document.getElementById('desgloseCuotas');
                    dCuotas.textContent = `${sd.desglose.cuotasVencidas} pts`;
                    dCuotas.className = `fw-bold ${sd.desglose.cuotasVencidas < 0 ? 'text-danger' : 'text-muted'}`;

                    // Actualizar consejos
                    const consejosList = document.getElementById('scoreConsejosList');
                    consejosList.innerHTML = '';
                    sd.consejos.forEach(consejo => {
                        const li = document.createElement('li');
                        li.className = 'mb-1 d-flex align-items-start';
                        li.innerHTML = `<i class="bi bi-chevron-right text-success small me-2 mt-1" style="font-size: 0.75rem;"></i><span>${consejo}</span>`;
                        consejosList.appendChild(li);
                    });

                    // Toast SweetAlert2 de éxito
                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true
                    });
                    Toast.fire({
                        icon: 'success',
                        title: '¡Score Crediticio recalculado!'
                    });

                } else {
                    // Restaurar valores anteriores si falla
                    loaderContainer.style.opacity = '0';
                    loaderContainer.style.transform = 'translate(-50%, -50%) scale(0.7)';
                    valContainer.style.opacity = '1';
                    valContainer.style.transform = 'translate(-50%, -50%) scale(1)';
                    
                    circle.style.transition = 'stroke-dashoffset 0.8s ease';
                    circle.style.strokeDashoffset = originalOffset;
                    circle.setAttribute('stroke', originalColor);
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.mensaje || 'No se pudo recalcular el score.'
                    });
                }
            } catch (err) {
                console.error('Error al recalcular score:', err);
                // Restaurar
                loaderContainer.style.opacity = '0';
                loaderContainer.style.transform = 'translate(-50%, -50%) scale(0.7)';
                valContainer.style.opacity = '1';
                valContainer.style.transform = 'translate(-50%, -50%) scale(1)';
                
                circle.style.transition = 'stroke-dashoffset 0.8s ease';
                circle.style.strokeDashoffset = originalOffset;
                circle.setAttribute('stroke', originalColor);
                
                Swal.fire({
                    icon: 'error',
                    title: 'Error de Red',
                    text: 'Hubo un error de comunicación con el servidor.'
                });
            } finally {
                // Restaurar estado del botón
                btn.disabled = false;
                icon.style.animation = '';
            }
        }

        function mostrarAyudaScore() {
            Swal.fire({
                title: 'Clasificación del Score Crediticio',
                html: `
                    <!-- Vista Desktop: Tabla -->
                    <div class="table-responsive text-start small mt-2 d-none d-md-block">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Categoría</th>
                                    <th>Rango Puntos</th>
                                    <th>Nivel de Riesgo</th>
                                    <th>Tasa (Int. / Mora)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color: rgba(16, 185, 129, 0.08);">
                                    <td><span class="badge bg-success px-2 py-1">Categoría A</span></td>
                                    <td class="fw-bold text-success">900 - 1000 pts</td>
                                    <td class="fw-bold text-success">Excelente</td>
                                    <td class="fw-bold text-success">1.5% / 2.5%</td>
                                </tr>
                                <tr style="background-color: rgba(59, 130, 246, 0.08);">
                                    <td><span class="badge bg-info px-2 py-1">Categoría B</span></td>
                                    <td class="fw-bold text-primary">700 - 899 pts</td>
                                    <td class="fw-bold text-primary">Bueno</td>
                                    <td class="fw-bold text-primary">2.0% / 3.0%</td>
                                </tr>
