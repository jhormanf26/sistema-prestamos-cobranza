<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <%- include('partials/sidebar') %>

            <div class="col py-0 py-md-3 main-content-wrapper" style="background-color: #f8fafc; min-height: 100vh;">
                <!-- Aquí incluimos el sidebar móvil (offcanvas) pero no queremos duplicar el HTML
                     Lo ideal es que el menú sea resposive naturalmente, por lo que usaremos un div overlay -->

                <!-- Modal MercadoPago Checkout -->
                <div class="modal fade" id="modalMercadoPago" tabindex="-1" aria-labelledby="modalMercadoPagoLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                            <div class="modal-header bg-primary border-0 py-3">
                                <h5 class="modal-title fw-bold text-white d-flex align-items-center" id="modalMercadoPagoLabel">
                                    <i class="bi bi-credit-card me-2"></i> Pagar en Línea (PSE/Tarjetas)
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body p-4 bg-light">
                                <form id="formMercadoPago">
                                    <input type="hidden" id="mpPrestamoId" name="prestamo_id">
                                    
                                    <div class="alert alert-info border-0 shadow-sm d-flex mb-4">
                                        <i class="bi bi-info-circle-fill me-3 fs-4 text-info"></i>
                                        <div class="small text-dark">
                                            Al pagar en línea a través de MercadoPago, tu pago se registrará automáticamente sin necesidad de revisión manual. Podrás usar PSE, Tarjeta de Crédito, Débito o dinero en cuenta.
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold text-dark small">¿Cuánto deseas abonar a tu préstamo? <span class="text-danger">*</span></label>
                                        <div class="input-group input-group-lg shadow-sm">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-currency-dollar"></i></span>
                                            <input type="text" class="form-control border-start-0 fw-bold fs-5 currency-input" id="mpMontoNeto" name="monto_pagar" required>
                                        </div>
                                        <div class="form-text mt-2"><i class="bi bi-pencil me-1"></i> Puedes modificar este valor si deseas abonar más o menos de la cuota programada.</div>
                                    </div>

                                    <div class="card border-0 bg-white shadow-sm rounded-3 p-3 mb-4">
                                        <h6 class="fw-bold border-bottom pb-2 mb-3 fs-6">Resumen del Cobro</h6>
                                        
                                        <div class="d-flex justify-content-between mb-2 small">
                                            <span class="text-muted">Monto a abonar al préstamo:</span>
                                            <span class="fw-bold text-dark" id="txtMpMontoNeto">$0</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2 small">
                                            <span class="text-muted">Comisión pasarela (MercadoPago):</span>
                                            <span class="fw-bold text-danger" id="txtMpComision">$0</span>
                                        </div>
                                        <hr class="my-2 border-light">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold text-dark">Total a pagar:</span>
                                            <span class="fw-bold text-primary fs-4" id="txtMpTotal">$0</span>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm d-flex justify-content-center align-items-center" id="btnProcesarMp">
                                        <span class="me-2">Continuar a MercadoPago</span> <i class="bi bi-arrow-right-circle fs-5"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mobile Header Simple -->
                <div class="d-md-none bg-white p-3 shadow d-flex justify-content-between align-items-center mb-3 sticky-top" style="top: 0; z-index: 1020;">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-badge text-success fs-3 me-2"></i>
                        <h5 class="mb-0 fw-bold">Mi Portal</h5>
                    </div>
                    <button class="btn btn-outline-secondary position-relative" id="openSidebarBtn">
                        <i class="bi bi-list fs-4"></i>
                        <% if (typeof clienteChatSinLeer !== 'undefined' && clienteChatSinLeer > 0) { %>
                            <span class="position-absolute top-0 start-100 translate-middle p-1.5 bg-danger border border-white rounded-circle animate-pulse" style="width: 10px; height: 10px;">
                                <span class="visually-hidden">Mensajes no leídos</span>
                            </span>
                        <% } %>
                    </button>
                </div>

                <div class="container-fluid px-4 py-3">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold text-dark my-0 fs-4">Hola, <%= cliente.nombre %> 👋</h2>
                            <p class="text-muted small mb-0">Resumen de tus préstamos</p>
                        </div>
                        <div class="d-none d-sm-block">
                            <span class="badge bg-white text-dark border p-2 fw-normal shadow-sm">
                                <i class="bi bi-calendar3 text-success me-1"></i> <%= new Date().toLocaleDateString() %>
                            </span>
                        </div>
                    </div>

                    <!-- Notificaciones Push -->
                    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-info bg-opacity-10">
                        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2">
                            <div>
                                <h6 class="mb-1 text-info fw-bold"><i class="bi bi-bell-fill"></i> Alertas y Recordatorios</h6>
                                <small class="text-muted">Activa las notificaciones en este dispositivo para recibir alertas automáticas cuando tengas una cuota próxima a vencer.</small>
                            </div>
                            <button id="btnHabilitarPushCliente" class="btn btn-sm btn-info text-white rounded-pill px-3 shadow-sm text-nowrap">
                                <i class="bi bi-phone-vibrate"></i> Activar
                            </button>
                        </div>
                    </div>

                    <!-- Alerta de Contrato Pendiente de Firma -->
                    <% 
                        const prestamosSinFirmar = prestamosActivos.filter(p => !p.firma_digital);
                        if (prestamosSinFirmar.length > 0) { 
                    %>
                        <div class="card border-0 shadow-sm rounded-4 mb-4 text-dark position-relative overflow-hidden" style="background: rgba(13, 110, 253, 0.05); border: 1px solid rgba(13, 110, 253, 0.15) !important;">
                            <div class="position-absolute top-50 end-0 translate-middle-y opacity-10" style="font-size: 7rem; right: 2%; pointer-events: none;">
                                <i class="bi bi-pen-fill text-primary"></i>
                            </div>
                            <div class="card-body p-4 position-relative">
                                <div class="row align-items-center">
                                    <div class="col-md-8 col-lg-9">
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 mb-2 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.75rem;">
                                            <i class="bi bi-exclamation-circle-fill me-1 animate-pulse"></i> Acción Requerida
                                        </span>
                                        <h4 class="fw-bold mb-1 text-dark">Tienes <%= prestamosSinFirmar.length === 1 ? 'un contrato' : prestamosSinFirmar.length + ' contratos' %> pendiente de firma</h4>
                                        <p class="mb-0 text-muted small">
                                            Por favor, revisa y firma digitalmente <%= prestamosSinFirmar.length === 1 ? 'el pagaré de tu préstamo activo' : 'los pagarés de tus préstamos activos' %> para completar el proceso.
                                        </p>
                                    </div>
                                    <div class="col-md-4 col-lg-3 text-md-end mt-3 mt-md-0">
                                        <a href="/portal-cliente/contrato/<%= prestamosSinFirmar[0].id %>" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center" style="transition: all 0.3s ease;">
                                            <i class="bi bi-pen me-2"></i> Firmar Ahora
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Alerta de Mensajes de Soporte sin Leer -->
                    <% if (typeof clienteChatSinLeer !== 'undefined' && clienteChatSinLeer > 0) { %>
                        <div class="card border-0 shadow-sm rounded-4 mb-4 text-dark position-relative overflow-hidden" style="background: rgba(220, 53, 69, 0.05); border: 1px solid rgba(220, 53, 69, 0.15) !important;">
                            <div class="position-absolute top-50 end-0 translate-middle-y opacity-10" style="font-size: 7rem; right: 2%; pointer-events: none;">
                                <i class="bi bi-chat-heart-fill text-danger"></i>
                            </div>
                            <div class="card-body p-4 position-relative">
                                <div class="row align-items-center">
                                    <div class="col-md-8 col-lg-9">
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 mb-2 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.75rem;">
                                            <i class="bi bi-envelope-fill me-1 animate-pulse"></i> Tienes <%= clienteChatSinLeer %> <%= clienteChatSinLeer === 1 ? 'mensaje nuevo' : 'mensajes nuevos' %>
                                        </span>
                                        <h4 class="fw-bold mb-1 text-dark">¡El Administrador te ha respondido!</h4>
                                        <p class="mb-0 text-muted small">
                                            Tienes respuestas pendientes del equipo de soporte en nuestro chat interno. Revisa el chat para conocer el estado de tus consultas o reportes de pago.
                                        </p>
                                    </div>
                                    <div class="col-md-4 col-lg-3 text-md-end mt-3 mt-md-0">
                                        <a href="/portal-cliente/chat" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center" style="transition: all 0.3s ease;">
                                            <i class="bi bi-headset me-2"></i> Ir a Soporte
                                        </a>
                                    </div>
                                </div>
                            </div>
                    <% } %>

                    <!-- Tarjeta de Trayectoria y Celebración de Antigüedad (Gamificación Premium) -->
                    <% if (typeof antiguedadInfo !== 'undefined' && antiguedadInfo) { %>
                        <div class="card border-0 shadow-sm rounded-4 mb-4 text-dark position-relative overflow-hidden" style="background: rgba(255, 255, 255, 0.55); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.4) !important;">
                            <!-- Decoración de fondo de regalo/celebración -->
                            <div class="position-absolute top-50 end-0 translate-middle-y opacity-10" style="font-size: 7rem; right: 3%; pointer-events: none;">
                                <i class="bi bi-gift-fill text-success"></i>
                            </div>
                            <div class="card-body p-4 position-relative">
                                <div class="row align-items-center">
                                    <div class="col-md-8 col-lg-9">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <% if (antiguedadInfo.tieneMasDeSeisMeses) { %>
                                                <span class="badge bg-warning text-dark border border-warning border-opacity-25 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.75rem;">
                                                    <i class="bi bi-crown-fill me-1 animate-pulse"></i> Cliente Elite Gold
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.75rem;">
                                                    <i class="bi bi-heart-fill me-1 text-danger animate-pulse"></i> Miembro de la Familia
                                                </span>
                                            <% } %>
                                            
                                            <% if (antiguedadInfo.esAniversarioMes) { %>
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1 fw-bold text-uppercase animate-bounce" style="font-size: 0.75rem;">
                                                    🎉 ¡Aniversario!
                                                </span>
                                            <% } %>
                                        </div>

                                        <% if (antiguedadInfo.esAniversarioMes) { %>
                                            <h4 class="fw-bold mb-1 text-dark">🎉 ¡Feliz Aniversario de <%= antiguedadInfo.totalMeses %> <%= antiguedadInfo.totalMeses === 1 ? 'Mes' : 'Meses' %>! 🥳</h4>
                                            <p class="mb-0 text-muted small">
                                                Hoy cumples exactamente <strong><%= antiguedadInfo.totalMeses %> <%= antiguedadInfo.totalMeses === 1 ? 'mes' : 'meses' %></strong> desde tu registro el <strong><%= antiguedadInfo.fechaRegistroFormateada %></strong>. ¡Queremos celebrar este día especial contigo! Gracias por tu intachable confianza en nuestra plataforma.
                                            </p>
                                        <% } else { %>
                                            <h4 class="fw-bold mb-1 text-dark">Tu Trayectoria con Nosotros 📅</h4>
                                            <p class="mb-0 text-muted small">
                                                Te registraste el <strong><%= antiguedadInfo.fechaRegistroFormateada %></strong>. 
                                                ¡Llevas con nosotros <strong><%= antiguedadInfo.totalMeses %> <%= antiguedadInfo.totalMeses === 1 ? 'mes' : 'meses' %></strong> y <strong><%= antiguedadInfo.dias %> <%= antiguedadInfo.dias === 1 ? 'día' : 'días' %></strong> (<strong><%= antiguedadInfo.totalDias %> días</strong> en total) llenando de valor esta plataforma!
                                            </p>
                                        <% } %>
                                        
                                        <!-- Sección del beneficio de Score por antigüedad -->
                                        <div class="mt-2 small text-dark opacity-90 d-flex align-items-center gap-2">
                                            <% if (antiguedadInfo.tieneMasDeSeisMeses) { %>
                                                <i class="bi bi-patch-check-fill text-success fs-6"></i>
                                                <span>¡Beneficio Activo! Superaste los 6 meses de antigüedad. Tienes <strong>+50 puntos adicionales</strong> en tu Score Crediticio. 👑</span>
                                            <% } else { %>
                                                <i class="bi bi-info-circle text-muted fs-6"></i>
                                                <span>A los 6 meses de registro obtendrás un beneficio de <strong>+50 puntos automáticos</strong> de antigüedad en tu Score Crediticio. ¡Faltan <%= 6 - antiguedadInfo.totalMeses %> meses! 🚀</span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-lg-3 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end justify-content-center gap-2">
                                        <div class="p-3 text-center rounded-3 bg-white shadow-sm border border-light" style="min-width: 90px;">
                                            <span class="fs-3 fw-bold text-success d-block lh-1"><%= antiguedadInfo.totalMeses %></span>
                                            <span class="text-muted small" style="font-size: 0.7rem;"><%= antiguedadInfo.totalMeses === 1 ? 'Mes' : 'Meses' %></span>
                                        </div>
                                        <div class="p-3 text-center rounded-3 bg-white shadow-sm border border-light" style="min-width: 90px;">
                                            <span class="fs-3 fw-bold text-success d-block lh-1"><%= antiguedadInfo.dias %></span>
                                            <span class="text-muted small" style="font-size: 0.7rem;"><%= antiguedadInfo.dias === 1 ? 'Día' : 'Días' %></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Banner de Fidelización - Cupo Pre-aprobado u Ordinario -->
                    <% if (cliente.monto_preaprobado && parseFloat(cliente.monto_preaprobado) > 0) { %>
                        <div class="card border-0 shadow-lg rounded-4 mb-4 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #6366f1 0%, #10b981 100%);">
                            <div class="position-absolute top-0 end-0 opacity-10" style="font-size: 8rem; transform: translate(20%, -20%); pointer-events: none;">
                                <i class="bi bi-award-fill"></i>
                            </div>
                            <div class="card-body p-4 position-relative">
                                <div class="row align-items-center">
                                    <div class="col-md-8 col-lg-9">
                                        <span class="badge bg-white bg-opacity-25 text-white mb-2 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.75rem;">
                                            <i class="bi bi-gem me-1 animate-pulse"></i> Oportunidad Exclusiva
                                        </span>
                                        <h4 class="fw-bold mb-1"><i class="bi bi-rocket-takeoff-fill"></i> ¡Tienes un cupo pre-aprobado disponible!</h4>
                                        <p class="mb-0 text-white-50 small">
                                            Por tu excelente historial de pago, tienes acceso inmediato a un desembolso de hasta 
                                            <strong class="text-white">$<%= parseFloat(cliente.monto_preaprobado).toLocaleString('es-CO') %></strong>. 
                                            Solicítalo en segundos y recíbelo directamente en tu cuenta registrada.
                                        </p>
                                    </div>
                                    <div class="col-md-4 col-lg-3 text-md-end mt-3 mt-md-0">
                                        <button class="btn btn-light text-success fw-bold rounded-pill px-4 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalSolicitarCupo" style="transition: all 0.3s ease;">
                                            <i class="bi bi-cash-coin me-1"></i> Retirar Cupo
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="card border-0 shadow-lg rounded-4 mb-4 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                            <div class="position-absolute top-0 end-0 opacity-10" style="font-size: 8rem; transform: translate(20%, -20%); pointer-events: none;">
                                <i class="bi bi-wallet2"></i>
                            </div>
                            <div class="card-body p-4 position-relative">
                                <div class="row align-items-center">
                                    <div class="col-md-8 col-lg-9">
                                        <span class="badge bg-white bg-opacity-25 text-white mb-2 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.75rem;">
                                            <i class="bi bi-rocket-takeoff me-1"></i> Créditos del Portal
                                        </span>
                                        <h4 class="text-white fw-bold mb-1"><i class="bi bi-cash-coin me-2"></i> ¿Necesitas financiamiento rápido?</h4>
                                        <p class="mb-0 text-white-50 small">
                                            Simula y envía tu solicitud de crédito ordinario de hasta 
                                            <strong class="text-white">$ 3.000.000</strong> desde la plataforma. 
                                            Nuestro departamento de riesgos evaluará tu caso de inmediato.
                                        </p>
                                    </div>
                                    <div class="col-md-4 col-lg-3 text-md-end mt-3 mt-md-0">
                                        <button class="btn btn-light text-primary fw-bold rounded-pill px-4 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalSolicitarCupo" style="transition: all 0.3s ease;">
                                            <i class="bi bi-sliders me-1"></i> Solicitar Crédito
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Scoring Crediticio Interno (Glassmorphism Premium) -->
                    <% if (typeof scoreData !== 'undefined' && scoreData) { %>
                        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden position-relative" style="background: rgba(255, 255, 255, 0.45); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.4) !important;">
                            <div class="card-body p-4">
                                <div class="row align-items-center">
                                    <!-- Sección Gráfica Círculo SVG -->
                                    <div class="col-md-4 col-lg-3 text-center d-flex flex-column align-items-center justify-content-center mb-3 mb-md-0 position-relative">
                                        <div class="score-ring-container position-relative" style="width: 160px; height: 160px;">
                                            <svg width="160" height="160" class="score-ring-svg">
                                                <!-- Círculo de fondo gris -->
                                                <circle stroke="#e2e8f0" stroke-width="10" fill="transparent" r="68" cx="80" cy="80" />
                                                <!-- Círculo de progreso de color dinámico -->
                                                <circle id="scoreProgressRing" stroke="<%= scoreData.circularColor %>" stroke-width="12" stroke-linecap="round" fill="transparent" r="68" cx="80" cy="80" style="stroke-dasharray: 427; stroke-dashoffset: <%= 427 - (427 * scoreData.score / 1000) %>; transform: rotate(-90deg); transform-origin: 50% 50%; transition: stroke-dashoffset 1.5s cubic-bezier(0.4, 0, 0.2, 1), stroke 1.5s ease;" />
                                            </svg>
                                            <!-- Contenedor del valor del score actual -->
                                            <div class="position-absolute top-50 start-50 translate-middle text-center" id="scoreValueContainer" style="transition: all 0.3s ease; z-index: 1;">
                                                <h2 class="fw-bold mb-0 text-dark fs-3" id="scoreText"><%= scoreData.score %></h2>
                                                <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Puntos</span>
                                            </div>
                                            <!-- Contenedor del spinner de carga premium -->
                                            <div class="position-absolute top-50 start-50 translate-middle text-center d-flex flex-column align-items-center justify-content-center" id="scoreLoaderContainer" style="opacity: 0; pointer-events: none; transition: all 0.3s ease; z-index: 2; transform: translate(-50%, -50%) scale(0.7);">
                                                <div class="spinner-border text-success" role="status" style="width: 2.2rem; height: 2.2rem; border-width: 0.2em;">
                                                    <span class="visually-hidden">Calculando...</span>
                                                </div>
                                                <span class="text-success fw-bold mt-1" style="font-size: 0.6rem; letter-spacing: 0.5px; text-uppercase;">Calculando</span>
                                            </div>
                                        </div>
                                        <div class="mt-3 d-flex align-items-center justify-content-center gap-2">
                                            <span class="badge <%= scoreData.badgeBg %> text-white px-3 py-1.5 rounded-pill shadow-sm" id="scoreNivel">
                                                Score: <%= scoreData.nivel %> (<%= scoreData.categoria %>)
                                            </span>
                                            <button onclick="mostrarAyudaScore()" class="btn btn-sm btn-link text-muted p-0 d-inline-flex align-items-center justify-content-center" title="Ver clasificación de scores" style="text-decoration: none; font-size: 1.15rem; transition: color 0.2s ease;">
                                                <i class="bi bi-info-circle-fill text-success opacity-75"></i>
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <!-- Sección de Textos y Consejos -->
                                    <div class="col-md-8 col-lg-9 ps-md-4">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-bold text-uppercase" style="font-size: 0.75rem;">
                                                    <i class="bi bi-shield-check-fill me-1"></i> Mi Score Crediticio
                                                </span>
                                                <h4 class="fw-bold text-dark mt-2 mb-1">Tu Salud Financiera Interna</h4>
                                                <p class="text-muted small mb-0">Evaluamos tu historial de pagos, ahorros y estabilidad en la plataforma.</p>
                                            </div>
                                            <button class="btn btn-light rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center" id="btnRecalcularScore" onclick="recalcularScore()" style="width: 40px; height: 40px; transition: all 0.3s ease;">
                                                <i class="bi bi-arrow-clockwise text-success fs-5" id="iconRecalcularScore"></i>
                                            </button>
                                        </div>
                                        
                                        <!-- Consejos -->
                                        <div class="consejos-container mt-3">
                                            <h6 class="fw-bold text-dark small mb-2"><i class="bi bi-lightbulb-fill text-warning me-1"></i> Consejos para mejorar tu score:</h6>
                                            <ul class="list-unstyled small text-muted mb-0" id="scoreConsejosList">
                                                <% scoreData.consejos.forEach((consejo, idx) => { %>
                                                    <li class="mb-1 d-flex align-items-start">
                                                        <i class="bi bi-chevron-right text-success small me-2 mt-1" style="font-size: 0.75rem;"></i>
                                                        <span><%= consejo %></span>
                                                    </li>
                                                <% }) %>
                                            </ul>
                                        </div>
                                        
                                        <!-- Desglose de puntos -->
                                        <div class="mt-3">
                                            <a class="text-success small fw-bold text-decoration-none d-inline-flex align-items-center cursor-pointer" data-bs-toggle="collapse" href="#collapseDesgloseScore" role="button" aria-expanded="false" aria-controls="collapseDesgloseScore">
                                                <span>Ver desglose de mi puntaje</span> <i class="bi bi-chevron-down ms-1"></i>
                                            </a>
                                            
                                            <div class="collapse mt-2" id="collapseDesgloseScore">
                                                <div class="card border-0 bg-white bg-opacity-60 rounded-3 p-3 shadow-sm">
                                                    <div class="row g-2 small text-dark">
                                                        <div class="col-6 d-flex justify-content-between border-bottom pb-1 mb-1">
                                                            <span class="text-muted">Puntaje Base:</span>
                                                            <span class="fw-bold">500 pts</span>
                                                        </div>
                                                        <div class="col-6 d-flex justify-content-between border-bottom pb-1 mb-1 ps-md-3">
                                                            <span class="text-muted">Pagos a Tiempo:</span>
                                                            <span class="fw-bold text-success" id="desglosePagos">+<%= scoreData.desglose.pagadosATiempo %> pts</span>
                                                        </div>
                                                        <div class="col-6 d-flex justify-content-between border-bottom pb-1 mb-1">
                                                            <span class="text-muted">Ahorros Activos:</span>
                                                            <span class="fw-bold text-success" id="desgloseAhorros">+<%= scoreData.desglose.ahorros %> pts</span>
                                                        </div>
                                                        <div class="col-6 d-flex justify-content-between border-bottom pb-1 mb-1 ps-md-3">
                                                            <span class="text-muted">Antigüedad Cuenta:</span>
                                                            <span class="fw-bold text-success" id="desgloseAntiguedad">+<%= scoreData.desglose.antiguedad %> pts</span>
                                                        </div>
                                                        <div class="col-6 d-flex justify-content-between border-bottom pb-1 mb-1">
                                                            <span class="text-muted">Préstamos Vencidos:</span>
                                                            <span class="fw-bold <%= scoreData.desglose.prestamosVencidos < 0 ? 'text-danger' : 'text-muted' %>" id="desgloseVencidos"><%= scoreData.desglose.prestamosVencidos %> pts</span>
                                                        </div>
                                                        <div class="col-6 d-flex justify-content-between border-bottom pb-1 mb-1 ps-md-3">
                                                            <span class="text-muted">Cuotas Vencidas:</span>
                                                            <span class="fw-bold <%= scoreData.desglose.cuotasVencidas < 0 ? 'text-danger' : 'text-muted' %>" id="desgloseCuotas"><%= scoreData.desglose.cuotasVencidas %> pts</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- ★ Tarjeta de Tasa Preferencial según Score ★ -->
                                        <% if (typeof tasaInfoPortal !== 'undefined' && tasaInfoPortal) {
                                            const tasaIconoPortal = {A:'🏆',B:'🎖️',C:'📊',D:'⚠️',E:'🔴'}[tasaInfoPortal.categoria] || '📊';
                                            const tasaBgPortal = {A:'#d1fae5',B:'#dbeafe',C:'#fef9c3',D:'#fee2e2',E:'#f3f4f6'}[tasaInfoPortal.categoria] || '#f3f4f6';
                                            const tasaColorPortal = {A:'#065f46',B:'#1e40af',C:'#854d0e',D:'#991b1b',E:'#374151'}[tasaInfoPortal.categoria] || '#374151';
                                            const tasaBorderPortal = {A:'#6ee7b7',B:'#93c5fd',C:'#fde047',D:'#fca5a5',E:'#d1d5db'}[tasaInfoPortal.categoria] || '#d1d5db';
                                        %>
                                        <div class="mt-3 rounded-3 p-3 d-flex align-items-center gap-3" style="background-color:<%= tasaBgPortal %>; border: 1px solid <%= tasaBorderPortal %>;">
                                            <span style="font-size: 2rem; line-height:1;"><%= tasaIconoPortal %></span>
                                            <div class="flex-grow-1">
                                                <span class="fw-bold small" style="color:<%= tasaColorPortal %>;">Beneficio de Tasa — Score <%= tasaInfoPortal.categoria %></span>
                                                <p class="mb-0 small" style="color:<%= tasaColorPortal %>; opacity:0.85;">
                                                    Con tu puntaje actual accedes a préstamos desde <strong><%= tasaInfoPortal.tasaMensual %>% mensual</strong>.
                                                    <% if (tasaInfoPortal.categoria === 'A' || tasaInfoPortal.categoria === 'B') { %>
                                                        ¡Sigue así para mantener tu tasa preferencial! 🌟
                                                    <% } else { %>
                                                        Mejora tu score para acceder a tasas más bajas.
                                                    <% } %>
                                                </p>
                                            </div>
                                            <div class="text-end flex-shrink-0">
                                                <span class="fw-bold fs-5 d-block" style="color:<%= tasaColorPortal %>;"><%= tasaInfoPortal.tasaMensual %>%</span>
                                                <small style="color:<%= tasaColorPortal %>; opacity:0.7;">mensual</small>
                                            </div>
                                        </div>
                                        <% } %>
                                        <!-- ★★★ -->

                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Préstamos Activos -->
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-activity text-success me-2"></i> Préstamos Activos</h5>
                    <div class="row g-3 mb-5">
                        <% if(prestamosActivos && prestamosActivos.length > 0) { %>
                            <% prestamosActivos.forEach(p => { %>
                                <div class="col-12 col-xl-6">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <div class="card-body p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                                <div>
                                                    <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1 fw-bold">
                                                        Préstamo #<%= p.id %>
                                                    </span>
                                                    <small class="text-muted d-block mt-2">Iniciado: <%= new Date(p.fecha_inicio).toLocaleDateString() %></small>
                                                </div>
                                                <div class="text-end">
                                                    <% if(p.estado === 'vencido') { %>
                                                        <span class="badge bg-danger">Vencido</span>
                                                    <% } else { %>
                                                        <span class="badge bg-success">Al Día</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                            
                                            <div class="row mt-3 text-center text-sm-start align-items-center">
                                                <div class="col-4">
                                                    <p class="text-muted small mb-1" style="font-size: 0.75rem;">Monto Total</p>
                                                    <h5 class="fw-bold text-dark mb-0" style="font-size: clamp(0.85rem, 2.5vw, 1.15rem); font-weight: 700;">$<%= parseFloat(p.monto_total).toLocaleString('es-CO', {minimumFractionDigits: 0, maximumFractionDigits: 2}) %></h5>
                                                </div>
                                                <div class="col-4 text-center border-start border-end">
                                                    <p class="text-muted small mb-1" style="font-size: 0.75rem;">Saldo por Pagar</p>
                                                    <h5 class="fw-bold text-danger mb-0" style="font-size: clamp(0.85rem, 2.5vw, 1.15rem); font-weight: 700;">$<%= parseFloat(p.monto_total - (p.total_pagado || 0)).toLocaleString('es-CO', {minimumFractionDigits: 0, maximumFractionDigits: 2}) %></h5>
                                                </div>
                                                <div class="col-4 text-end">
                                                    <p class="text-muted small mb-1" style="font-size: 0.75rem;">Pagado</p>
                                                    <h5 class="fw-bold text-success mb-0" style="font-size: clamp(0.85rem, 2.5vw, 1.15rem); font-weight: 700;">$<%= parseFloat(p.total_pagado || 0).toLocaleString('es-CO', {minimumFractionDigits: 0, maximumFractionDigits: 2}) %></h5>
                                                </div>
                                            </div>

                                            <div class="mt-3">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <span class="small text-muted">Progreso</span>
                                                    <span class="small fw-bold text-success"><%= ((p.total_pagado / p.monto_total) * 100).toFixed(0) %>%</span>
                                                </div>
                                                <div class="progress" style="height: 8px;">
                                                    <div class="progress-bar bg-success" style="width: <%= (p.total_pagado / p.monto_total) * 100 %>%"></div>
                                                </div>
                                            </div>

                                            <% 
                                            if (p.fecha_proxima_cuota) { 
                                                const hoy = new Date();
                                                hoy.setHours(0,0,0,0);
                                                const fechaCuota = new Date(p.fecha_proxima_cuota);
                                                fechaCuota.setHours(0,0,0,0);
                                                const esCuotaVencida = fechaCuota < hoy;
                                            %>
                                                <div class="mt-4 p-3 rounded-4 <%= esCuotaVencida ? 'bg-danger bg-opacity-10 border border-danger-subtle' : 'bg-primary-subtle bg-opacity-25 border border-primary-subtle' %>" style="border: 1px solid;">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="small fw-bold <%= esCuotaVencida ? 'text-danger' : 'text-primary' %>">
                                                            <i class="bi <%= esCuotaVencida ? 'bi-exclamation-triangle-fill text-danger animate-pulse' : 'bi-calendar-check-fill' %> me-1"></i>
                                                            Próxima Cuota #<%= p.numero_proxima_cuota %>
                                                        </span>
                                                        <% if (esCuotaVencida) { %>
                                                            <span class="badge bg-danger rounded-pill px-2 py-1 text-uppercase font-monospace" style="font-size: 0.7rem;">¡Vencida!</span>
                                                        <% } else { %>
                                                            <span class="badge bg-primary rounded-pill px-2 py-1 text-uppercase font-monospace" style="font-size: 0.7rem;">Pendiente</span>
                                                        <% } %>
                                                    </div>
                                                    <div class="row align-items-center">
                                                        <div class="col-7 col-sm-8">
                                                            <p class="mb-0 text-muted small" style="font-size: 0.75rem;">Vence el:</p>
                                                            <h6 class="mb-0 fw-bold <%= esCuotaVencida ? 'text-danger' : 'text-dark' %>" style="font-size: 0.85rem;">
                                                                <%= new Date(p.fecha_proxima_cuota).toLocaleDateString('es-CO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                                            </h6>
                                                        </div>
                                                        <div class="col-5 col-sm-4 text-end">
                                                            <p class="mb-0 text-muted small" style="font-size: 0.75rem;">Monto:</p>
                                                            <h6 class="mb-0 fw-bold <%= esCuotaVencida ? 'text-danger' : 'text-primary' %>" style="font-size: 1.1rem;">
                                                                $<%= parseFloat(p.restante_proxima_cuota).toLocaleString('es-CO', {minimumFractionDigits: 2}) %>
                                                            </h6>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% } else { %>
                                                <div class="mt-4 p-3 bg-success bg-opacity-10 border border-success-subtle rounded-4 text-center">
                                                    <span class="small fw-bold text-success">
                                                        <i class="bi bi-patch-check-fill me-1"></i> ¡Estás al día! No tienes más cuotas programadas.
                                                    </span>
                                                </div>
                                            <% } %>

                                            <!-- Historial de Pagos Colapsable -->
                                            <div class="mt-3">
                                                <div class="d-grid">
                                                    <button class="btn btn-outline-secondary btn-sm rounded-pill fw-bold border-1 py-2 text-muted shadow-xs d-flex align-items-center justify-content-center" type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#historialCollapse<%= p.id %>"
                                                        style="font-size: 0.8rem; border-color: #e2e8f0; transition: all 0.2s;">
                                                        <i class="bi bi-clock-history me-1.5"></i> Ver Historial de Pagos
                                                    </button>
                                                </div>
                                                <div class="collapse mt-2" id="historialCollapse<%= p.id %>">
                                                    <div class="card card-body bg-light border-0 rounded-4 p-3 shadow-sm">
                                                        <ul class="list-group list-group-flush bg-transparent mb-0 small">
                                                            <% if(p.pagos && p.pagos.length > 0) { %>
                                                                <% p.pagos.forEach(h => { %>
                                                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent border-0 px-0 py-1.5">
                                                                        <span class="text-muted">
                                                                            <i class="bi bi-calendar-check text-success me-1.5"></i>
                                                                            <%= new Date(h.fecha_pago).toLocaleDateString('es-CO') %>
                                                                        </span>
                                                                        <span class="fw-bold text-success font-monospace" style="font-size: 0.9rem;">
                                                                            + $<%= parseFloat(h.monto_pagado).toLocaleString('es-CO') %>
                                                                        </span>
                                                                    </li>
                                                                <% }) %>
                                                            <% } else { %>
                                                                <li class="list-group-item bg-transparent border-0 px-0 text-center text-muted py-2">
                                                                    <i class="bi bi-info-circle me-1"></i> Sin pagos registrados aún.
                                                                </li>
                                                            <% } %>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2">
                                                <a href="/prestamos/pdf-cronograma/<%= p.id %>" target="_blank" class="btn btn-outline-dark btn-sm flex-fill text-nowrap">
                                                    <i class="bi bi-file-earmark-pdf text-danger"></i> Cronograma
                                                </a>
                                                <a href="/prestamos/pdf-contrato/<%= p.id %>" target="_blank" class="btn btn-outline-dark btn-sm flex-fill text-nowrap">
                                                    <i class="bi bi-file-text text-primary"></i> Contrato
                                                </a>
                                                <button type="button" class="btn btn-success btn-sm flex-fill fw-bold text-nowrap btn-reportar-pago" data-prestamo-id="<%= p.id %>" data-monto="<%= p.fecha_proxima_cuota ? Math.round(p.restante_proxima_cuota) : '' %>">
                                                    <i class="bi bi-wallet2 me-1"></i> Reportar Pago
                                                </button>
                                                <% if(p.estado !== 'pagado') { %>
                                                <button type="button" class="btn btn-primary btn-sm flex-fill fw-bold text-nowrap btn-pagar-mp" data-prestamo-id="<%= p.id %>" data-monto="<%= p.fecha_proxima_cuota ? Math.round(p.restante_proxima_cuota) : '' %>">
                                                    <i class="bi bi-credit-card me-1"></i> Pagar en Línea
                                                </button>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-12">
                                <div class="alert alert-info border-0 shadow-sm d-flex align-items-center">
                                    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                    <div>No tienes préstamos activos en este momento.</div>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Cuentas de Ahorro -->
                    <% if(cuentaAhorro) { %>
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-piggy-bank text-warning me-2"></i> Mi Cuenta de Ahorro</h5>
                        <div class="row g-3 mb-5">
                            <div class="col-12 col-xl-6">
                                <div class="card border-0 shadow-sm rounded-4 h-100 bg-warning bg-opacity-10">
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div>
                                                <h6 class="fw-bold text-warning mb-1">Saldo Disponible</h6>
                                                <h3 class="fw-bold mb-0">$<%= parseFloat(cuentaAhorro.saldo_actual).toLocaleString('en-US', {minimumFractionDigits: 2}) %></h3>
                                            </div>
                                            <div class="text-end">
                                                <i class="bi bi-wallet2 text-warning opacity-50" style="font-size: 3rem;"></i>
                                            </div>
                                        </div>
                                        <% if(cuentaAhorro.meta_nombre && cuentaAhorro.meta_monto) { %>
                                            <div class="mt-4 pt-3 border-top border-warning border-opacity-25">
                                                <p class="text-muted small mb-1">Meta: <%= cuentaAhorro.meta_nombre %></p>
                                                <div class="d-flex justify-content-between mb-1">
                                                    <span class="small text-muted">Progreso</span>
                                                    <span class="small fw-bold text-warning"><%= ((cuentaAhorro.saldo_actual / cuentaAhorro.meta_monto) * 100).toFixed(0) %>%</span>
                                                </div>
                                                <div class="progress" style="height: 8px;">
                                                    <div class="progress-bar bg-warning" style="width: <%= (cuentaAhorro.saldo_actual / cuentaAhorro.meta_monto) * 100 %>%"></div>
                                                </div>
                                                <p class="text-end text-muted small mt-1">Objetivo: $<%= parseFloat(cuentaAhorro.meta_monto).toLocaleString('en-US', {minimumFractionDigits: 2}) %></p>
                                            </div>
                                        <% } %>
                                        <div class="mt-4 pt-3 border-top border-warning border-opacity-25 d-flex flex-wrap gap-2">
                                            <button type="button" class="btn btn-warning btn-sm flex-fill fw-bold text-nowrap" data-bs-toggle="modal" data-bs-target="#modalReportarAporte">
                                                <i class="bi bi-piggy-bank me-1"></i> Reportar Aporte
                                            </button>
                                            <button type="button" class="btn btn-outline-dark btn-sm flex-fill fw-bold text-nowrap" data-bs-toggle="modal" data-bs-target="#modalSolicitarRetiro">
                                                <i class="bi bi-cash-stack me-1"></i> Solicitar Retiro
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Historial de Movimientos -->
                            <div class="col-12 col-xl-6">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-header bg-white border-bottom-0 p-3 pb-0">
                                        <h6 class="fw-bold text-dark mb-0 d-flex align-items-center">
                                            <i class="bi bi-clock-history text-warning me-2"></i> Historial de Movimientos
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill ms-auto" style="font-size: 0.7rem;"><%= locals.movimientosAhorro ? movimientosAhorro.length : 0 %></span>
                                        </h6>
                                    </div>
                                    <div class="card-body p-0" style="max-height: 320px; overflow-y: auto;">
                                        <% if(locals.movimientosAhorro && movimientosAhorro.length > 0) { %>
                                            <div class="list-group list-group-flush">
                                                <% movimientosAhorro.slice(0, 15).forEach(mov => { %>
                                                    <div class="list-group-item border-0 px-3 py-2.5 d-flex align-items-center gap-3">
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px; background-color: <%= mov.tipo_movimiento === 'deposito' ? '#dcfce7' : '#fee2e2' %>;">
                                                            <i class="bi <%= mov.tipo_movimiento === 'deposito' ? 'bi-arrow-down-circle text-success' : 'bi-arrow-up-circle text-danger' %>" style="font-size: 1.1rem;"></i>
                                                        </div>
                                                        <div class="flex-grow-1 min-w-0">
                                                            <div class="fw-bold small text-dark text-truncate">
                                                                <%= mov.tipo_movimiento === 'deposito' ? 'Depósito' : 'Retiro' %>
                                                            </div>
                                                            <small class="text-muted" style="font-size: 0.7rem;">
                                                                <%= new Date(mov.fecha_movimiento).toLocaleDateString() %> · <%= new Date(mov.fecha_movimiento).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                                            </small>
                                                        </div>
                                                        <div class="text-end flex-shrink-0">
                                                            <span class="fw-bold font-monospace small <%= mov.tipo_movimiento === 'deposito' ? 'text-success' : 'text-danger' %>">
                                                                <%= mov.tipo_movimiento === 'deposito' ? '+' : '-' %>$<%= parseFloat(mov.monto).toLocaleString('es-CO') %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <div class="text-center py-5 px-3">
                                                <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                                                <p class="text-muted small mt-2 mb-0">Aún no tienes movimientos registrados.</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Empeños -->
                    <% if(empenos && empenos.length > 0) { %>
                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-gem text-info me-2"></i> Mis Empeños</h5>
                        <div class="row g-3 mb-5">
                            <% empenos.forEach(e => { %>
                                <div class="col-12 col-xl-6">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <div class="card-body p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                                                <div>
                                                    <span class="badge bg-info-subtle text-info border rounded-pill px-3 py-1 fw-bold">
                                                        Empeño #<%= e.id %>
                                                    </span>
                                                    <h6 class="fw-bold mt-2 mb-0"><%= e.articulo %></h6>
                                                </div>
                                                <div class="text-end">
                                                    <% if(e.estado === 'activo') { %>
                                                        <span class="badge bg-success">Activo</span>
                                                    <% } else if(e.estado === 'vencido') { %>
                                                        <span class="badge bg-danger">Vencido</span>
                                                    <% } else if(e.estado === 'retirado') { %>
                                                        <span class="badge bg-secondary">Retirado</span>
                                                    <% } else if(e.estado === 'rematado') { %>
                                                        <span class="badge bg-dark">Rematado</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                            
                                            <div class="row mt-3">
                                                <div class="col-6">
                                                    <p class="text-muted small mb-1">Préstamo Base</p>
                                                    <h5 class="fw-bold text-dark">$<%= parseFloat(e.monto_prestamo).toLocaleString('en-US', {minimumFractionDigits: 2}) %></h5>
                                                </div>
                                                <div class="col-6 text-end">
                                                    <p class="text-muted small mb-1">Fecha Límite</p>
                                                    <h6 class="fw-bold text-danger"><%= new Date(e.fecha_vencimiento).toLocaleDateString() %></h6>
                                                </div>
                                            </div>
                                            <% if(e.descripcion) { %>
                                                <p class="text-muted small mt-2 mb-0 text-truncate"><i class="bi bi-info-circle me-1"></i><%= e.descripcion %></p>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>

                    <!-- Mis Reportes de Pago -->
                    <h5 id="seccion-reportes" class="fw-bold text-dark mb-3"><i class="bi bi-receipt text-success me-2"></i> Mis Reportes de Pago</h5>
                    <!-- Vista Desktop: Tabla -->
                    <div class="d-none d-md-block card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-4">Reporte ID</th>
                                            <th>Préstamo</th>
                                            <th>Monto Reportado</th>
                                            <th>Fecha Envío</th>
                                            <th>Estado</th>
                                            <th class="text-end pe-4">Detalle</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if(locals.reportesPago && reportesPago.length > 0) { %>
                                            <% reportesPago.forEach(rp => { %>
