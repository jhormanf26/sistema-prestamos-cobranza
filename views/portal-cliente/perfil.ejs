<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <%- include('partials/sidebar') %>

            <div class="col py-0 py-md-3 main-content-wrapper" style="background-color: #f8fafc; min-height: 100vh;">
                <!-- Mobile Header Simple -->
                <div class="d-md-none bg-white p-3 shadow-sm d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-badge text-success fs-3 me-2"></i>
                        <h5 class="mb-0 fw-bold">Mi Perfil</h5>
                    </div>
                    <button class="btn btn-outline-secondary" id="openSidebarBtn">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                </div>

                <div class="container-fluid px-4 py-3">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold text-dark my-0 fs-4">Mi Perfil</h2>
                            <p class="text-muted small mb-0">Gestiona tu información de cuenta y seguridad.</p>
                        </div>
                    </div>

                    <% if(mensajeExito && mensajeExito.length > 0) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> <%= mensajeExito %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <% if(mensajeError && mensajeError.length > 0) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= mensajeError %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <div class="row g-4">
                        <!-- Información Personal (Solo Lectura para el cliente, deben contactar a admin para cambiar nombre/dni) -->
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-header bg-white border-0 pt-4 pb-0">
                                    <h5 class="fw-bold"><i class="bi bi-person-lines-fill text-primary me-2"></i> Datos Personales</h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-bold">Nombre Completo</label>
                                        <input type="text" class="form-control bg-light" value="<%= cliente.nombre %> <%= cliente.apellido %>" readonly>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-bold">DNI</label>
                                        <input type="text" class="form-control bg-light" value="<%= cliente.dni %>" readonly>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-bold">Teléfono</label>
                                        <input type="text" class="form-control bg-light" value="<%= cliente.telefono || 'No registrado' %>" readonly>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-muted small fw-bold">Dirección</label>
                                        <input type="text" class="form-control bg-light" value="<%= cliente.direccion || 'No registrada' %>" readonly>
                                    </div>
                                    
                                    <div class="alert alert-info mt-4 mb-0 py-2" style="font-size: 0.85rem;">
                                        <i class="bi bi-info-circle me-1"></i> Para actualizar tus datos personales, por favor contacta a administración.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cambio de Contraseña -->
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-header bg-white border-0 pt-4 pb-0">
                                    <h5 class="fw-bold"><i class="bi bi-shield-lock-fill text-warning me-2"></i> Seguridad</h5>
                                </div>
                                <div class="card-body">
                                    <form action="/portal-cliente/perfil/password" method="POST">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Contraseña Actual</label>
                                            <input type="password" name="passwordActual" class="form-control" placeholder="••••••••" required>
                                            <div class="form-text">Si es tu primera vez, ingresa tu DNI.</div>
                                        </div>
                                        
                                        <hr class="my-4">
                                        
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Nueva Contraseña</label>
                                            <input type="password" name="nuevoPassword" class="form-control" placeholder="••••••••" required minlength="6">
                                        </div>
                                        
                                        <div class="d-grid mt-4">
                                            <button type="submit" class="btn btn-primary rounded-pill fw-bold shadow-sm">
                                                <i class="bi bi-save me-2"></i> Actualizar Contraseña
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts Esenciales -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Manejo del sidebar en móviles
            const sidebar = document.getElementById("sidebarMenu");
            const openBtn = document.getElementById("openSidebarBtn");
            const closeBtn = document.getElementById("closeSidebarBtn");

            if(openBtn && closeBtn && sidebar) {
                openBtn.addEventListener("click", () => sidebar.classList.add("show"));
                closeBtn.addEventListener("click", () => sidebar.classList.remove("show"));
            }
        });
    </script>
</body>
</html>
